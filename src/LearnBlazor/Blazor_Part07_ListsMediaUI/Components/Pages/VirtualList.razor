@page "/virtual"
@inject ItemService Items
@* Part07 - Virtualize + ItemsProvider + @key *@

<PageTitle>Part07 · Virtual List</PageTitle>
<h1>Virtualize (10k items)</h1>

<div style="height:50vh;overflow:auto;border:1px solid var(--color-surface-container)">
    <Virtualize ItemsProvider="@LoadItems" Context="item" OverscanCount="10">
        <ItemContent Context="it">
            <div @key="it.Id" style="padding:.5rem;border-bottom:1px solid var(--color-surface-container)">
                <Icon Name="@it.IconName" /> <strong>@it.Title</strong> — @it.Sub
            </div>
        </ItemContent>
        <Placeholder>
            <p style="padding:.5rem;color:var(--color-surface-container)">Loading…</p>
        </Placeholder>
    </Virtualize>
</div>

@code {
    private async ValueTask<ItemsProviderResult<Item>> LoadItems(ItemsProviderRequest req)
    {
        var slice = await Items.GetItemsAsync(req.StartIndex, req.Count, req.CancellationToken);
        return new ItemsProviderResult<Item>(slice, 10_000);
    }
}
