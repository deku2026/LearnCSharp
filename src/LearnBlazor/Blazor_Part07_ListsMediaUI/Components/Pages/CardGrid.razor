@page "/cards"
@inject ItemService Items
@* Part07 - grid auto-fill + minmax + @key *@

<PageTitle>Part07 · Card Grid</PageTitle>
<h1>Card Grid (auto-fill + minmax)</h1>

<div class="card-grid">
    @foreach (var item in Items.GetAll().Take(60))
    {
        <article class="card" @key="item.Id">
            <Icon Name="@item.IconName" />
            <h3>@item.Title</h3>
            <p class="sub">@item.Sub</p>
        </article>
    }
</div>

<style>
    .card-grid {
        display: grid;
        grid-template-columns: repeat(auto-fill, minmax(9.5rem, 1fr));
        gap: 1rem;
    }
    .card {
        background: var(--color-surface-container, #f0f0f3);
        border-radius: .75rem;
        padding: 1rem;
    }
    .sub { color: #666; font-size: .8rem; }
</style>