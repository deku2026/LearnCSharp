@page "/media"
@* Part07 - 懒加载占位 + blur-up *@

<PageTitle>Part07 · Media Placeholder</PageTitle>
<h1>Lazy Media Placeholder</h1>

<p><code>loading="lazy"</code> + CSS blur-up：先占位，加载完平滑过渡。</p>

<div style="display:grid;grid-template-columns:repeat(3,1fr);gap:1rem">
    @for (var i = 0; i < 9; i++)
    {
        var seed = i;
        <div class="ph" style="aspect-ratio:1">
            <img src="@($"https://picsum.photos/seed/{seed}/200")"
                 alt="占位图 @seed"
                 loading="lazy"
                 @onload="@(_ => loaded[seed] = true)" />
        </div>
    }
</div>

<style>
    .ph {
        background: var(--color-surface-container, #f0f0f3);
        border-radius: .75rem;
        overflow: hidden;
    }
    .ph img {
        width: 100%;
        height: 100%;
        object-fit: cover;
        opacity: 0;
        transition: opacity .3s ease;
    }
</style>

@code {
    private readonly Dictionary<int, bool> loaded = new();
}
