<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:pages="clr-namespace:LearnAvalonia.Avalonia_Stage07_ControlSystem.Pages"
             x:DataType="pages:ListTreeCarouselDemo"
             x:Class="LearnAvalonia.Avalonia_Stage07_ControlSystem.Pages.ListTreeCarouselDemo">
  <ScrollViewer Padding="8">
    <StackPanel Spacing="6" Margin="8">
      <TextBlock Text="§C2-C5 ItemsControl·ListBox·TreeView·Carousel" FontWeight="Bold" FontSize="14"/>
      <TextBlock Text="ItemsControl 纯呈现无选择；ListBox 单/多选 + SelectedItem；TreeView TreeDataTemplate+Children；Carousel 横滑（不等于 CarouselPage）" TextWrapping="Wrap"/>
      <TextBlock Text="现场：ListBox + ItemTemplate + 选中项" FontWeight="SemiBold"/>
      <Border BorderBrush="Gray" BorderThickness="1" Padding="8" CornerRadius="4">
        <ListBox ItemsSource="{Binding Items}" MaxHeight="120">
          <ListBox.ItemTemplate>
            <DataTemplate x:DataType="x:String">
              <TextBlock Text="{Binding}" Padding="4"/>
            </DataTemplate>
          </ListBox.ItemTemplate>
        </ListBox>
      </Border>
      <TextBlock Text="现场：TreeView 层级" FontWeight="SemiBold"/>
      <Border BorderBrush="Gray" BorderThickness="1" Padding="8" CornerRadius="4">
        <TreeView>
          <TreeViewItem Header="根">
            <TreeViewItem Header="子 1"/>
            <TreeViewItem Header="子 2">
              <TreeViewItem Header="孙"/>
            </TreeViewItem>
          </TreeViewItem>
        </TreeView>
      </Border>
      <TextBlock Text="验收：使用 ListBox 选中项与 ItemTemplate" Foreground="DarkGreen"/>
    </StackPanel>
  </ScrollViewer>
</UserControl>
