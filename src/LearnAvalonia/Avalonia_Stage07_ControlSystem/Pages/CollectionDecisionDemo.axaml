<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="LearnAvalonia.Avalonia_Stage07_ControlSystem.Pages.CollectionDecisionDemo">
  <ScrollViewer Padding="8">
    <StackPanel Spacing="6" Margin="8">
      <TextBlock Text="§C1 集合决策总表（背这张，不背 API）" FontWeight="Bold" FontSize="14"/>
      <Border BorderBrush="Gray" BorderThickness="1" Padding="8" CornerRadius="4">
        <Grid ColumnDefinitions="*,*,*" RowDefinitions="Auto,Auto,Auto,Auto,Auto,Auto,Auto,Auto" RowSpacing="2" ColumnSpacing="4">
          <TextBlock Grid.Row="0" Grid.Column="0" Text="需求" FontWeight="SemiBold" Padding="4"/>
          <TextBlock Grid.Row="0" Grid.Column="1" Text="首选" FontWeight="SemiBold" Padding="4"/>
          <TextBlock Grid.Row="0" Grid.Column="2" Text="包/状态" FontWeight="SemiBold" Padding="4"/>
          <TextBlock Grid.Row="1" Grid.Column="0" Text="自定义项 UI 列表" TextWrapping="Wrap" Padding="4"/>
          <TextBlock Grid.Row="1" Grid.Column="1" Text="ItemsControl / ListBox" TextWrapping="Wrap" Padding="4"/>
          <TextBlock Grid.Row="1" Grid.Column="2" Text="核心 · 稳定" TextWrapping="Wrap" Padding="4"/>
          <TextBlock Grid.Row="2" Grid.Column="0" Text="树形层级" TextWrapping="Wrap" Padding="4"/>
          <TextBlock Grid.Row="2" Grid.Column="1" Text="TreeView" TextWrapping="Wrap" Padding="4"/>
          <TextBlock Grid.Row="2" Grid.Column="2" Text="核心" TextWrapping="Wrap" Padding="4"/>
          <TextBlock Grid.Row="3" Grid.Column="0" Text="只读二维表（轻量）" TextWrapping="Wrap" Padding="4"/>
          <TextBlock Grid.Row="3" Grid.Column="1" Text="TableView" TextWrapping="Wrap" Padding="4"/>
          <TextBlock Grid.Row="3" Grid.Column="2" Text="核心 · 12.1+ · 行虚拟化" TextWrapping="Wrap" Padding="4"/>
          <TextBlock Grid.Row="4" Grid.Column="0" Text="完全自定义虚拟化布局" TextWrapping="Wrap" Padding="4"/>
          <TextBlock Grid.Row="4" Grid.Column="1" Text="ItemsRepeater" TextWrapping="Wrap" Padding="4"/>
          <TextBlock Grid.Row="4" Grid.Column="2" Text="独立包 · 无 chrome" TextWrapping="Wrap" Padding="4"/>
          <TextBlock Grid.Row="5" Grid.Column="0" Text="单元格编辑表格" TextWrapping="Wrap" Padding="4"/>
          <TextBlock Grid.Row="5" Grid.Column="1" Text="DataGrid" TextWrapping="Wrap" Padding="4"/>
          <TextBlock Grid.Row="5" Grid.Column="2" Text="独立包 · deprecated" TextWrapping="Wrap" Padding="4"/>
          <TextBlock Grid.Row="6" Grid.Column="0" Text="高性能树+列/高级表" TextWrapping="Wrap" Padding="4"/>
          <TextBlock Grid.Row="6" Grid.Column="1" Text="TreeDataGrid" TextWrapping="Wrap" Padding="4"/>
          <TextBlock Grid.Row="6" Grid.Column="2" Text="Avalonia Pro" TextWrapping="Wrap" Padding="4"/>
          <TextBlock Grid.Row="7" Grid.Column="0" Text="横滑一组页卡片" TextWrapping="Wrap" Padding="4"/>
          <TextBlock Grid.Row="7" Grid.Column="1" Text="Carousel" TextWrapping="Wrap" Padding="4"/>
          <TextBlock Grid.Row="7" Grid.Column="2" Text="核心" TextWrapping="Wrap" Padding="4"/>
        </Grid>
      </Border>
      <TextBlock Text="验收：背决策表不背 API" Foreground="DarkGreen"/>
    </StackPanel>
  </ScrollViewer>
</UserControl>
