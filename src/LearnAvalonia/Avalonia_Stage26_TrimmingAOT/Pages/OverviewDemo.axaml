<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="LearnAvalonia.Avalonia_Stage26_TrimmingAOT.Pages.OverviewDemo">
  <ScrollViewer Padding="8">
    <StackPanel Spacing="6" Margin="8">
      <TextBlock Text="§0 导读：Trimming 与 AOT" FontWeight="Bold" FontSize="14"/>
      <Grid ColumnDefinitions="Auto,*,*" RowDefinitions="Auto,Auto,Auto,Auto" RowSpacing="3" ColumnSpacing="8">
        <TextBlock Grid.Row="0" Grid.Column="0" Text="维度" FontWeight="SemiBold" Padding="4"/>
        <TextBlock Grid.Row="0" Grid.Column="1" Text="Trimming" FontWeight="SemiBold" Padding="4"/>
        <TextBlock Grid.Row="0" Grid.Column="2" Text="Native AOT" FontWeight="SemiBold" Padding="4"/>
        <TextBlock Grid.Row="1" Grid.Column="0" Text="体积" Padding="4"/>
        <TextBlock Grid.Row="1" Grid.Column="1" Text="减 50-70%" TextWrapping="Wrap" Padding="4"/>
        <TextBlock Grid.Row="1" Grid.Column="2" Text="减 70-90%" TextWrapping="Wrap" Padding="4"/>
        <TextBlock Grid.Row="2" Grid.Column="0" Text="启动" Padding="4"/>
        <TextBlock Grid.Row="2" Grid.Column="1" Text="JIT 仍需" TextWrapping="Wrap" Padding="4"/>
        <TextBlock Grid.Row="2" Grid.Column="2" Text="无 JIT，&lt; 100ms" TextWrapping="Wrap" Padding="4"/>
        <TextBlock Grid.Row="3" Grid.Column="0" Text="代价" Padding="4"/>
        <TextBlock Grid.Row="3" Grid.Column="1" Text="反射受限" TextWrapping="Wrap" Padding="4"/>
        <TextBlock Grid.Row="3" Grid.Column="2" Text="无动态加载/反射重" TextWrapping="Wrap" Padding="4"/>
      </Grid>
      <TextBlock Text="AOT 等级：TrimMode=full / partial；IsAotCompatible=true；PublishAot=true。" TextWrapping="Wrap"/>
      <TextBlock Text="验收：口述 trim/AOT 收益与代价" Foreground="DarkGreen"/>
    </StackPanel>
  </ScrollViewer>
</UserControl>