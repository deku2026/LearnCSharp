<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="LearnAvalonia.Avalonia_Stage26_TrimmingAOT.Pages.WarningWorkflowDemo">
  <ScrollViewer Padding="8">
    <StackPanel Spacing="6" Margin="8">
      <TextBlock Text="§7 警告处理流程" FontWeight="Bold" FontSize="14"/>
      <TextBlock Text="常见 trim 警告" FontWeight="SemiBold"/>
      <Grid ColumnDefinitions="Auto,*,*" RowDefinitions="Auto,Auto,Auto,Auto" RowSpacing="3" ColumnSpacing="8">
        <TextBlock Grid.Row="0" Grid.Column="0" Text="警告" FontWeight="SemiBold" Padding="4"/>
        <TextBlock Grid.Row="0" Grid.Column="1" Text="含义" FontWeight="SemiBold" Padding="4"/>
        <TextBlock Grid.Row="0" Grid.Column="2" Text="修复" FontWeight="SemiBold" Padding="4"/>
        <TextBlock Grid.Row="1" Grid.Column="0" Text="IL2057" Padding="4"/>
        <TextBlock Grid.Row="1" Grid.Column="1" Text="Type.GetType 反射" TextWrapping="Wrap" Padding="4"/>
        <TextBlock Grid.Row="1" Grid.Column="2" Text="改用 typeof/SourceGen" TextWrapping="Wrap" Padding="4"/>
        <TextBlock Grid.Row="2" Grid.Column="0" Text="IL2067" Padding="4"/>
        <TextBlock Grid.Row="2" Grid.Column="1" Text="MakeGenericType" TextWrapping="Wrap" Padding="4"/>
        <TextBlock Grid.Row="2" Grid.Column="2" Text="DynamicallyAccessedMembers" TextWrapping="Wrap" Padding="4"/>
        <TextBlock Grid.Row="3" Grid.Column="0" Text="IL2070" Padding="4"/>
        <TextBlock Grid.Row="3" Grid.Column="1" Text="Activator.CreateInstance" TextWrapping="Wrap" Padding="4"/>
        <TextBlock Grid.Row="3" Grid.Column="2" Text="工厂模式 + RDG" TextWrapping="Wrap" Padding="4"/>
      </Grid>
      <TextBlock Text="流程：publish 时跑 Trimmer → 列警告 → 逐条修 → 无警告再开 AOT。" TextWrapping="Wrap"/>
      <TextBlock Text="RD.xml：TrimmerRootDescriptor 显式保留类型/方法。" TextWrapping="Wrap"/>
      <TextBlock Text="验收：Trim warnings 修复路径" Foreground="DarkGreen"/>
    </StackPanel>
  </ScrollViewer>
</UserControl>