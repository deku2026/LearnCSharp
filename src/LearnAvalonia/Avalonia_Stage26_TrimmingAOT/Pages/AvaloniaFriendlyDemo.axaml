<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="LearnAvalonia.Avalonia_Stage26_TrimmingAOT.Pages.AvaloniaFriendlyDemo">
  <ScrollViewer Padding="8">
    <StackPanel Spacing="6" Margin="8">
      <TextBlock Text="§2 Avalonia 特有友好点" FontWeight="Bold" FontSize="14"/>
      <Border BorderBrush="Gray" BorderThickness="1" Padding="8" CornerRadius="4">
        <StackPanel Spacing="3">
          <TextBlock Text="• CompiledBinding 默认编译期生成访问器，无反射" TextWrapping="Wrap"/>
          <TextBlock Text="• Avalonia.Markup.Xaml 编译期编译 .axaml 到 BAML-like" TextWrapping="Wrap"/>
          <TextBlock Text="• 12 起 IsAotCompatible=true；12.1 强化" TextWrapping="Wrap"/>
          <TextBlock Text="• ControlTheme/Style 编译期；运行时样式受限但可用" TextWrapping="Wrap"/>
          <TextBlock Text="• Skia/HarfBuzz 原生依赖 AOT 友好" TextWrapping="Wrap"/>
        </StackPanel>
      </Border>
      <TextBlock Text="反射重灾区：DataGrid/TreeView 部分反射；非 CompiledBinding 路径。" TextWrapping="Wrap"/>
      <TextBlock Text="验收：CompiledBinding 友好 AOT" Foreground="DarkGreen"/>
    </StackPanel>
  </ScrollViewer>
</UserControl>