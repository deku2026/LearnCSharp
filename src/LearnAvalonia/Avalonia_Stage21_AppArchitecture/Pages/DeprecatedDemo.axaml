<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="LearnAvalonia.Avalonia_Stage21_AppArchitecture.Pages.DeprecatedDemo">
  <ScrollViewer Padding="8">
    <StackPanel Spacing="6" Margin="8">
      <TextBlock Text="§16 过时内容红线" FontWeight="Bold" FontSize="14"/>
      <Border BorderBrush="Gray" BorderThickness="1" Padding="8" CornerRadius="4">
        <Grid ColumnDefinitions="*,*" RowDefinitions="Auto,Auto,Auto,Auto,Auto" RowSpacing="4" ColumnSpacing="8">
          <TextBlock Grid.Row="0" Grid.Column="0" Text="过时" FontWeight="SemiBold" Padding="4"/>
          <TextBlock Grid.Row="0" Grid.Column="1" Text="替代" FontWeight="SemiBold" Padding="4"/>
          <TextBlock Grid.Row="1" Grid.Column="0" Text="一切丢 code-behind" TextWrapping="Wrap" Padding="4"/>
          <TextBlock Grid.Row="1" Grid.Column="1" Text="VM + 服务" TextWrapping="Wrap" Padding="4"/>
          <TextBlock Grid.Row="2" Grid.Column="0" Text="旧 Avalonia.ReactiveUI 11 线新建" TextWrapping="Wrap" Padding="4"/>
          <TextBlock Grid.Row="2" Grid.Column="1" Text="ReactiveUI.Avalonia" TextWrapping="Wrap" Padding="4"/>
          <TextBlock Grid.Row="3" Grid.Column="0" Text="无版本 settings 直接反序列化炸" TextWrapping="Wrap" Padding="4"/>
          <TextBlock Grid.Row="3" Grid.Column="1" Text="迁移管道" TextWrapping="Wrap" Padding="4"/>
          <TextBlock Grid.Row="4" Grid.Column="0" Text="插件与主程序强耦合 UI 内部类型" TextWrapping="Wrap" Padding="4"/>
          <TextBlock Grid.Row="4" Grid.Column="1" Text="契约程序集" TextWrapping="Wrap" Padding="4"/>
        </Grid>
      </Border>
      <TextBlock Text="多实例抢同一用户数据无协调 → 单实例或文件锁" TextWrapping="Wrap"/>
      <TextBlock Text="验收：点名过时与替代" Foreground="DarkGreen"/>
    </StackPanel>
  </ScrollViewer>
</UserControl>
