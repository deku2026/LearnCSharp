<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="LearnAvalonia.Avalonia_Stage21_AppArchitecture.Pages.ConfigLoggingDemo">
  <ScrollViewer Padding="8">
    <StackPanel Spacing="6" Margin="8">
      <TextBlock Text="§6 配置与日志" FontWeight="Bold" FontSize="14"/>
      <TextBlock Text="配置源分层" FontWeight="SemiBold"/>
      <Border Background="#1E1E1E" Padding="8" CornerRadius="4">
        <TextBlock Text="appsettings.json&#x0a;appsettings.{Environment}.json&#x0a;用户 settings.json（可写目录）&#x0a;环境变量 · 命令行" Foreground="#D4D4D4" FontFamily="Consolas,Monaco,monospace" TextWrapping="Wrap"/>
      </Border>
      <TextBlock Text="使用 IOptions&lt;T&gt; / IOptionsMonitor&lt;T&gt;" TextWrapping="Wrap"/>
      <TextBlock Text="用户设置 vs 应用配置" FontWeight="SemiBold"/>
      <Border BorderBrush="Gray" BorderThickness="1" Padding="8" CornerRadius="4">
        <Grid ColumnDefinitions="Auto,*" RowDefinitions="Auto,Auto" RowSpacing="3" ColumnSpacing="8">
          <TextBlock Grid.Row="0" Grid.Column="0" Text="应用配置" FontWeight="SemiBold" Padding="4"/>
          <TextBlock Grid.Row="0" Grid.Column="1" Text="端点、特性开关默认" TextWrapping="Wrap" Padding="4"/>
          <TextBlock Grid.Row="1" Grid.Column="0" Text="用户设置" FontWeight="SemiBold" Padding="4"/>
          <TextBlock Grid.Row="1" Grid.Column="1" Text="主题、窗体位置、最近文件" TextWrapping="Wrap" Padding="4"/>
        </Grid>
      </Border>
      <TextBlock Text="日志" FontWeight="SemiBold"/>
      <Border Background="#1E1E1E" Padding="8" CornerRadius="4">
        <TextBlock Text="builder.Logging.AddConsole();&#x0a;// 文件/Seq/OTLP 按需" Foreground="#D4D4D4" FontFamily="Consolas,Monaco,monospace" TextWrapping="Wrap"/>
      </Border>
      <TextBlock Text="规范：结构化属性 · 不记密钥 · UI 线程异常全局捕获记日志" TextWrapping="Wrap"/>
      <TextBlock Text="验收：IOptions + 结构化日志" Foreground="DarkGreen"/>
    </StackPanel>
  </ScrollViewer>
</UserControl>