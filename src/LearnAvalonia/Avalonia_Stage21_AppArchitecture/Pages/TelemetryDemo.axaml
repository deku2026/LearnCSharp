<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="LearnAvalonia.Avalonia_Stage21_AppArchitecture.Pages.TelemetryDemo">
  <ScrollViewer Padding="8">
    <StackPanel Spacing="6" Margin="8">
      <TextBlock Text="§11 遥测边界" FontWeight="Bold" FontSize="14"/>
      <TextBlock Text="目的：崩溃率 · 功能使用 · 性能（启动时长）" TextWrapping="Wrap"/>
      <TextBlock Text="边界" FontWeight="SemiBold"/>
      <Border Background="#1E1E1E" Padding="8" CornerRadius="4">
        <TextBlock Text="默认关闭或安装时征求同意&#x0a;可剥离 PII&#x0a;本地企业版可完全关闭" Foreground="#D4D4D4" FontFamily="Consolas,Monaco,monospace" TextWrapping="Wrap"/>
      </Border>
      <TextBlock Text="ITelemetry 接口" FontWeight="SemiBold"/>
      <Border Background="#1E1E1E" Padding="8" CornerRadius="4">
        <TextBlock Text="public interface ITelemetry&#x0a;{&#x0a;    void TrackEvent(string name, IReadOnlyDictionary&lt;string,string&gt;? props = null);&#x0a;    void TrackException(Exception ex);&#x0a;}&#x0a;// 开发 DebugTelemetry；生产可接 OpenTelemetry" Foreground="#D4D4D4" FontFamily="Consolas,Monaco,monospace" TextWrapping="Wrap"/>
      </Border>
      <TextBlock Text="验收：接口存在且默认安全" Foreground="DarkGreen"/>
    </StackPanel>
  </ScrollViewer>
</UserControl>
