<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="LearnAvalonia.Avalonia_Stage21_AppArchitecture.Pages.Avalonia12Demo">
  <ScrollViewer Padding="8">
    <StackPanel Spacing="6" Margin="8">
      <TextBlock Text="§15 Avalonia 12 相关" FontWeight="Bold" FontSize="14"/>
      <Border BorderBrush="Gray" BorderThickness="1" Padding="8" CornerRadius="4">
        <Grid ColumnDefinitions="Auto,*" RowDefinitions="Auto,Auto,Auto,Auto" RowSpacing="4" ColumnSpacing="8">
          <TextBlock Grid.Row="0" Grid.Column="0" Text="默认 MVVM 模板 Toolkit" FontWeight="SemiBold" Padding="4"/>
          <TextBlock Grid.Row="0" Grid.Column="1" Text="组合根示例" TextWrapping="Wrap" Padding="4"/>
          <TextBlock Grid.Row="1" Grid.Column="0" Text="Pages" FontWeight="SemiBold" Padding="4"/>
          <TextBlock Grid.Row="1" Grid.Column="1" Text="导航服务移动实现" TextWrapping="Wrap" Padding="4"/>
          <TextBlock Grid.Row="2" Grid.Column="0" Text="trim 不友好 ViewLocator" FontWeight="SemiBold" Padding="4"/>
          <TextBlock Grid.Row="2" Grid.Column="1" Text="模板 --remove-view-locator 叙事" TextWrapping="Wrap" Padding="4"/>
          <TextBlock Grid.Row="3" Grid.Column="0" Text="WebView 独立包" FontWeight="SemiBold" Padding="4"/>
          <TextBlock Grid.Row="3" Grid.Column="1" Text="模块可选加载" TextWrapping="Wrap" Padding="4"/>
        </Grid>
      </Border>
      <TextBlock Text="验收：模板/导航/trim/WebView 架构影响" Foreground="DarkGreen"/>
    </StackPanel>
  </ScrollViewer>
</UserControl>
