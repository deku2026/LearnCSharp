<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="LearnAvalonia.Avalonia_Stage21_AppArchitecture.Pages.MultiWindowStateDemo">
  <ScrollViewer Padding="8">
    <StackPanel Spacing="6" Margin="8">
      <TextBlock Text="§10 多窗口状态" FontWeight="Bold" FontSize="14"/>
      <TextBlock Text="要持久化什么" FontWeight="SemiBold"/>
      <Border BorderBrush="Gray" BorderThickness="1" Padding="8" CornerRadius="4">
        <Grid ColumnDefinitions="Auto,*" RowDefinitions="Auto,Auto,Auto,Auto" RowSpacing="3" ColumnSpacing="8">
          <TextBlock Grid.Row="0" Grid.Column="0" Text="窗口 bounds" FontWeight="SemiBold" Padding="4"/>
          <TextBlock Grid.Row="0" Grid.Column="1" Text="位置大小；多屏注意 Screen id" TextWrapping="Wrap" Padding="4"/>
          <TextBlock Grid.Row="1" Grid.Column="0" Text="打开文档列表" FontWeight="SemiBold" Padding="4"/>
          <TextBlock Grid.Row="1" Grid.Column="1" Text="路径/id" TextWrapping="Wrap" Padding="4"/>
          <TextBlock Grid.Row="2" Grid.Column="0" Text="布局" FontWeight="SemiBold" Padding="4"/>
          <TextBlock Grid.Row="2" Grid.Column="1" Text="侧栏宽、面板可见" TextWrapping="Wrap" Padding="4"/>
          <TextBlock Grid.Row="3" Grid.Column="0" Text="缩放" FontWeight="SemiBold" Padding="4"/>
          <TextBlock Grid.Row="3" Grid.Column="1" Text="编辑器 zoom" TextWrapping="Wrap" Padding="4"/>
        </Grid>
      </Border>
      <TextBlock Text="会话文件示例" FontWeight="SemiBold"/>
      <Border Background="#1E1E1E" Padding="8" CornerRadius="4">
        <TextBlock Text="{}{&#x0a;  &quot;version&quot;: 2,&#x0a;  &quot;windows&quot;: [&#x0a;    { &quot;x&quot;: 10, &quot;y&quot;: 20, &quot;w&quot;: 1200, &quot;h&quot;: 800, &quot;docs&quot;: [&quot;a.md&quot;] }&#x0a;  ]&#x0a;}" Foreground="#D4D4D4" FontFamily="Consolas,Monaco,monospace" TextWrapping="Wrap"/>
      </Border>
      <TextBlock Text="启动：ISessionRestorer；失败则默认布局" TextWrapping="Wrap"/>
      <TextBlock Text="单窗口应用：移动/Browser 简化为导航栈 + 草稿" TextWrapping="Wrap" Foreground="Gray"/>
      <TextBlock Text="验收：持久化窗口 bounds 与文档列表" Foreground="DarkGreen"/>
    </StackPanel>
  </ScrollViewer>
</UserControl>