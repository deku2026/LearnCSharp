<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="LearnAvalonia.Avalonia_Stage21_AppArchitecture.Pages.MinExperimentsDemo">
  <ScrollViewer Padding="8">
    <StackPanel Spacing="6" Margin="8">
      <TextBlock Text="§18 最小实验 A-H" FontWeight="Bold" FontSize="14"/>
      <Border BorderBrush="Gray" BorderThickness="1" Padding="8" CornerRadius="4">
        <StackPanel Spacing="4">
          <TextBlock Text="实验 A · 分层解决方案（主）：Domain/Application/Infra/UI/Host 五部分；依赖方向用测试或 NetArchTest 断言" TextWrapping="Wrap"/>
          <TextBlock Text="实验 B · DI 导航对话框（主）：VM 弹确认框删除项；无 Window 类型引用" TextWrapping="Wrap"/>
          <TextBlock Text="实验 C · Undo 栈（主）：文本或图形位置变更可撤销重做" TextWrapping="Wrap"/>
          <TextBlock Text="实验 D · Autosave 杀进程（主）：改文档 → 等 autosave → 杀进程 → 恢复" TextWrapping="Wrap"/>
          <TextBlock Text="实验 E · 设置迁移（主）：v1 settings 升 v2 字段改名" TextWrapping="Wrap"/>
          <TextBlock Text="实验 F · 单实例（桌面主）：第二次启动带文件路径，第一实例打开该文件" TextWrapping="Wrap"/>
          <TextBlock Text="实验 G · 模块贡献菜单（主）：两个模块各贡献一个菜单项" TextWrapping="Wrap"/>
          <TextBlock Text="实验 H · 插件加载（加分）：从目录加载 IPlugin DLL；失败插件隔离日志" TextWrapping="Wrap"/>
        </StackPanel>
      </Border>
      <TextBlock Text="验收：完成 8 个最小实验" Foreground="DarkGreen"/>
    </StackPanel>
  </ScrollViewer>
</UserControl>