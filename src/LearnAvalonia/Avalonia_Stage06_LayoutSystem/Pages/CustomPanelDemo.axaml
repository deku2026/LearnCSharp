<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:pages="clr-namespace:LearnAvalonia.Avalonia_Stage06_LayoutSystem.Pages"
             x:Class="LearnAvalonia.Avalonia_Stage06_LayoutSystem.Pages.CustomPanelDemo">
  <ScrollViewer Padding="8">
    <StackPanel Spacing="6" Margin="8">
      <TextBlock Text="§F 自定义 Panel：SimpleStackPanel 教学实现" FontWeight="Bold" FontSize="14"/>
      <TextBlock Text="设计步骤：明确布局合同 → 定义 AttachedProperty 或固有属性 → 实现 MeasureOverride（处理 infinity、Margin、可见性）→ 实现 ArrangeOverride（分配 Rect）→ 属性变更 InvalidateMeasure → 单测 → 性能" TextWrapping="Wrap"/>
      <TextBlock Text="现场：自写 SimpleStackPanel Spacing=8（Measure+Arrange 闭环）" FontWeight="SemiBold"/>
      <Border BorderBrush="Gray" BorderThickness="1" Padding="8" CornerRadius="4">
        <pages:SimpleStackPanel Spacing="8">
          <TextBlock Text="一行（自定义 Panel 内）"/>
          <Button Content="按钮（自定义 Panel 内）" HorizontalAlignment="Left"/>
          <TextBlock Text="另一行（自定义 Panel 内）"/>
        </pages:SimpleStackPanel>
      </Border>
      <TextBlock Text="MeasureOverride 核心：" FontWeight="SemiBold"/>
      <Border Background="#1E1E1E" Padding="8" CornerRadius="4">
        <TextBlock Foreground="#D4D4D4" FontFamily="Consolas,Monaco,monospace" TextWrapping="Wrap"
                   Text="foreach (var child in Children)&#10;{&#10;    L.Measure(new Size(availableSize.Width, double.PositiveInfinity));&#10;    w = Math.Max(w, L.DesiredSize.Width);&#10;    h += L.DesiredSize.Height + (first ? 0 : Spacing);&#10;}&#10;return new Size(w, h);"/>
      </Border>
      <TextBlock Text="作业：AttachedProperty 版 MiniDock；单测 DesiredHeight == h1+spacing+h2（可无窗口 Measure）" TextWrapping="Wrap"/>
      <TextBlock Text="验收：提交一个自定义 Panel + 布局断言" Foreground="DarkGreen"/>
    </StackPanel>
  </ScrollViewer>
</UserControl>
