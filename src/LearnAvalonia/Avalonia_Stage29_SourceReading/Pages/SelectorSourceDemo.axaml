<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:pages="clr-namespace:LearnAvalonia.Avalonia_Stage29_SourceReading.Pages"
             x:Class="LearnAvalonia.Avalonia_Stage29_SourceReading.Pages.SelectorSourceDemo"
             x:DataType="pages:SelectorSourceDemo">
  <ScrollViewer Padding="8">
    <StackPanel Spacing="6" Margin="8">
      <TextBlock Text="§11 Selector / Style Matching —— 反射探查" FontWeight="Bold" FontSize="14"/>
      <TextBlock Text="反射 Selector / IStyle；展示选择器类型与 Combinator。" TextWrapping="Wrap"/>
      <ItemsControl ItemsSource="{Binding Entries}">
        <ItemsControl.ItemTemplate>
          <DataTemplate x:DataType="pages:ReflectionEntry">
            <StackPanel Orientation="Horizontal" Spacing="8">
              <TextBlock Text="{Binding Key}" FontWeight="SemiBold" MinWidth="200"/>
              <TextBlock Text="{Binding Value}" TextWrapping="Wrap"/>
            </StackPanel>
          </DataTemplate>
        </ItemsControl.ItemTemplate>
      </ItemsControl>
      <TextBlock Text="匹配序：Type → Class → Name → PseudoClass — 同优先级后者覆盖" TextWrapping="Wrap" FontFamily="Consolas,Monaco,monospace"/>
      <TextBlock Text="验收：画出选择器匹配顺序" Foreground="DarkGreen"/>
    </StackPanel>
  </ScrollViewer>
</UserControl>
