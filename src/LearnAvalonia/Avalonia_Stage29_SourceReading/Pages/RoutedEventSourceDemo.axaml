<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:pages="clr-namespace:LearnAvalonia.Avalonia_Stage29_SourceReading.Pages"
             x:Class="LearnAvalonia.Avalonia_Stage29_SourceReading.Pages.RoutedEventSourceDemo"
             x:DataType="pages:RoutedEventSourceDemo">
  <ScrollViewer Padding="8">
    <StackPanel Spacing="6" Margin="8">
      <TextBlock Text="§8 Routed Events —— 反射探查" FontWeight="Bold" FontSize="14"/>
      <TextBlock Text="反射 RoutedEventArgs / RoutingStrategy；展示注册/订阅与 bubble/tunnel/direct。" TextWrapping="Wrap"/>
      <ItemsControl ItemsSource="{Binding Entries}">
        <ItemsControl.ItemTemplate>
          <DataTemplate x:DataType="pages:ReflectionEntry">
            <StackPanel Orientation="Horizontal" Spacing="8">
              <TextBlock Text="{Binding Key}" FontWeight="SemiBold" MinWidth="200"/>
              <TextBlock Text="{Binding Value}" TextWrapping="Wrap"/>
            </StackPanel>
          </DataTemplate>
        </ItemsControl.ItemTemplate>
      </ItemsControl>
      <TextBlock Text="路径：source → tunnel(root→source) → at source → bubble(source→root)" TextWrapping="Wrap" FontFamily="Consolas,Monaco,monospace"/>
      <TextBlock Text="验收：区分 tunnel/bubble/直接" Foreground="DarkGreen"/>
    </StackPanel>
  </ScrollViewer>
</UserControl>
