<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:pages="clr-namespace:LearnAvalonia.Avalonia_Stage29_SourceReading.Pages"
             x:Class="LearnAvalonia.Avalonia_Stage29_SourceReading.Pages.RendererSourceDemo"
             x:DataType="pages:RendererSourceDemo">
  <ScrollViewer Padding="8">
    <StackPanel Spacing="6" Margin="8">
      <TextBlock Text="§16 Renderer / Compositor / Skia —— 反射探查" FontWeight="Bold" FontSize="14"/>
      <TextBlock Text="反射 IRenderer / Compositor；展示 Render 调用链与 Skia 入口。" TextWrapping="Wrap"/>
      <ItemsControl ItemsSource="{Binding Entries}">
        <ItemsControl.ItemTemplate>
          <DataTemplate x:DataType="pages:ReflectionEntry">
            <StackPanel Orientation="Horizontal" Spacing="8">
              <TextBlock Text="{Binding Key}" FontWeight="SemiBold" MinWidth="280"/>
              <TextBlock Text="{Binding Value}" TextWrapping="Wrap"/>
            </StackPanel>
          </DataTemplate>
        </ItemsControl.ItemTemplate>
      </ItemsControl>
      <TextBlock Text="调用链：InvalidateVisual → dirty region → Render(DrawingContext) → Compositor → Skia" TextWrapping="Wrap" FontFamily="Consolas,Monaco,monospace"/>
      <TextBlock Text="验收：画出 Render 调用链" Foreground="DarkGreen"/>
    </StackPanel>
  </ScrollViewer>
</UserControl>
