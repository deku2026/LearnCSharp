<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:pages="clr-namespace:LearnAvalonia.Avalonia_Stage29_SourceReading.Pages"
             x:Class="LearnAvalonia.Avalonia_Stage29_SourceReading.Pages.AppBuilderSourceDemo"
             x:DataType="pages:AppBuilderSourceDemo">
  <ScrollViewer Padding="8">
    <StackPanel Spacing="6" Margin="8">
      <TextBlock Text="§1 AppBuilder —— 反射探查" FontWeight="Bold" FontSize="14"/>
      <TextBlock Text="用 typeof(AppBuilder) 反射列出类型与公共方法：Configure / UsePlatformDetect / WithInterFont / LogToTrace 等流式入口。" TextWrapping="Wrap"/>
      <ItemsControl ItemsSource="{Binding Entries}">
        <ItemsControl.ItemTemplate>
          <DataTemplate x:DataType="pages:ReflectionEntry">
            <StackPanel Orientation="Horizontal" Spacing="8">
              <TextBlock Text="{Binding Key}" FontWeight="SemiBold" MinWidth="220"/>
              <TextBlock Text="{Binding Value}" TextWrapping="Wrap"/>
            </StackPanel>
          </DataTemplate>
        </ItemsControl.ItemTemplate>
      </ItemsControl>
      <TextBlock Text="调用链示意：OS Main → AppBuilder.Configure&lt;TApp&gt;() → UsePlatformDetect() → WithInterFont() → LogToTrace() → StartWithClassicDesktopLifetime()" TextWrapping="Wrap" FontFamily="Consolas,Monaco,monospace"/>
      <TextBlock Text="验收：画出 AppBuilder 注入链" Foreground="DarkGreen"/>
    </StackPanel>
  </ScrollViewer>
</UserControl>
