<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:pages="clr-namespace:LearnAvalonia.Avalonia_Stage29_SourceReading.Pages"
             x:Class="LearnAvalonia.Avalonia_Stage29_SourceReading.Pages.ControlThemeSourceDemo"
             x:DataType="pages:ControlThemeSourceDemo">
  <ScrollViewer Padding="8">
    <StackPanel Spacing="6" Margin="8">
      <TextBlock Text="§12 ControlTheme / TemplatedControl —— 反射探查" FontWeight="Bold" FontSize="14"/>
      <TextBlock Text="反射 TemplatedControl / ControlTheme；展示 OnApplyTemplate 入口与 TemplateBinding 契约。" TextWrapping="Wrap"/>
      <ItemsControl ItemsSource="{Binding Entries}">
        <ItemsControl.ItemTemplate>
          <DataTemplate x:DataType="pages:ReflectionEntry">
            <StackPanel Orientation="Horizontal" Spacing="8">
              <TextBlock Text="{Binding Key}" FontWeight="SemiBold" MinWidth="220"/>
              <TextBlock Text="{Binding Value}" TextWrapping="Wrap"/>
            </StackPanel>
          </DataTemplate>
        </ItemsControl.ItemTemplate>
      </ItemsControl>
      <TextBlock Text="契约：模板 = ControlTheme + x:Key=控件类型；Apply → OnApplyTemplate → 取 PART_" TextWrapping="Wrap" FontFamily="Consolas,Monaco,monospace"/>
      <TextBlock Text="验收：说出 TemplatedControl 契约" Foreground="DarkGreen"/>
    </StackPanel>
  </ScrollViewer>
</UserControl>