<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:pages="clr-namespace:LearnAvalonia.Avalonia_Stage29_SourceReading.Pages"
             x:Class="LearnAvalonia.Avalonia_Stage29_SourceReading.Pages.BindingSourceDemo"
             x:DataType="pages:BindingSourceDemo">
  <ScrollViewer Padding="8">
    <StackPanel Spacing="6" Margin="8">
      <TextBlock Text="§10 Binding Engine —— 反射探查" FontWeight="Bold" FontSize="14"/>
      <TextBlock Text="反射 Binding / CompiledBinding / BindingOperations；展示 compiled vs reflection。" TextWrapping="Wrap"/>
      <ItemsControl ItemsSource="{Binding Entries}">
        <ItemsControl.ItemTemplate>
          <DataTemplate x:DataType="pages:ReflectionEntry">
            <StackPanel Orientation="Horizontal" Spacing="8">
              <TextBlock Text="{Binding Key}" FontWeight="SemiBold" MinWidth="220"/>
              <TextBlock Text="{Binding Value}" TextWrapping="Wrap"/>
            </StackPanel>
          </DataTemplate>
        </ItemsControl.ItemTemplate>
      </ItemsControl>
      <TextBlock Text="路径：obj[!Prop] → BindingExpression → Install → PropertyChanged 通知" TextWrapping="Wrap" FontFamily="Consolas,Monaco,monospace"/>
      <TextBlock Text="验收：解释 compiled vs reflection" Foreground="DarkGreen"/>
    </StackPanel>
  </ScrollViewer>
</UserControl>