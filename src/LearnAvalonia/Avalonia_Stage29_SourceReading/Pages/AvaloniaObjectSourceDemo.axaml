<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:pages="clr-namespace:LearnAvalonia.Avalonia_Stage29_SourceReading.Pages"
             x:Class="LearnAvalonia.Avalonia_Stage29_SourceReading.Pages.AvaloniaObjectSourceDemo"
             x:DataType="pages:AvaloniaObjectSourceDemo">
  <ScrollViewer Padding="8">
    <StackPanel Spacing="6" Margin="8">
      <TextBlock Text="§3 AvaloniaObject —— 反射探查" FontWeight="Bold" FontSize="14"/>
      <TextBlock Text="反射 typeof(AvaloniaObject) 列出 GetValue/SetValue/SetCurrentValue 等；它是所有属性系统的根。" TextWrapping="Wrap"/>
      <ItemsControl ItemsSource="{Binding Entries}">
        <ItemsControl.ItemTemplate>
          <DataTemplate x:DataType="pages:ReflectionEntry">
            <StackPanel Orientation="Horizontal" Spacing="8">
              <TextBlock Text="{Binding Key}" FontWeight="SemiBold" MinWidth="200"/>
              <TextBlock Text="{Binding Value}" TextWrapping="Wrap"/>
            </StackPanel>
          </DataTemplate>
        </ItemsControl.ItemTemplate>
      </ItemsControl>
      <TextBlock Text="优先级（高→低）：Animation > LocalValue > StyleTrigger > TemplatedParent > Inherited > Default" TextWrapping="Wrap" FontFamily="Consolas,Monaco,monospace"/>
      <TextBlock Text="验收：说出 AO 的属性优先级入口" Foreground="DarkGreen"/>
    </StackPanel>
  </ScrollViewer>
</UserControl>