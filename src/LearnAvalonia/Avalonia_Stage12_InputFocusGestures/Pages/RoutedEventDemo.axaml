<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="LearnAvalonia.Avalonia_Stage12_InputFocusGestures.Pages.RoutedEventDemo">
  <ScrollViewer Padding="8">
    <StackPanel Spacing="6" Margin="8">
      <TextBlock Text="§2.1 路由事件：direct / tunnel / bubble" FontWeight="Bold" FontSize="14"/>
      <Border BorderBrush="Gray" BorderThickness="1" Padding="8" CornerRadius="4">
        <Grid ColumnDefinitions="1*,1.4*,1.4*" RowDefinitions="Auto,Auto,Auto,Auto">
          <TextBlock Grid.Row="0" Grid.Column="0" Text="策略" FontWeight="SemiBold"/>
          <TextBlock Grid.Row="0" Grid.Column="1" Text="含义" FontWeight="SemiBold"/>
          <TextBlock Grid.Row="0" Grid.Column="2" Text="典型命名" FontWeight="SemiBold"/>
          <TextBlock Grid.Row="1" Grid.Column="0" Text="Tunnel" TextWrapping="Wrap"/>
          <TextBlock Grid.Row="1" Grid.Column="1" Text="根 → 源" TextWrapping="Wrap"/>
          <TextBlock Grid.Row="1" Grid.Column="2" Text="PreviewKeyDown 等" TextWrapping="Wrap"/>
          <TextBlock Grid.Row="2" Grid.Column="0" Text="Direct" TextWrapping="Wrap"/>
          <TextBlock Grid.Row="2" Grid.Column="1" Text="仅源" TextWrapping="Wrap"/>
          <TextBlock Grid.Row="2" Grid.Column="2" Text="部分属性变更" TextWrapping="Wrap"/>
          <TextBlock Grid.Row="3" Grid.Column="0" Text="Bubble" TextWrapping="Wrap"/>
          <TextBlock Grid.Row="3" Grid.Column="1" Text="源 → 根" TextWrapping="Wrap"/>
          <TextBlock Grid.Row="3" Grid.Column="2" Text="KeyDown/Click/Tapped" TextWrapping="Wrap"/>
        </Grid>
      </Border>
      <Border Background="#1E1E1E" Padding="8" CornerRadius="4">
        <TextBlock Text="// 隧道阶段拦截（父先于子）&#10;parent.AddHandler(InputElement.KeyDownEvent,&#10;    OnPreviewKeyDown, RoutingStrategies.Tunnel);&#10;&#10;void OnPreviewKeyDown(object? s, KeyEventArgs e) {&#10;    if (e.Key == Key.Escape) e.Handled = true;  // 全局取消&#10;}" Foreground="#D4D4D4" FontFamily="Consolas,Monaco,monospace" TextWrapping="Wrap"/>
      </Border>
      <TextBlock Text="Handled：标记后默认不再路由（除非订阅时 handledEventsToo: true）。不要无脑 Handled = true。" TextWrapping="Wrap"/>
      <TextBlock Text="验收：演示 Handled 与 handledEventsToo" Foreground="DarkGreen"/>
    </StackPanel>
  </ScrollViewer>
</UserControl>
