<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="LearnAvalonia.Avalonia_Stage12_InputFocusGestures.Pages.BrowserLimitsDemo">
  <ScrollViewer Padding="8">
    <StackPanel Spacing="6" Margin="8">
      <TextBlock Text="§2.11 浏览器限制（🌍）" FontWeight="Bold" FontSize="14"/>
      <Border BorderBrush="Gray" BorderThickness="1" Padding="8" CornerRadius="4">
        <Grid ColumnDefinitions="1.4*,2*" RowDefinitions="Auto,Auto,Auto,Auto,Auto,Auto,Auto,Auto">
          <TextBlock Grid.Row="0" Grid.Column="0" Text="能力" FontWeight="SemiBold"/>
          <TextBlock Grid.Row="0" Grid.Column="1" Text="浏览器约束" FontWeight="SemiBold"/>
          <TextBlock Grid.Row="1" Grid.Column="0" Text="剪贴板读" TextWrapping="Wrap"/>
          <TextBlock Grid.Row="1" Grid.Column="1" Text="常需用户手势 + 权限" TextWrapping="Wrap"/>
          <TextBlock Grid.Row="2" Grid.Column="0" Text="剪贴板写" TextWrapping="Wrap"/>
          <TextBlock Grid.Row="2" Grid.Column="1" Text="同样可能门控" TextWrapping="Wrap"/>
          <TextBlock Grid.Row="3" Grid.Column="0" Text="文件拖放" TextWrapping="Wrap"/>
          <TextBlock Grid.Row="3" Grid.Column="1" Text="支持但格式/权限子集" TextWrapping="Wrap"/>
          <TextBlock Grid.Row="4" Grid.Column="0" Text="全局热键" TextWrapping="Wrap"/>
          <TextBlock Grid.Row="4" Grid.Column="1" Text="基本不可用" TextWrapping="Wrap"/>
          <TextBlock Grid.Row="5" Grid.Column="0" Text="指针捕获" TextWrapping="Wrap"/>
          <TextBlock Grid.Row="5" Grid.Column="1" Text="有限；离开窗口行为不同" TextWrapping="Wrap"/>
          <TextBlock Grid.Row="6" Grid.Column="0" Text="多指手势" TextWrapping="Wrap"/>
          <TextBlock Grid.Row="6" Grid.Column="1" Text="浏览器/OS 可能抢手势" TextWrapping="Wrap"/>
          <TextBlock Grid.Row="7" Grid.Column="0" Text="IME / 触觉" TextWrapping="Wrap"/>
          <TextBlock Grid.Row="7" Grid.Column="1" Text="依赖浏览器实现 / 有限或无" TextWrapping="Wrap"/>
        </Grid>
      </Border>
      <TextBlock Text="设计：所有剪贴板/文件操作放在 Button Click 等用户手势调用栈内；失败时 UI 明示。" TextWrapping="Wrap"/>
      <TextBlock Text="验收：剪贴板/热键/捕获在浏览器门控" Foreground="DarkGreen"/>
    </StackPanel>
  </ScrollViewer>
</UserControl>
