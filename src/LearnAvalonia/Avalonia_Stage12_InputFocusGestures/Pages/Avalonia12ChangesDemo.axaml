<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="LearnAvalonia.Avalonia_Stage12_InputFocusGestures.Pages.Avalonia12ChangesDemo">
  <ScrollViewer Padding="8">
    <StackPanel Spacing="6" Margin="8">
      <TextBlock Text="§4 Avalonia 12 / 12.1 变化" FontWeight="Bold" FontSize="14"/>
      <Border BorderBrush="Gray" BorderThickness="1" Padding="8" CornerRadius="4">
        <Grid ColumnDefinitions="1.4*,2*" RowDefinitions="Auto,Auto,Auto,Auto,Auto,Auto,Auto">
          <TextBlock Grid.Row="0" Grid.Column="0" Text="变化" FontWeight="SemiBold"/>
          <TextBlock Grid.Row="0" Grid.Column="1" Text="说明" FontWeight="SemiBold"/>
          <TextBlock Grid.Row="1" Grid.Column="0" Text="手势事件位置" TextWrapping="Wrap"/>
          <TextBlock Grid.Row="1" Grid.Column="1" Text="迁到 InputElement；弱化 Gestures. 前缀" TextWrapping="Wrap"/>
          <TextBlock Grid.Row="2" Grid.Column="0" Text="Access Keys" TextWrapping="Wrap"/>
          <TextBlock Grid.Row="2" Grid.Column="1" Text="按符号匹配等行为更新" TextWrapping="Wrap"/>
          <TextBlock Grid.Row="3" Grid.Column="0" Text="剪贴板/DnD" TextWrapping="Wrap"/>
          <TextBlock Grid.Row="3" Grid.Column="1" Text="IAsyncDataTransfer 异步模型" TextWrapping="Wrap"/>
          <TextBlock Grid.Row="4" Grid.Column="0" Text="选择" TextWrapping="Wrap"/>
          <TextBlock Grid.Row="4" Grid.Column="1" Text="触/笔多在 release 选择" TextWrapping="Wrap"/>
          <TextBlock Grid.Row="5" Grid.Column="0" Text="PlatformFeedback" TextWrapping="Wrap"/>
          <TextBlock Grid.Row="5" Grid.Column="1" Text="移动触觉/声音入口" TextWrapping="Wrap"/>
          <TextBlock Grid.Row="6" Grid.Column="0" Text="Focus 参数" TextWrapping="Wrap"/>
          <TextBlock Grid.Row="6" Grid.Column="1" Text="关注 GotFocus 导航方式等" TextWrapping="Wrap"/>
        </Grid>
      </Border>
      <TextBlock Text="多 Dispatcher：属性在正确 Dispatcher 访问（阶段 2）。" TextWrapping="Wrap"/>
      <TextBlock Text="验收：手势迁 InputElement/异步 DnD" Foreground="DarkGreen"/>
    </StackPanel>
  </ScrollViewer>
</UserControl>
