<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="LearnAvalonia.Avalonia_Stage12_InputFocusGestures.Pages.DeprecatedApisDemo">
  <ScrollViewer Padding="8">
    <StackPanel Spacing="6" Margin="8">
      <TextBlock Text="§5 过时与禁止" FontWeight="Bold" FontSize="14"/>
      <Border BorderBrush="Gray" BorderThickness="1" Padding="8" CornerRadius="4">
        <Grid ColumnDefinitions="1.6*,2*" RowDefinitions="Auto,Auto,Auto,Auto,Auto,Auto,Auto,Auto">
          <TextBlock Grid.Row="0" Grid.Column="0" Text="禁止" FontWeight="SemiBold"/>
          <TextBlock Grid.Row="0" Grid.Column="1" Text="说明" FontWeight="SemiBold"/>
          <TextBlock Grid.Row="1" Grid.Column="0" Text="仅依赖旧 Gestures.XXX 静态事件教程" TextWrapping="Wrap"/>
          <TextBlock Grid.Row="1" Grid.Column="1" Text="按 InputElement 事件重写" TextWrapping="Wrap"/>
          <TextBlock Grid.Row="2" Grid.Column="0" Text="捕获后不处理 CaptureLost" TextWrapping="Wrap"/>
          <TextBlock Grid.Row="2" Grid.Column="1" Text="拖动状态泄漏" TextWrapping="Wrap"/>
          <TextBlock Grid.Row="3" Grid.Column="0" Text="IME 组合期当提交的 Enter" TextWrapping="Wrap"/>
          <TextBlock Grid.Row="3" Grid.Column="1" Text="错误提交/截断" TextWrapping="Wrap"/>
          <TextBlock Grid.Row="4" Grid.Column="0" Text="浏览器页面加载时偷读剪贴板" TextWrapping="Wrap"/>
          <TextBlock Grid.Row="4" Grid.Column="1" Text="失败且可能违规" TextWrapping="Wrap"/>
          <TextBlock Grid.Row="5" Grid.Column="0" Text="全局热键当可移植功能" TextWrapping="Wrap"/>
          <TextBlock Grid.Row="5" Grid.Column="1" Text="平台专属模块" TextWrapping="Wrap"/>
          <TextBlock Grid.Row="6" Grid.Column="0" Text="无 hit-test 背景的空白区手势" TextWrapping="Wrap"/>
          <TextBlock Grid.Row="6" Grid.Column="1" Text="加 Transparent 背景" TextWrapping="Wrap"/>
          <TextBlock Grid.Row="7" Grid.Column="0" Text="同步阻塞等 DnD 大数据" TextWrapping="Wrap"/>
          <TextBlock Grid.Row="7" Grid.Column="1" Text="异步传输" TextWrapping="Wrap"/>
        </Grid>
      </Border>
      <TextBlock Text="焦点陷阱无 Escape → 对话框无障碍失败。" TextWrapping="Wrap" Foreground="OrangeRed"/>
      <TextBlock Text="验收：禁旧 Gestures 静态/同步 DnD" Foreground="DarkGreen"/>
    </StackPanel>
  </ScrollViewer>
</UserControl>
