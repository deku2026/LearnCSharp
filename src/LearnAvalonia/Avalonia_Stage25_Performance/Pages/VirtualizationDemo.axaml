<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:pages="clr-namespace:LearnAvalonia.Avalonia_Stage25_Performance.Pages"
             x:DataType="pages:VirtualizationDemo"
             x:Class="LearnAvalonia.Avalonia_Stage25_Performance.Pages.VirtualizationDemo">
  <ScrollViewer Padding="8">
    <StackPanel Spacing="6" Margin="8">
      <TextBlock Text="§7 虚拟化" FontWeight="Bold" FontSize="14"/>
      <TextBlock Text="ListBox 默认虚拟化：仅渲染可视区 + 缓冲项；5000 项也流畅。" TextWrapping="Wrap"/>
      <TextBlock Text="现场：5000 项 ListBox（虚拟化）" FontWeight="SemiBold"/>
      <Border BorderBrush="Gray" BorderThickness="1" Padding="4" CornerRadius="4">
        <ListBox ItemsSource="{Binding BigItems}" Height="200">
          <ListBox.ItemTemplate>
            <DataTemplate x:DataType="x:String">
              <TextBlock Text="{Binding}" Padding="4"/>
            </DataTemplate>
          </ListBox.ItemTemplate>
        </ListBox>
      </Border>
      <TextBlock Text="反例：ScrollViewer &gt; StackPanel &gt; 5000 个项 → 全量 measure，卡死。" TextWrapping="Wrap"/>
      <TextBlock Text="ItemsRepeater：更轻量，无选择/滚动条；自管虚拟化布局。" TextWrapping="Wrap"/>
      <TextBlock Text="验收：ListBox 虚拟化默认" Foreground="DarkGreen"/>
    </StackPanel>
  </ScrollViewer>
</UserControl>