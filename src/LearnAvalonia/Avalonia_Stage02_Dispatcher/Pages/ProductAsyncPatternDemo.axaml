<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="LearnAvalonia.Avalonia_Stage02_Dispatcher.Pages.ProductAsyncPatternDemo">
  <ScrollViewer Padding="8">
    <StackPanel Spacing="6" Margin="8">
      <TextBlock Text="§9 模式汇编：产品级异步 UI" FontWeight="Bold" FontSize="14"/>
      <TextBlock Text="可取消加载：" FontWeight="SemiBold"/>
      <Border Background="#1E1E1E" Padding="8" CornerRadius="4">
        <TextBlock Foreground="#D4D4D4" FontFamily="Consolas,Monaco,monospace" TextWrapping="Wrap"
                   Text="_loadCts?.Cancel();&#10;_loadCts = new CancellationTokenSource();&#10;var ct = _loadCts.Token;&#10;var data = await _service.LoadAsync(ct).ConfigureAwait(false);&#10;await Dispatcher.UIThread.InvokeAsync(() =>&#10;{&#10;    if (ct.IsCancellationRequested) return;&#10;    Apply(data);&#10;});"/>
      </Border>
      <TextBlock Text="节流搜索框：" FontWeight="SemiBold"/>
      <Border Background="#1E1E1E" Padding="8" CornerRadius="4">
        <TextBlock Foreground="#D4D4D4" FontFamily="Consolas,Monaco,monospace" TextWrapping="Wrap"
                   Text="await Task.Delay(300, ct);          // 节流&#10;var items = await _api.SearchAsync(q, ct).ConfigureAwait(false);&#10;await Dispatcher.UIThread.InvokeAsync(() => Items = items, DispatcherPriority.Background);"/>
      </Border>
      <TextBlock Text="禁止在属性 getter 里启动异步 —— getter 应纯净；异步放命令或显式方法" TextWrapping="Wrap" Foreground="OrangeRed"/>
      <TextBlock Text="验收：可取消加载 + 节流搜索" Foreground="DarkGreen"/>
    </StackPanel>
  </ScrollViewer>
</UserControl>
