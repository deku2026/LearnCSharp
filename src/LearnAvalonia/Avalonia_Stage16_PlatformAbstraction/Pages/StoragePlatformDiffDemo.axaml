<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="LearnAvalonia.Avalonia_Stage16_PlatformAbstraction.Pages.StoragePlatformDiffDemo">
  <ScrollViewer Padding="8">
    <StackPanel Spacing="6" Margin="8">
      <TextBlock Text="§2.5 平台差异（Storage）" FontWeight="Bold" FontSize="14"/>
      <Border BorderBrush="Gray" BorderThickness="1" Padding="8" CornerRadius="4">
        <Grid ColumnDefinitions="*,*,*,*" RowDefinitions="Auto,Auto,Auto,Auto">
          <TextBlock Grid.Row="0" Grid.Column="0" Text="项" FontWeight="SemiBold"/>
          <TextBlock Grid.Row="0" Grid.Column="1" Text="Win32" FontWeight="SemiBold"/>
          <TextBlock Grid.Row="0" Grid.Column="2" Text="macOS" FontWeight="SemiBold"/>
          <TextBlock Grid.Row="0" Grid.Column="3" Text="Linux" FontWeight="SemiBold"/>
          <TextBlock Grid.Row="1" Grid.Column="0" Text="沙盒" TextWrapping="Wrap"/>
          <TextBlock Grid.Row="1" Grid.Column="1" Text="否（全盘）" TextWrapping="Wrap"/>
          <TextBlock Grid.Row="1" Grid.Column="2" Text="App Sandbox" TextWrapping="Wrap"/>
          <TextBlock Grid.Row="1" Grid.Column="3" Text="Flatpak/Portal" TextWrapping="Wrap"/>
          <TextBlock Grid.Row="2" Grid.Column="0" Text="Bookmark" TextWrapping="Wrap"/>
          <TextBlock Grid.Row="2" Grid.Column="1" Text="不需要" TextWrapping="Wrap"/>
          <TextBlock Grid.Row="2" Grid.Column="2" Text="需要持久化" TextWrapping="Wrap"/>
          <TextBlock Grid.Row="2" Grid.Column="3" Text="需要（Portal）" TextWrapping="Wrap"/>
          <TextBlock Grid.Row="3" Grid.Column="0" Text="UI" TextWrapping="Wrap"/>
          <TextBlock Grid.Row="3" Grid.Column="1" Text="Win32 对话框" TextWrapping="Wrap"/>
          <TextBlock Grid.Row="3" Grid.Column="2" Text="NSOpenPanel" TextWrapping="Wrap"/>
          <TextBlock Grid.Row="3" Grid.Column="3" Text="GTK FileChooser" TextWrapping="Wrap"/>
        </Grid>
      </Border>
      <TextBlock Text="结论：API 表面统一；底层平台不同 UI 实现。" TextWrapping="Wrap"/>
      <TextBlock Text="验收：Storage 三平台差异" Foreground="DarkGreen"/>
    </StackPanel>
  </ScrollViewer>
</UserControl>
