<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:pages="clr-namespace:LearnAvalonia.Avalonia_Stage16_PlatformAbstraction.Pages"
             x:DataType="pages:FolderPickerDemo"
             x:Class="LearnAvalonia.Avalonia_Stage16_PlatformAbstraction.Pages.FolderPickerDemo">
  <ScrollViewer Padding="8">
    <StackPanel Spacing="6" Margin="8">
      <TextBlock Text="§2.4 文件夹选择器（OpenFolderPickerAsync）" FontWeight="Bold" FontSize="14"/>
      <TextBlock Text="代码：StorageProvider.OpenFolderPickerAsync(new FolderPickerOpenOptions { ... })" TextWrapping="Wrap"/>
      <Button Content="选择文件夹…" Click="OnPickFolder" HorizontalAlignment="Left" Margin="0,4"/>
      <TextBlock Text="已选择：" FontWeight="SemiBold" Margin="0,8,0,2"/>
      <Border BorderBrush="Gray" BorderThickness="1" Padding="6" CornerRadius="4" MaxHeight="180">
        <ItemsControl ItemsSource="{Binding Picked}">
          <ItemsControl.ItemTemplate>
            <DataTemplate x:DataType="x:String">
              <TextBlock Text="{Binding}" TextWrapping="Wrap" FontFamily="Consolas,Monaco,monospace" FontSize="11"/>
            </DataTemplate>
          </ItemsControl.ItemTemplate>
        </ItemsControl>
      </Border>
      <TextBlock Text="返回 IStorageFolder（继承 IStorageItem）；可后续遍历子项/读写。" TextWrapping="Wrap"/>
      <TextBlock Text="验收：OpenFolderPickerAsync" Foreground="DarkGreen"/>
    </StackPanel>
  </ScrollViewer>
</UserControl>
