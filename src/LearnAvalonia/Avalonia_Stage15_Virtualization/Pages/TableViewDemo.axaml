<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:pages="clr-namespace:LearnAvalonia.Avalonia_Stage15_Virtualization.Pages"
             x:DataType="pages:TableViewDemo"
             x:Class="LearnAvalonia.Avalonia_Stage15_Virtualization.Pages.TableViewDemo">
  <ScrollViewer Padding="8">
    <StackPanel Spacing="6" Margin="8">
      <TextBlock Text="§2.3 TableView（12.1 新）· 只读表首选" FontWeight="Bold" FontSize="14"/>
      <TextBlock Text="包：Avalonia.Controls 核心包，无需额外 NuGet；自 12.1 起作为轻量只读表。" TextWrapping="Wrap"/>
      <TextBlock Text="特性：行虚拟化、列不虚拟化；派生自 ListBox 一脉。" TextWrapping="Wrap"/>
      <TextBlock Text="现场：1k 行日志表（行虚拟化滚动）" FontWeight="SemiBold"/>
      <Border BorderBrush="Gray" BorderThickness="1" Padding="8" CornerRadius="4">
        <TableView ItemsSource="{Binding Logs}" CanUserResizeColumns="True" MaxHeight="220">
          <TableView.Columns>
            <TableViewColumn Header="Id" Binding="{Binding Id}" Width="80"/>
            <TableViewColumn Header="级别" Binding="{Binding Level}" Width="100"/>
            <TableViewColumn Header="消息" Binding="{Binding Message}" Width="3*"/>
          </TableView.Columns>
        </TableView>
      </Border>
      <TextBlock Text="注意：列不虚拟化 → 横向列爆炸会疼；控制列数或改交互。" TextWrapping="Wrap" Foreground="OrangeRed"/>
      <TextBlock Text="验收：TableView 列定义/虚拟化" Foreground="DarkGreen"/>
    </StackPanel>
  </ScrollViewer>
</UserControl>
