<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="LearnAvalonia.Avalonia_Capstone2_ComplexDesktop.Pages.TrayMenuDndDemo">
  <ScrollViewer Padding="8">
    <StackPanel Spacing="6" Margin="8">
      <TextBlock Text="§9 Tray · NativeMenu · DnD" FontWeight="Bold" FontSize="14"/>
      <TextBlock Text="Tray" FontWeight="SemiBold"/>
      <Border Background="#1E1E1E" Padding="8" CornerRadius="4">
        <TextBlock Text="&lt;!-- TrayIcon + NativeMenu：Show / 新建 / 退出 --&gt;&#x0a;关闭主窗可隐藏到托盘（设置项）" Foreground="#D4D4D4" FontFamily="Consolas,Monaco,monospace" TextWrapping="Wrap"/>
      </Border>
      <TextBlock Text="Native 菜单：文件 打开/保存/退出 · 编辑 撤销/重做 · 帮助 关于；macOS 应用菜单结构符合平台习惯" TextWrapping="Wrap"/>
      <TextBlock Text="DnD：从系统拖入文件到窗口 → 打开 · 格式走 12 transfer 模型 · 非法文件提示" TextWrapping="Wrap"/>
      <StackPanel Orientation="Horizontal" Spacing="6" Margin="0,4,0,0">
        <Button Content="Tray 说明" Click="TrayButton_Click"/>
        <Button Content="Native 菜单说明" Click="NativeMenuButton_Click"/>
        <Button Content="DnD 说明" Click="DndButton_Click"/>
      </StackPanel>
      <TextBlock x:Name="TrayLog" Text="日志：点击按钮查看 Tray/NativeMenu/DnD..." FontFamily="Consolas,Monaco,monospace" TextWrapping="Wrap" Margin="0,4,0,0"/>
      <TextBlock Text="12 变化检查表：剪贴板若用则 async/transfer · 无 new Screen · Tray 用 NativeMenu · DataGrid 知 deprecated 叙事或改 TableView" TextWrapping="Wrap" Foreground="Gray"/>
      <TextBlock Text="验收：TrayIcon+NativeMenu + 文件拖入" Foreground="DarkGreen"/>
    </StackPanel>
  </ScrollViewer>
</UserControl>