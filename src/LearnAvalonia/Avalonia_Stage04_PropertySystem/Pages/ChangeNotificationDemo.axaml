<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="LearnAvalonia.Avalonia_Stage04_PropertySystem.Pages.ChangeNotificationDemo">
  <ScrollViewer Padding="8">
    <StackPanel Spacing="6" Margin="8">
      <TextBlock Text="§7 变更通知与响应式编程接点" FontWeight="Bold" FontSize="14"/>
      <TextBlock Text="PropertyChanged：" FontWeight="SemiBold"/>
      <Border Background="#1E1E1E" Padding="8" CornerRadius="4">
        <TextBlock Foreground="#D4D4D4" FontFamily="Consolas,Monaco,monospace" TextWrapping="Wrap"
                   Text="protected override void OnPropertyChanged(AvaloniaPropertyChangedEventArgs change)&#10;{&#10;    base.OnPropertyChanged(change);&#10;    if (change.Property == TextProperty)&#10;    {&#10;        var oldText = change.GetOldValue&lt;string&gt;();&#10;        var newText = change.GetNewValue&lt;string&gt;();&#10;    }&#10;}"/>
      </Border>
      <TextBlock Text="与 INPC 的分工：" FontWeight="SemiBold"/>
      <Border BorderBrush="Gray" BorderThickness="1" Padding="8" CornerRadius="4">
        <Grid ColumnDefinitions="1.4*,1.4*,1.2*" RowDefinitions="Auto,Auto,Auto,Auto">
          <TextBlock Grid.Row="0" Grid.Column="0" Text="项" FontWeight="SemiBold"/>
          <TextBlock Grid.Row="0" Grid.Column="1" Text="AvaloniaProperty" FontWeight="SemiBold"/>
          <TextBlock Grid.Row="0" Grid.Column="2" Text="INPC（ViewModel）" FontWeight="SemiBold"/>
          <TextBlock Grid.Row="1" Grid.Column="0" Text="谁"/>
          <TextBlock Grid.Row="1" Grid.Column="1" Text="UI 对象"/>
          <TextBlock Grid.Row="1" Grid.Column="2" Text="数据对象"/>
          <TextBlock Grid.Row="2" Grid.Column="0" Text="样式/动画"/>
          <TextBlock Grid.Row="2" Grid.Column="1" Text="是"/>
          <TextBlock Grid.Row="2" Grid.Column="2" Text="否"/>
          <TextBlock Grid.Row="3" Grid.Column="0" Text="绑定源"/>
          <TextBlock Grid.Row="3" Grid.Column="1" Text="也可以，但不典型"/>
          <TextBlock Grid.Row="3" Grid.Column="2" Text="主线"/>
        </Grid>
      </Border>
      <TextBlock Text="VM 用 INotifyPropertyChanged / ObservableObject；控件用 AvaloniaProperty" TextWrapping="Wrap"/>
      <TextBlock Text="验收：写出 class handler 或 OnPropertyChanged 处理" Foreground="DarkGreen"/>
    </StackPanel>
  </ScrollViewer>
</UserControl>
