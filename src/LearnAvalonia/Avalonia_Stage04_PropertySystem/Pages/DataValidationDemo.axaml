<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="LearnAvalonia.Avalonia_Stage04_PropertySystem.Pages.DataValidationDemo">
  <ScrollViewer Padding="8">
    <StackPanel Spacing="6" Margin="8">
      <TextBlock Text="§11 数据验证与绑定错误展示" FontWeight="Bold" FontSize="14"/>
      <TextBlock Text="属性启用验证：" FontWeight="SemiBold"/>
      <Border Background="#1E1E1E" Padding="8" CornerRadius="4">
        <TextBlock Foreground="#D4D4D4" FontFamily="Consolas,Monaco,monospace" TextWrapping="Wrap"
                   Text="public static readonly StyledProperty&lt;string?&gt; CodeProperty =&#10;    AvaloniaProperty.Register&lt;CodeBox, string?&gt;(&#10;        nameof(Code), enableDataValidation: true,&#10;        defaultBindingMode: BindingMode.TwoWay);"/>
      </Border>
      <TextBlock Text="12 自动处理：enableDataValidation: true 时默认自动 UpdateDataValidation，不必手写样板" TextWrapping="Wrap"/>
      <TextBlock Text="❌ 12 不再需要的样板：" FontWeight="SemiBold" Foreground="OrangeRed"/>
      <Border Background="#1E1E1E" Padding="8" CornerRadius="4">
        <TextBlock Foreground="#D4D4D4" FontFamily="Consolas,Monaco,monospace" TextWrapping="Wrap"
                   Text="// protected override void UpdateDataValidation(...)&#10;// {&#10;//     if (property == CodeProperty)&#10;//         DataValidationErrors.SetError(this, error);&#10;// }"/>
      </Border>
      <TextBlock Text="VM 侧用 INotifyDataErrorInfo 或 Toolkit 验证；错误沿绑定进入目标属性验证通道" TextWrapping="Wrap"/>
      <TextBlock Text="验收：12 验证样板不再无脑粘贴" Foreground="DarkGreen"/>
    </StackPanel>
  </ScrollViewer>
</UserControl>
