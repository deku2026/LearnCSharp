<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="LearnAvalonia.Avalonia_Stage22_DataNetworkAuth.Pages.SourceReadingDemo">
  <ScrollViewer Padding="8">
    <StackPanel Spacing="6" Margin="8">
      <TextBlock Text="§18 源码阅读 + 登录序列图" FontWeight="Bold" FontSize="14"/>
      <TextBlock Text="阅读优先级" FontWeight="SemiBold"/>
      <Border BorderBrush="Gray" BorderThickness="1" Padding="8" CornerRadius="4">
        <StackPanel Spacing="3">
          <TextBlock Text="1. HttpClientFactory 源码/文档生命周期" TextWrapping="Wrap"/>
          <TextBlock Text="2. DelegatingHandler 管道顺序" TextWrapping="Wrap"/>
          <TextBlock Text="3. STJ source gen 生成代码" TextWrapping="Wrap"/>
          <TextBlock Text="4. EF Core SQLite 迁移" TextWrapping="Wrap"/>
          <TextBlock Text="5. IdentityModel / 官方 OIDC 客户端库用法（若采用）" TextWrapping="Wrap"/>
          <TextBlock Text="6. 平台 Keychain/Credential 封装库源码（所选）" TextWrapping="Wrap"/>
        </StackPanel>
      </Border>
      <TextBlock Text="输出：登录到带 token 的第一次 API 调用序列图" FontWeight="SemiBold"/>
      <Border Background="#1E1E1E" Padding="8" CornerRadius="4">
        <TextBlock Text="VM → IAuthService.LoginAsync&#x0a;  → 构造授权 URL（含 PKCE challenge）&#x0a;  → IAuthBrowser 打开系统浏览器&#x0a;  → 用户登录 → redirect?code=...&#x0a;  → TokenEndpoint 交换 code+verifier → TokenPair&#x0a;  → ISecureStore.SetAsync(refresh) + 内存 access&#x0a;VM → INotesApi.ListAsync(ct)&#x0a;  → AuthHeaderHandler 注入 Bearer access&#x0a;  → HttpClient.GetAsync(&quot;/notes&quot;)&#x0a;  → 200 → STJ source gen 反序列化 → VM.Items" Foreground="#D4D4D4" FontFamily="Consolas,Monaco,monospace" TextWrapping="Wrap"/>
      </Border>
      <TextBlock Text="验收：登录到首次 API 调用序列图" Foreground="DarkGreen"/>
    </StackPanel>
  </ScrollViewer>
</UserControl>