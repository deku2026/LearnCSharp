<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="LearnAvalonia.Avalonia_Stage22_DataNetworkAuth.Pages.WebViewLoginDemo">
  <ScrollViewer Padding="8">
    <StackPanel Spacing="6" Margin="8">
      <TextBlock Text="§10 WebView 登录与系统浏览器" FontWeight="Bold" FontSize="14"/>
      <Border BorderBrush="Gray" BorderThickness="1" Padding="8" CornerRadius="4">
        <Grid ColumnDefinitions="*,*,*" RowDefinitions="Auto,Auto,Auto" RowSpacing="4" ColumnSpacing="8">
          <TextBlock Grid.Row="0" Grid.Column="0" Text="方式" FontWeight="SemiBold" Padding="4"/>
          <TextBlock Grid.Row="0" Grid.Column="1" Text="优点" FontWeight="SemiBold" Padding="4"/>
          <TextBlock Grid.Row="0" Grid.Column="2" Text="缺点" FontWeight="SemiBold" Padding="4"/>
          <TextBlock Grid.Row="1" Grid.Column="0" Text="WebAuthenticationBroker" TextWrapping="Wrap" Padding="4"/>
          <TextBlock Grid.Row="1" Grid.Column="1" Text="专用、回调清晰" TextWrapping="Wrap" Padding="4"/>
          <TextBlock Grid.Row="1" Grid.Column="2" Text="平台覆盖要测" TextWrapping="Wrap" Padding="4"/>
          <TextBlock Grid.Row="2" Grid.Column="0" Text="系统浏览器 + 自定义 URI" TextWrapping="Wrap" Padding="4"/>
          <TextBlock Grid.Row="2" Grid.Column="1" Text="共享 SSO cookie、安全推荐" TextWrapping="Wrap" Padding="4"/>
          <TextBlock Grid.Row="2" Grid.Column="2" Text="实现跳转注册" TextWrapping="Wrap" Padding="4"/>
        </Grid>
      </Border>
      <TextBlock Text="嵌入 NativeWebView：可定制 UI；但钓鱼难辨、cookie 隔离、安全审查严" TextWrapping="Wrap" Foreground="OrangeRed"/>
      <TextBlock Text="优先 Broker 或系统浏览器；嵌入 WebView 登录需安全评审" Foreground="DarkGreen" TextWrapping="Wrap"/>
      <TextBlock Text="与阶段 17 衔接：IAuthBrowser 实现放 Infrastructure；VM 只调 IAuthService" TextWrapping="Wrap"/>
      <TextBlock Text="验收：三种登录方式对比" Foreground="DarkGreen"/>
    </StackPanel>
  </ScrollViewer>
</UserControl>
