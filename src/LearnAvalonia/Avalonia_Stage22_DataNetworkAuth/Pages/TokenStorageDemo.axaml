<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="LearnAvalonia.Avalonia_Stage22_DataNetworkAuth.Pages.TokenStorageDemo">
  <ScrollViewer Padding="8">
    <StackPanel Spacing="6" Margin="8">
      <TextBlock Text="§11 Token 存储与内存模型" FontWeight="Bold" FontSize="14"/>
      <Border Background="#1E1E1E" Padding="8" CornerRadius="4">
        <TextBlock Text="AccessToken：内存 + 可选安全存储&#x0a;RefreshToken：仅安全存储&#x0a;过期点：提前 1–2 分钟刷新&#x0a;锁屏：可选清内存 access" Foreground="#D4D4D4" FontFamily="Consolas,Monaco,monospace" TextWrapping="Wrap"/>
      </Border>
      <TextBlock Text="ITokenProvider" FontWeight="SemiBold"/>
      <Border Background="#1E1E1E" Padding="8" CornerRadius="4">
        <TextBlock Text="public interface ITokenProvider&#x0a;{&#x0a;    Task&lt;string?&gt; GetAccessTokenAsync(CancellationToken ct = default);&#x0a;    Task SetTokensAsync(TokenPair pair, CancellationToken ct = default);&#x0a;    Task ClearAsync(CancellationToken ct = default);&#x0a;}" Foreground="#D4D4D4" FontFamily="Consolas,Monaco,monospace" TextWrapping="Wrap"/>
      </Border>
      <TextBlock Text="验收：access 内存 + refresh 安全存储" Foreground="DarkGreen"/>
    </StackPanel>
  </ScrollViewer>
</UserControl>