<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="LearnAvalonia.Avalonia_Capstone1_DesktopFoundation.Pages.UiInformationArchitectureDemo">
  <ScrollViewer Padding="8">
    <StackPanel Spacing="6" Margin="8">
      <TextBlock Text="§5 UI 信息架构与线框" FontWeight="Bold" FontSize="14"/>
      <TextBlock Text="主窗口线框：" FontWeight="SemiBold"/>
      <Border Background="#1E1E1E" Padding="8" CornerRadius="4">
        <TextBlock Foreground="#D4D4D4" FontFamily="Consolas,Monaco,monospace" TextWrapping="Wrap"
                   Text="┌──────────────────────────────────────────────┐&#10;│ Menu/Title                              _ □ x│&#10;├────────────┬─────────────────────────────────┤&#10;│ 导航       │  工具条：搜索 [        ] [新建]  │&#10;│ · 全部任务 │─────────────────────────────────│&#10;│ · 今天     │  列表 / TableView                │&#10;│ · 已完成   │  ...                            │&#10;│ · 设置     │                                 │&#10;│            │                                 │&#10;├────────────┴─────────────────────────────────┤&#10;│ 状态：n 项 · 最后保存时间                     │&#10;└──────────────────────────────────────────────┘"/>
      </Border>
      <TextBlock Text="关键页面：" FontWeight="SemiBold"/>
      <Border BorderBrush="Gray" BorderThickness="1" Padding="8" CornerRadius="4">
        <Grid ColumnDefinitions="Auto,*" RowDefinitions="Auto,Auto,Auto" RowSpacing="4" ColumnSpacing="8">
          <TextBlock Grid.Row="0" Grid.Column="0" Text="列表" FontWeight="SemiBold" Padding="4"/>
          <TextBlock Grid.Row="0" Grid.Column="1" Text="ListBox 或 TableView；空状态" TextWrapping="Wrap" Padding="4"/>
          <TextBlock Grid.Row="1" Grid.Column="0" Text="编辑" FontWeight="SemiBold" Padding="4"/>
          <TextBlock Grid.Row="1" Grid.Column="1" Text="TextBox PlaceholderText、Toggle、Date、Button Command" TextWrapping="Wrap" Padding="4"/>
          <TextBlock Grid.Row="2" Grid.Column="0" Text="设置" FontWeight="SemiBold" Padding="4"/>
          <TextBlock Grid.Row="2" Grid.Column="1" Text="ToggleSwitch 主题、语言 ComboBox、关于" TextWrapping="Wrap" Padding="4"/>
        </Grid>
      </Border>
      <TextBlock Text="交互流程（删除）：用户点删除 → IDialogService.Confirm → 否返回 → 是 Repository.Delete → 列表移除 → 状态栏提示" TextWrapping="Wrap"/>
      <TextBlock Text="交互流程（导出）：用户点导出 → IFilePickerService.SaveAsync → 取消返回 → 确认序列化写文件 → Alert 成功/失败" TextWrapping="Wrap"/>
      <TextBlock Text="验收：主壳自适应 resize 无崩布局" Foreground="DarkGreen"/>
    </StackPanel>
  </ScrollViewer>
</UserControl>
