<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="LearnAvalonia.Avalonia_Stage24_TestingSystem.Pages.CiIntegrationDemo">
  <ScrollViewer Padding="8">
    <StackPanel Spacing="6" Margin="8">
      <TextBlock Text="§7 CI 集成" FontWeight="Bold" FontSize="14"/>
      <TextBlock Text="本地命令" FontWeight="SemiBold"/>
      <Border Background="#1E1E1E" Padding="8" CornerRadius="4">
        <TextBlock Text="dotnet test src/LearnAvalonia/Avalonia_Stage24_TestingSystem.Tests&#x0a;dotnet test LearnCSharp.CI.slnx --filter &quot;FullyQualifiedName~Avalonia_Stage24&quot;" Foreground="#D4D4D4" FontFamily="Consolas,Monaco,monospace" TextWrapping="Wrap"/>
      </Border>
      <TextBlock Text="GitHub Actions YAML 片段" FontWeight="SemiBold"/>
      <Border Background="#1E1E1E" Padding="8" CornerRadius="4">
        <TextBlock Text="jobs:&#x0a;  test:&#x0a;    strategy:&#x0a;      matrix:&#x0a;        os: [ubuntu-latest, windows-latest, macos-latest]&#x0a;    runs-on: ${{{{ matrix.os }}}}&#x0a;    steps:&#x0a;      - uses: actions/checkout@v4&#x0a;      - uses: actions/setup-dotnet@v4&#x0a;        with:&#x0a;          dotnet-version: '10.0.x'&#x0a;      - run: dotnet test --no-restore --verbosity normal" Foreground="#D4D4D4" FontFamily="Consolas,Monaco,monospace" TextWrapping="Wrap"/>
      </Border>
      <TextBlock Text="Linux Headless：需虚拟显示 Xvfb（apt-get install xvfb；xvfb-run dotnet test）。" TextWrapping="Wrap"/>
      <TextBlock Text="Avalonia 12.1：Headless 不再需要 Xvfb（Skia 内存后端）。" TextWrapping="Wrap"/>
      <TextBlock Text="验收：dotnet test + Headless 跑通" Foreground="DarkGreen"/>
    </StackPanel>
  </ScrollViewer>
</UserControl>
