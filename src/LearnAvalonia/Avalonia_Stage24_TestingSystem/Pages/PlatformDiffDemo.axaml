<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="LearnAvalonia.Avalonia_Stage24_TestingSystem.Pages.PlatformDiffDemo">
  <ScrollViewer Padding="8">
    <StackPanel Spacing="6" Margin="8">
      <TextBlock Text="§8 平台差异" FontWeight="Bold" FontSize="14"/>
      <Grid ColumnDefinitions="Auto,*,*,*" RowDefinitions="Auto,Auto,Auto,Auto,Auto" RowSpacing="3" ColumnSpacing="8">
        <TextBlock Grid.Row="0" Grid.Column="0" Text="维度" FontWeight="SemiBold" Padding="4"/>
        <TextBlock Grid.Row="0" Grid.Column="1" Text="Windows" FontWeight="SemiBold" Padding="4"/>
        <TextBlock Grid.Row="0" Grid.Column="2" Text="macOS" FontWeight="SemiBold" Padding="4"/>
        <TextBlock Grid.Row="0" Grid.Column="3" Text="Linux" FontWeight="SemiBold" Padding="4"/>
        <TextBlock Grid.Row="1" Grid.Column="0" Text="Headless" Padding="4"/>
        <TextBlock Grid.Row="1" Grid.Column="1" Text="原生支持" TextWrapping="Wrap" Padding="4"/>
        <TextBlock Grid.Row="1" Grid.Column="2" Text="原生支持" TextWrapping="Wrap" Padding="4"/>
        <TextBlock Grid.Row="1" Grid.Column="3" Text="12.1 原生；旧版需 Xvfb" TextWrapping="Wrap" Padding="4"/>
        <TextBlock Grid.Row="2" Grid.Column="0" Text="字体" Padding="4"/>
        <TextBlock Grid.Row="2" Grid.Column="1" Text="Segoe UI/Inter" TextWrapping="Wrap" Padding="4"/>
        <TextBlock Grid.Row="2" Grid.Column="2" Text="SF/Inter" TextWrapping="Wrap" Padding="4"/>
        <TextBlock Grid.Row="2" Grid.Column="3" Text="Noto/Inter" TextWrapping="Wrap" Padding="4"/>
        <TextBlock Grid.Row="3" Grid.Column="0" Text="Appium" Padding="4"/>
        <TextBlock Grid.Row="3" Grid.Column="1" Text="WinAppDriver" TextWrapping="Wrap" Padding="4"/>
        <TextBlock Grid.Row="3" Grid.Column="2" Text="Mac2 Driver" TextWrapping="Wrap" Padding="4"/>
        <TextBlock Grid.Row="3" Grid.Column="3" Text="不支持" TextWrapping="Wrap" Padding="4"/>
        <TextBlock Grid.Row="4" Grid.Column="0" Text="Visual 回归" Padding="4"/>
        <TextBlock Grid.Row="4" Grid.Column="1" Text="Skia 像素一致" TextWrapping="Wrap" Padding="4"/>
        <TextBlock Grid.Row="4" Grid.Column="2" Text="Skia 像素一致" TextWrapping="Wrap" Padding="4"/>
        <TextBlock Grid.Row="4" Grid.Column="3" Text="字体回退差异需容忍" TextWrapping="Wrap" Padding="4"/>
      </Grid>
      <TextBlock Text="验收：三平台测试差异表" Foreground="DarkGreen"/>
    </StackPanel>
  </ScrollViewer>
</UserControl>
