<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="LearnAvalonia.Avalonia_Stage17_WebViewHybrid.Pages.SelectionMatrixDemo">
  <ScrollViewer Padding="8">
    <StackPanel Spacing="6" Margin="8">
      <TextBlock Text="§9 选型对比 / 工具表" FontWeight="Bold" FontSize="14"/>
      <Border BorderBrush="Gray" BorderThickness="1" Padding="6" CornerRadius="4">
        <Grid ColumnDefinitions="2*,3*,3*,3*" RowDefinitions="Auto,Auto,Auto,Auto,Auto">
          <TextBlock Grid.Row="0" Grid.Column="0" Text="项" FontWeight="SemiBold"/>
          <TextBlock Grid.Row="0" Grid.Column="1" Text="NativeWebView" FontWeight="SemiBold"/>
          <TextBlock Grid.Row="0" Grid.Column="2" Text="外部浏览器" FontWeight="SemiBold"/>
          <TextBlock Grid.Row="0" Grid.Column="3" Text="Blazor Hybrid" FontWeight="SemiBold"/>
          <TextBlock Grid.Row="1" Grid.Column="0" Text="嵌入" TextWrapping="Wrap"/>
          <TextBlock Grid.Row="1" Grid.Column="1" Text="✅ 嵌入 UI 树" TextWrapping="Wrap"/>
          <TextBlock Grid.Row="1" Grid.Column="2" Text="❌ 独立窗口" TextWrapping="Wrap"/>
          <TextBlock Grid.Row="1" Grid.Column="3" Text="✅ 整页 web UI" TextWrapping="Wrap"/>
          <TextBlock Grid.Row="2" Grid.Column="0" Text="交互" TextWrapping="Wrap"/>
          <TextBlock Grid.Row="2" Grid.Column="1" Text="JS interop" TextWrapping="Wrap"/>
          <TextBlock Grid.Row="2" Grid.Column="2" Text="URL scheme" TextWrapping="Wrap"/>
          <TextBlock Grid.Row="2" Grid.Column="3" Text="Razor 组件" TextWrapping="Wrap"/>
          <TextBlock Grid.Row="3" Grid.Column="0" Text="体积" TextWrapping="Wrap"/>
          <TextBlock Grid.Row="3" Grid.Column="1" Text="小（用系统引擎）" TextWrapping="Wrap"/>
          <TextBlock Grid.Row="3" Grid.Column="2" Text="零" TextWrapping="Wrap"/>
          <TextBlock Grid.Row="3" Grid.Column="3" Text="大（含 .NET runtime）" TextWrapping="Wrap"/>
          <TextBlock Grid.Row="4" Grid.Column="0" Text="适用" TextWrapping="Wrap"/>
          <TextBlock Grid.Row="4" Grid.Column="1" Text="局部 web 片段" TextWrapping="Wrap"/>
          <TextBlock Grid.Row="4" Grid.Column="2" Text="打开外链" TextWrapping="Wrap"/>
          <TextBlock Grid.Row="4" Grid.Column="3" Text="整应用 web 技术栈" TextWrapping="Wrap"/>
        </Grid>
      </Border>
      <TextBlock Text="验收：WebView vs 浏览器 vs Blazor" Foreground="DarkGreen"/>
    </StackPanel>
  </ScrollViewer>
</UserControl>
