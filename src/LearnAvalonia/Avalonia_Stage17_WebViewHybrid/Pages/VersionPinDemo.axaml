<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="LearnAvalonia.Avalonia_Stage17_WebViewHybrid.Pages.VersionPinDemo">
  <ScrollViewer Padding="8">
    <StackPanel Spacing="6" Margin="8">
      <TextBlock Text="§1 版本 pin 与包清单" FontWeight="Bold" FontSize="14"/>
      <TextBlock Text="包：Avalonia.Controls.WebView（单独仓库，与 Avalonia 不同步）。" TextWrapping="Wrap"/>
      <TextBlock Text="当前版本：12.0.1（CPM 中独立 pin）。与 Avalonia 12.1 兼容（同 12.x 主线）。" TextWrapping="Wrap"/>
      <Border Background="#1E1E1E" Padding="8" CornerRadius="4">
        <TextBlock Text="&lt;PackageReference Include=&#34;Avalonia.Controls.WebView&#34; /&gt;&#10;CPM: &lt;PackageVersion Include=&#34;Avalonia.Controls.WebView&#34; Version=&#34;12.0.1&#34; /&gt;" Foreground="#D4D4D4" FontFamily="Consolas,Monaco,monospace" TextWrapping="Wrap"/>
      </Border>
      <TextBlock Text="AppBuilder 初始化：12 起 WebView 包会自动注册所需平台后端；无需 WithWebView()。" TextWrapping="Wrap"/>
      <TextBlock Text="三件套 API：NativeWebView / NativeWebDialog / WebAuthenticationBroker。" TextWrapping="Wrap"/>
      <TextBlock Text="验收：CPM pin WebView 12.0.1" Foreground="DarkGreen"/>
    </StackPanel>
  </ScrollViewer>
</UserControl>