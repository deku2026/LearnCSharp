<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="LearnAvalonia.Avalonia_Stage17_WebViewHybrid.Pages.LocalVsRemoteDemo">
  <ScrollViewer Padding="8">
    <StackPanel Spacing="6" Margin="8">
      <TextBlock Text="§2.4 本地资源 vs 远程" FontWeight="Bold" FontSize="14"/>
      <Border BorderBrush="Gray" BorderThickness="1" Padding="8" CornerRadius="4">
        <Grid ColumnDefinitions="*,4,*" RowDefinitions="Auto,Auto,Auto,Auto">
          <TextBlock Grid.Row="0" Grid.Column="0" Text="本地资源" FontWeight="SemiBold"/>
          <TextBlock Grid.Row="0" Grid.Column="2" Text="远程资源" FontWeight="SemiBold"/>
          <TextBlock Grid.Row="1" Grid.Column="0" Text="avares://MyApp/Assets/page.html" TextWrapping="Wrap"/>
          <TextBlock Grid.Row="1" Grid.Column="2" Text="https://example.com/page.html" TextWrapping="Wrap"/>
          <TextBlock Grid.Row="2" Grid.Column="0" Text="打包进程序；离线可用" TextWrapping="Wrap"/>
          <TextBlock Grid.Row="2" Grid.Column="2" Text="需联网；可热更新" TextWrapping="Wrap"/>
          <TextBlock Grid.Row="3" Grid.Column="0" Text="无 CORS 限制" TextWrapping="Wrap"/>
          <TextBlock Grid.Row="3" Grid.Column="2" Text="受 CORS / 证书影响" TextWrapping="Wrap"/>
        </Grid>
      </Border>
      <TextBlock Text="资源拦截（§5）：可拦截 avares:// / https:// 请求 → 返回自定义内容。" TextWrapping="Wrap"/>
      <TextBlock Text="验收：avares:// vs https://" Foreground="DarkGreen"/>
    </StackPanel>
  </ScrollViewer>
</UserControl>
