<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="LearnAvalonia.Avalonia_Stage23_AccessibilityI18n.Pages.KeyboardNavDemo">
  <ScrollViewer Padding="8">
    <StackPanel Spacing="6" Margin="8">
      <TextBlock Text="§2 键盘导航与焦点" FontWeight="Bold" FontSize="14"/>
      <TextBlock Text="焦点链：Tab 前进 / Shift+Tab 后退；TabIndex 控制顺序；TabStop=false 退出链。" TextWrapping="Wrap"/>
      <TextBlock Text="关键属性" FontWeight="SemiBold"/>
      <Grid ColumnDefinitions="Auto,*" RowDefinitions="Auto,Auto,Auto,Auto,Auto" RowSpacing="3" ColumnSpacing="8">
        <TextBlock Grid.Row="0" Grid.Column="0" Text="KeyboardNavigation.TabOnceActiveElement" FontWeight="SemiBold" Padding="4"/>
        <TextBlock Grid.Row="0" Grid.Column="1" Text="容器内只 Tab 一次（RadioGroup 常用）" TextWrapping="Wrap" Padding="4"/>
        <TextBlock Grid.Row="1" Grid.Column="0" Text="KeyboardNavigation.TabNavigation" FontWeight="SemiBold" Padding="4"/>
        <TextBlock Grid.Row="1" Grid.Column="1" Text="None/Continue/Cycle/Once" TextWrapping="Wrap" Padding="4"/>
        <TextBlock Grid.Row="2" Grid.Column="0" Text="TabIndex" FontWeight="SemiBold" Padding="4"/>
        <TextBlock Grid.Row="2" Grid.Column="1" Text="显式排序；缺省按树序" TextWrapping="Wrap" Padding="4"/>
        <TextBlock Grid.Row="3" Grid.Column="0" Text="Focusable" FontWeight="SemiBold" Padding="4"/>
        <TextBlock Grid.Row="3" Grid.Column="1" Text="false 时不可焦点" TextWrapping="Wrap" Padding="4"/>
        <TextBlock Grid.Row="4" Grid.Column="0" Text=":focus-visible" FontWeight="SemiBold" Padding="4"/>
        <TextBlock Grid.Row="4" Grid.Column="1" Text="键盘焦点视觉（区别于点击）" TextWrapping="Wrap" Padding="4"/>
      </Grid>
      <TextBlock Text="现场：Tab/Shift+Tab 走以下控件；TabNavigation=Cycle 限定第一组" FontWeight="SemiBold"/>
      <Border BorderBrush="Gray" BorderThickness="1" Padding="8" CornerRadius="4">
        <StackPanel Spacing="6" KeyboardNavigation.TabNavigation="Cycle">
          <TextBox x:Name="TargetInput" PlaceholderText="输入框（先 Tab 到这里）"/>
          <Button Content="点击聚焦到输入框" Click="FocusFirstButton_Click"/>
          <CheckBox Content="可勾选项"/>
          <RadioButton Content="选项 A" GroupName="G1"/>
          <RadioButton Content="选项 B" GroupName="G1"/>
          <Slider Minimum="0" Maximum="100" Value="50" Width="200"/>
        </StackPanel>
      </Border>
      <TextBlock Text="自定义箭头导航：重写 OnKeyDown 处理 Left/Right/Up/Down 并调 Focus()。" TextWrapping="Wrap"/>
      <TextBlock Text="Drag 可达性：拖拽必须提供等价键盘操作（菜单/按钮）；不能仅靠鼠标。" TextWrapping="Wrap"/>
      <TextBlock Text="验收：Tab/Arrow/Drag 验收可演示" Foreground="DarkGreen"/>
    </StackPanel>
  </ScrollViewer>
</UserControl>