<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="LearnAvalonia.Avalonia_Stage23_AccessibilityI18n.Pages.PlatformBridgeDemo">
  <ScrollViewer Padding="8">
    <StackPanel Spacing="6" Margin="8">
      <TextBlock Text="§3 平台读屏桥接" FontWeight="Bold" FontSize="14"/>
      <TextBlock Text="Avalonia.Automation 通过平台 Peer 把 AutomationPeer 树桥到原生 AT。" TextWrapping="Wrap"/>
      <Grid ColumnDefinitions="Auto,*,*" RowDefinitions="Auto,Auto,Auto,Auto,Auto" RowSpacing="3" ColumnSpacing="8">
        <TextBlock Grid.Row="0" Grid.Column="0" Text="平台" FontWeight="SemiBold" Padding="4"/>
        <TextBlock Grid.Row="0" Grid.Column="1" Text="AT（读屏）" FontWeight="SemiBold" Padding="4"/>
        <TextBlock Grid.Row="0" Grid.Column="2" Text="底层 API" FontWeight="SemiBold" Padding="4"/>
        <TextBlock Grid.Row="1" Grid.Column="0" Text="Windows" Padding="4"/>
        <TextBlock Grid.Row="1" Grid.Column="1" Text="Narrator / NVDA / JAWS" TextWrapping="Wrap" Padding="4"/>
        <TextBlock Grid.Row="1" Grid.Column="2" Text="UIAutomation (UIA)" TextWrapping="Wrap" Padding="4"/>
        <TextBlock Grid.Row="2" Grid.Column="0" Text="macOS" Padding="4"/>
        <TextBlock Grid.Row="2" Grid.Column="1" Text="VoiceOver" TextWrapping="Wrap" Padding="4"/>
        <TextBlock Grid.Row="2" Grid.Column="2" Text="AXUIElement + NSAccessibility" TextWrapping="Wrap" Padding="4"/>
        <TextBlock Grid.Row="3" Grid.Column="0" Text="Linux" Padding="4"/>
        <TextBlock Grid.Row="3" Grid.Column="1" Text="Orca" TextWrapping="Wrap" Padding="4"/>
        <TextBlock Grid.Row="3" Grid.Column="2" Text="AT-SPI2 (D-Bus)" TextWrapping="Wrap" Padding="4"/>
        <TextBlock Grid.Row="4" Grid.Column="0" Text="iOS/Android" Padding="4"/>
        <TextBlock Grid.Row="4" Grid.Column="1" Text="VoiceOver / TalkBack" TextWrapping="Wrap" Padding="4"/>
        <TextBlock Grid.Row="4" Grid.Column="2" Text="UIAccessibility / AccessibilityNodeInfo" TextWrapping="Wrap" Padding="4"/>
      </Grid>
      <TextBlock Text="Avalonia 12.1：默认开启 AtSpi；Linux 桌面无需额外配置。" TextWrapping="Wrap"/>
      <TextBlock Text="调试：Windows 用 Accessibility Insights；macOS 用 Accessibility Inspector；Linux 用 accerciser。" TextWrapping="Wrap"/>
      <TextBlock Text="验收：列出三平台桥接点" Foreground="DarkGreen"/>
    </StackPanel>
  </ScrollViewer>
</UserControl>