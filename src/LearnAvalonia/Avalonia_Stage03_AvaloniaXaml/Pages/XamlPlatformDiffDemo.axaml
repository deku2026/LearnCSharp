<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="LearnAvalonia.Avalonia_Stage03_AvaloniaXaml.Pages.XamlPlatformDiffDemo">
  <ScrollViewer Padding="8">
    <StackPanel Spacing="6" Margin="8">
      <TextBlock Text="§12 跨平台差异表" FontWeight="Bold" FontSize="14"/>
      <Border BorderBrush="Gray" BorderThickness="1" Padding="8" CornerRadius="4">
        <Grid ColumnDefinitions="1.2*,1.8*,2*" RowDefinitions="Auto,Auto,Auto,Auto,Auto,Auto">
          <TextBlock Grid.Row="0" Grid.Column="0" Text="平台" FontWeight="SemiBold"/>
          <TextBlock Grid.Row="0" Grid.Column="1" Text="XAML 差异" FontWeight="SemiBold"/>
          <TextBlock Grid.Row="0" Grid.Column="2" Text="注意" FontWeight="SemiBold"/>
          <TextBlock Grid.Row="1" Grid.Column="0" Text="桌面"/>
          <TextBlock Grid.Row="1" Grid.Column="1" Text="完整 Window chrome" TextWrapping="Wrap"/>
          <TextBlock Grid.Row="1" Grid.Column="2" Text="多窗口资源共享 Application" TextWrapping="Wrap"/>
          <TextBlock Grid.Row="2" Grid.Column="0" Text="Android/iOS"/>
          <TextBlock Grid.Row="2" Grid.Column="1" Text="常用 UserControl 作 MainView" TextWrapping="Wrap"/>
          <TextBlock Grid.Row="2" Grid.Column="2" Text="无桌面 Window 根时用 View" TextWrapping="Wrap"/>
          <TextBlock Grid.Row="3" Grid.Column="0" Text="Browser"/>
          <TextBlock Grid.Row="3" Grid.Column="1" Text="同 SingleView" TextWrapping="Wrap"/>
          <TextBlock Grid.Row="3" Grid.Column="2" Text="资源 URI、字体加载" TextWrapping="Wrap"/>
          <TextBlock Grid.Row="4" Grid.Column="0" Text="全平台"/>
          <TextBlock Grid.Row="4" Grid.Column="1" Text="同一套 axaml 控件树" TextWrapping="Wrap"/>
          <TextBlock Grid.Row="4" Grid.Column="2" Text="平台服务仍分平台" TextWrapping="Wrap"/>
          <TextBlock Grid.Row="5" Grid.Column="0" Text="AOT 桌面"/>
          <TextBlock Grid.Row="5" Grid.Column="1" Text="编译 XAML + 编译绑定" TextWrapping="Wrap"/>
          <TextBlock Grid.Row="5" Grid.Column="2" Text="禁用动态 Loader 主路径" TextWrapping="Wrap"/>
        </Grid>
      </Border>
      <TextBlock Text="跨平台一致性来自自绘控件树，不是每平台一套原生 XAML 控件映射" TextWrapping="Wrap"/>
      <TextBlock Text="验收：覆盖 5 类平台 XAML 差异" Foreground="DarkGreen"/>
    </StackPanel>
  </ScrollViewer>
</UserControl>
