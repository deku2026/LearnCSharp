<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="LearnAvalonia.Avalonia_Stage03_AvaloniaXaml.Pages.ResourceKindsDemo">
  <UserControl.Resources>
    <SolidColorBrush x:Key="CardBg" Color="#F3F3F3"/>
  </UserControl.Resources>
  <ScrollViewer Padding="8">
    <StackPanel Spacing="6" Margin="8">
      <TextBlock Text="§5 资源：Static / Dynamic / Theme" FontWeight="Bold" FontSize="14"/>
      <TextBlock Text="StaticResource —— 加载时解析一次；资源替换后不保证自动更新" TextWrapping="Wrap"/>
      <TextBlock Text="DynamicResource —— 建立动态引用；资源字典变化时可更新（适合主题切换）" TextWrapping="Wrap"/>
      <TextBlock Text="ThemeResource —— 与主题系统集成的资源查找" TextWrapping="Wrap"/>
      <TextBlock Text="实际演示 —— Static vs Dynamic 背景色：" FontWeight="SemiBold"/>
      <Grid ColumnDefinitions="*,*" RowDefinitions="Auto,Auto" Margin="0,4,0,0">
        <Border Grid.Row="0" Grid.Column="0" Background="{StaticResource CardBg}" CornerRadius="4" Padding="8">
          <TextBlock Text="Static：加载时固定，替换资源后不更新" TextWrapping="Wrap"/>
        </Border>
        <Border Grid.Row="0" Grid.Column="1" Background="{DynamicResource CardBg}" CornerRadius="4" Padding="8">
          <TextBlock Text="Dynamic：动态引用，替换资源后自动更新" TextWrapping="Wrap"/>
        </Border>
      </Grid>
      <Button x:Name="ToggleBgButton" Content="切换 CardBg 资源（观察 Static vs Dynamic）" Click="ToggleBgButton_Click" Margin="0,4,0,0"/>
      <TextBlock Text="查找顺序：元素 Resources → 逻辑父链 → Application.Resources → 主题/系统资源" TextWrapping="Wrap"/>
      <TextBlock Text="Include 与合并：" FontWeight="SemiBold"/>
      <Border Background="#1E1E1E" Padding="8" CornerRadius="4">
        <TextBlock Foreground="#D4D4D4" FontFamily="Consolas,Monaco,monospace" TextWrapping="Wrap"
                   Text="&lt;ResourceDictionary.MergedDictionaries&gt;&#10;  &lt;ResourceInclude Source=&quot;avares://DemoApp/Assets/Colors.axaml&quot; /&gt;&#10;&lt;/ResourceDictionary.MergedDictionaries&gt;"/>
      </Border>
      <TextBlock Text="验收：区分 StaticResource/DynamicResource/ThemeResource" Foreground="DarkGreen"/>
    </StackPanel>
  </ScrollViewer>
</UserControl>
