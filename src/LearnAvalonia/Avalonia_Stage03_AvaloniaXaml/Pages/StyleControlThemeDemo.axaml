<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="LearnAvalonia.Avalonia_Stage03_AvaloniaXaml.Pages.StyleControlThemeDemo">
  <UserControl.Styles>
    <Style Selector="TextBlock.h1">
      <Setter Property="FontSize" Value="24"/>
      <Setter Property="FontWeight" Value="Bold"/>
    </Style>
  </UserControl.Styles>
  <ScrollViewer Padding="8">
    <StackPanel Spacing="6" Margin="8">
      <TextBlock Text="§6 样式、ControlTheme 与不要用 WPF Trigger 硬套" FontWeight="Bold" FontSize="14"/>
      <TextBlock Text="简单样式（本页已定义）：" FontWeight="SemiBold"/>
      <Border Background="#1E1E1E" Padding="8" CornerRadius="4">
        <TextBlock Foreground="#D4D4D4" FontFamily="Consolas,Monaco,monospace" TextWrapping="Wrap"
                   Text="&lt;Style Selector=&quot;TextBlock.h1&quot;&gt;&#10;  &lt;Setter Property=&quot;FontSize&quot; Value=&quot;24&quot; /&gt;&#10;  &lt;Setter Property=&quot;FontWeight&quot; Value=&quot;Bold&quot; /&gt;&#10;&lt;/Style&gt;"/>
      </Border>
      <TextBlock Text="实际效果：" FontWeight="SemiBold"/>
      <TextBlock Classes="h1" Text="这是 h1 样式（Classes=h1）"/>
      <TextBlock Text="这是普通 TextBlock（对照）"/>
      <TextBlock Text="选择器 + Setter 是 Avalonia 样式主线；ControlTheme 是控件模板与主题的现代单元" TextWrapping="Wrap"/>
      <TextBlock Text="与 WPF 心智差异：" FontWeight="SemiBold"/>
      <Border BorderBrush="Gray" BorderThickness="1" Padding="8" CornerRadius="4">
        <Grid ColumnDefinitions="1.6*,1.6*" RowDefinitions="Auto,Auto,Auto,Auto">
          <TextBlock Grid.Row="0" Grid.Column="0" Text="WPF 习惯" FontWeight="SemiBold"/>
          <TextBlock Grid.Row="0" Grid.Column="1" Text="Avalonia" FontWeight="SemiBold"/>
          <TextBlock Grid.Row="1" Grid.Column="0" Text="DataTrigger 满天飞" TextWrapping="Wrap"/>
          <TextBlock Grid.Row="1" Grid.Column="1" Text="优先样式选择器、绑定、转换器、VM 状态" TextWrapping="Wrap"/>
          <TextBlock Grid.Row="2" Grid.Column="0" Text="重度 ControlTemplate Trigger" TextWrapping="Wrap"/>
          <TextBlock Grid.Row="2" Grid.Column="1" Text="ControlTheme + 伪类 :pointerover 等" TextWrapping="Wrap"/>
          <TextBlock Grid.Row="3" Grid.Column="0" Text="默认反射绑定" TextWrapping="Wrap"/>
          <TextBlock Grid.Row="3" Grid.Column="1" Text="默认编译绑定" TextWrapping="Wrap"/>
        </Grid>
      </Border>
      <TextBlock Text="验收：不把 WPF Trigger 硬套 Avalonia" Foreground="DarkGreen"/>
    </StackPanel>
  </ScrollViewer>
</UserControl>
