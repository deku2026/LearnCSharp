<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="LearnAvalonia.Avalonia_Stage03_AvaloniaXaml.Pages.XamlDeprecatedDemo">
  <ScrollViewer Padding="8">
    <StackPanel Spacing="6" Margin="8">
      <TextBlock Text="§14 过时与禁止" FontWeight="Bold" FontSize="14"/>
      <Border BorderBrush="Gray" BorderThickness="1" Padding="8" CornerRadius="4">
        <Grid ColumnDefinitions="1.8*,1.6*" RowDefinitions="Auto,Auto,Auto,Auto,Auto,Auto,Auto,Auto,Auto">
          <TextBlock Grid.Row="0" Grid.Column="0" Text="禁止/过时" FontWeight="SemiBold"/>
          <TextBlock Grid.Row="0" Grid.Column="1" Text="替代" FontWeight="SemiBold"/>
          <TextBlock Grid.Row="1" Grid.Column="0" Text="假设 XAML {Binding} 是反射" TextWrapping="Wrap"/>
          <TextBlock Grid.Row="1" Grid.Column="1" Text="12 默认编译；配合 x:DataType" TextWrapping="Wrap"/>
          <TextBlock Grid.Row="2" Grid.Column="0" Text="代码里把 Binding 当编译绑定" TextWrapping="Wrap"/>
          <TextBlock Grid.Row="2" Grid.Column="1" Text="CompiledBinding.Create" TextWrapping="Wrap"/>
          <TextBlock Grid.Row="3" Grid.Column="0" Text="IBinding / InstancedBinding" TextWrapping="Wrap"/>
          <TextBlock Grid.Row="3" Grid.Column="1" Text="BindingBase / BindingExpressionBase" TextWrapping="Wrap"/>
          <TextBlock Grid.Row="4" Grid.Column="0" Text="主线依赖运行时 Loader + AOT" TextWrapping="Wrap"/>
          <TextBlock Grid.Row="4" Grid.Column="1" Text="编译 axaml" TextWrapping="Wrap"/>
          <TextBlock Grid.Row="5" Grid.Column="0" Text="把 WPF DataTrigger 体系硬搬" TextWrapping="Wrap"/>
          <TextBlock Grid.Row="5" Grid.Column="1" Text="选择器、VM 状态、转换器" TextWrapping="Wrap"/>
          <TextBlock Grid.Row="6" Grid.Column="0" Text="新代码 Watermark" TextWrapping="Wrap"/>
          <TextBlock Grid.Row="6" Grid.Column="1" Text="PlaceholderText" TextWrapping="Wrap"/>
          <TextBlock Grid.Row="7" Grid.Column="0" Text="无 x:DataType 的大页编译绑定" TextWrapping="Wrap"/>
          <TextBlock Grid.Row="7" Grid.Column="1" Text="补类型或局部 ReflectionBinding" TextWrapping="Wrap"/>
          <TextBlock Grid.Row="8" Grid.Column="0" Text="Avalonia.Browser.Blazor 旧加载叙事" TextWrapping="Wrap"/>
          <TextBlock Grid.Row="8" Grid.Column="1" Text="Avalonia.Browser" TextWrapping="Wrap"/>
        </Grid>
      </Border>
      <TextBlock Text="验收：点名 8 项 XAML 禁令与替代" Foreground="DarkGreen"/>
    </StackPanel>
  </ScrollViewer>
</UserControl>
