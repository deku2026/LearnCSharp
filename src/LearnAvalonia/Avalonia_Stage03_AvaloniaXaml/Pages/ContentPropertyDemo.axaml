<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="LearnAvalonia.Avalonia_Stage03_AvaloniaXaml.Pages.ContentPropertyDemo">
  <ScrollViewer Padding="8">
    <StackPanel Spacing="6" Margin="8">
      <TextBlock Text="§2 内容属性、属性元素与附加属性" FontWeight="Bold" FontSize="14"/>
      <TextBlock Text="Content property —— 子元素无需包属性元素：" FontWeight="SemiBold"/>
      <Border Background="#1E1E1E" Padding="8" CornerRadius="4">
        <TextBlock Foreground="#D4D4D4" FontFamily="Consolas,Monaco,monospace" TextWrapping="Wrap"
                   Text="&lt;Button&gt;&#10;  &lt;TextBlock Text=&quot;保存&quot; /&gt;&#10;&lt;/Button&gt;&#10;&lt;!-- 等价 --&gt;&#10;&lt;Button.Content&gt;&lt;TextBlock Text=&quot;保存&quot; /&gt;&lt;/Button.Content&gt;"/>
      </Border>
      <TextBlock Text="属性元素语法 —— 复杂对象或多行：" FontWeight="SemiBold"/>
      <Border Background="#1E1E1E" Padding="8" CornerRadius="4">
        <TextBlock Foreground="#D4D4D4" FontFamily="Consolas,Monaco,monospace" TextWrapping="Wrap"
                   Text="&lt;Border.Background&gt;&#10;  &lt;LinearGradientBrush StartPoint=&quot;0%,0%&quot; EndPoint=&quot;100%,100%&quot;&gt;&#10;    &lt;GradientStop Offset=&quot;0&quot; Color=&quot;White&quot; /&gt;&#10;    &lt;GradientStop Offset=&quot;1&quot; Color=&quot;LightGray&quot; /&gt;&#10;  &lt;/LinearGradientBrush&gt;&#10;&lt;/Border.Background&gt;"/>
      </Border>
      <TextBlock Text="实际演示 —— 渐变背景 Border：" FontWeight="SemiBold"/>
      <Border CornerRadius="4" Padding="12">
        <Border.Background>
          <LinearGradientBrush StartPoint="0%,0%" EndPoint="100%,100%">
            <GradientStop Offset="0" Color="White"/>
            <GradientStop Offset="1" Color="LightGray"/>
          </LinearGradientBrush>
        </Border.Background>
        <TextBlock Text="渐变背景 Border（属性元素语法）" Foreground="Black"/>
      </Border>
      <TextBlock Text="附加属性 Grid.Row/Grid.Column：" FontWeight="SemiBold"/>
      <Grid ColumnDefinitions="*,*" RowDefinitions="Auto,Auto" Margin="0,4,0,0">
        <TextBlock Grid.Row="0" Grid.Column="0" Text="Grid.Row=0 Col=0" Background="#EEEEEE" Padding="4"/>
        <TextBlock Grid.Row="0" Grid.Column="1" Text="Grid.Row=0 Col=1" Background="#DDDDDD" Padding="4"/>
        <TextBlock Grid.Row="1" Grid.Column="0" Grid.ColumnSpan="2" Text="Grid.ColumnSpan=2" Background="#CCCCCC" Padding="4"/>
      </Grid>
      <TextBlock Text="类型转换：Margin=&quot;8,4&quot; Width=&quot;120&quot; IsVisible=&quot;True&quot; —— Thickness/double/bool 从字符串转换" TextWrapping="Wrap"/>
      <TextBlock Text="验收：说明 content property 与附加属性" Foreground="DarkGreen"/>
    </StackPanel>
  </ScrollViewer>
</UserControl>
