<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="LearnAvalonia.Avalonia_Stage03_AvaloniaXaml.Pages.DataTypeCompileDemo">
  <ScrollViewer Padding="8">
    <StackPanel Spacing="6" Margin="8">
      <TextBlock Text="§4 x:DataType 与 x:CompileBindings" FontWeight="Bold" FontSize="14"/>
      <TextBlock Text="为什么需要 DataType：编译绑定必须在编译期知道数据源类型才能生成访问代码" TextWrapping="Wrap"/>
      <Border Background="#1E1E1E" Padding="8" CornerRadius="4">
        <TextBlock Foreground="#D4D4D4" FontFamily="Consolas,Monaco,monospace" TextWrapping="Wrap"
                   Text="&lt;Window xmlns:vm=&quot;using:DemoApp.ViewModels&quot;&#10;         x:DataType=&quot;vm:MainWindowViewModel&quot;&gt;&#10;  &lt;TextBlock Text=&quot;{Binding Title}&quot; /&gt;&#10;&lt;/Window&gt;"/>
      </Border>
      <TextBlock Text="作用域与嵌套：DataTemplate 可重新声明 x:DataType，内层覆盖外层" TextWrapping="Wrap"/>
      <Border Background="#1E1E1E" Padding="8" CornerRadius="4">
        <TextBlock Foreground="#D4D4D4" FontFamily="Consolas,Monaco,monospace" TextWrapping="Wrap"
                   Text="&lt;DataTemplate x:DataType=&quot;vm:TodoItem&quot;&gt;&#10;  &lt;CheckBox IsChecked=&quot;{Binding IsDone}&quot; Content=&quot;{Binding Text}&quot; /&gt;&#10;&lt;/DataTemplate&gt;"/>
      </Border>
      <TextBlock Text="x:CompileBindings 局部关闭：" FontWeight="SemiBold"/>
      <Border Background="#1E1E1E" Padding="8" CornerRadius="4">
        <TextBlock Foreground="#D4D4D4" FontFamily="Consolas,Monaco,monospace" TextWrapping="Wrap"
                   Text="&lt;StackPanel x:CompileBindings=&quot;False&quot;&gt;&#10;  &lt;TextBlock Text=&quot;{Binding SomeDynamic}&quot; /&gt;&#10;&lt;/StackPanel&gt;"/>
      </Border>
      <TextBlock Text="编译绑定收益与例外：" FontWeight="SemiBold"/>
      <Border BorderBrush="Gray" BorderThickness="1" Padding="8" CornerRadius="4">
        <Grid ColumnDefinitions="1.6*,1.6*" RowDefinitions="Auto,Auto,Auto,Auto">
          <TextBlock Grid.Row="0" Grid.Column="0" Text="收益" FontWeight="SemiBold"/>
          <TextBlock Grid.Row="0" Grid.Column="1" Text="例外场景" FontWeight="SemiBold"/>
          <TextBlock Grid.Row="1" Grid.Column="0" Text="编译期路径检查" TextWrapping="Wrap"/>
          <TextBlock Grid.Row="1" Grid.Column="1" Text="ExpandoObject / 动态字典" TextWrapping="Wrap"/>
          <TextBlock Grid.Row="2" Grid.Column="0" Text="更好性能" TextWrapping="Wrap"/>
          <TextBlock Grid.Row="2" Grid.Column="1" Text="运行时才知道的属性名" TextWrapping="Wrap"/>
          <TextBlock Grid.Row="3" Grid.Column="0" Text="trim/AOT 友好" TextWrapping="Wrap"/>
          <TextBlock Grid.Row="3" Grid.Column="1" Text="必须反射的插件视图" TextWrapping="Wrap"/>
        </Grid>
      </Border>
      <TextBlock Text="验收：说明 DataType 作用域与编译绑定开关" Foreground="DarkGreen"/>
    </StackPanel>
  </ScrollViewer>
</UserControl>
