<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="LearnAvalonia.Avalonia_Capstone3_CrossPlatform.Pages.HeadlessTestDemo">
  <ScrollViewer Padding="8">
    <StackPanel Spacing="6" Margin="8">
      <TextBlock Text="§10.2 Headless 测试（跨平台）" FontWeight="Bold" FontSize="14"/>
      <TextBlock Text="包：Avalonia.Headless + Avalonia.Headless.XUnit（CPM 已 pin）。" TextWrapping="Wrap"/>
      <Border Background="#1E1E1E" Padding="8" CornerRadius="4">
        <TextBlock Text="[AvaloniaFact]&#10;public async Task Click_Increments()&#10;{&#10;    var vm = new CounterViewModel();&#10;    var view = new CounterView { DataContext = vm };&#10;    await view clicking the button using Headless input;&#10;    Assert.Equal(1, vm.Count);&#10;}" Foreground="#D4D4D4" FontFamily="Consolas,Monaco,monospace" TextWrapping="Wrap"/>
      </Border>
      <TextBlock Text="优点：" FontWeight="SemiBold"/>
      <TextBlock Text="· 不开真实窗口；可在 CI 容器跑" TextWrapping="Wrap"/>
      <TextBlock Text="· 三平台测试结果一致（同 Skia headless）" TextWrapping="Wrap"/>
      <TextBlock Text="· xUnit 集成（AvaloniaFact / AvaloniaTheory）" TextWrapping="Wrap"/>
      <TextBlock Text="参考本仓 Stage24 测试工程（Avalonia_Stage24_TestingSystem.Tests）。" TextWrapping="Wrap"/>
      <TextBlock Text="验收：Avalonia.Headless 跨平台测试" Foreground="DarkGreen"/>
    </StackPanel>
  </ScrollViewer>
</UserControl>
