<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="LearnAvalonia.Avalonia_Capstone3_CrossPlatform.Pages.SharedLayerDemo">
  <ScrollViewer Padding="8">
    <StackPanel Spacing="6" Margin="8">
      <TextBlock Text="§2.1 共享什么（桌面三平台）" FontWeight="Bold" FontSize="14"/>
      <Border BorderBrush="Gray" BorderThickness="1" Padding="8" CornerRadius="4">
        <Grid ColumnDefinitions="*,4,*" RowDefinitions="Auto,Auto,Auto,Auto">
          <TextBlock Grid.Row="0" Grid.Column="0" Text="共享（Core）" FontWeight="SemiBold"/>
          <TextBlock Grid.Row="0" Grid.Column="2" Text="平台特化（Desktop）" FontWeight="SemiBold"/>
          <TextBlock Grid.Row="1" Grid.Column="0" Text="ViewModels" TextWrapping="Wrap"/>
          <TextBlock Grid.Row="1" Grid.Column="2" Text="入口 Program / App.axaml" TextWrapping="Wrap"/>
          <TextBlock Grid.Row="2" Grid.Column="0" Text="Service contracts（接口）" TextWrapping="Wrap"/>
          <TextBlock Grid.Row="2" Grid.Column="2" Text="平台实现（Win/macOS/Linux）" TextWrapping="Wrap"/>
          <TextBlock Grid.Row="3" Grid.Column="0" Text="Models / DTOs / Validation" TextWrapping="Wrap"/>
          <TextBlock Grid.Row="3" Grid.Column="2" Text="平台 UI Style/Theme 微调" TextWrapping="Wrap"/>
        </Grid>
      </Border>
      <TextBlock Text="原则：能共享的全共享；只把无法共享的差异点（文件系统/通知/托盘）抽象成接口。" TextWrapping="Wrap"/>
      <TextBlock Text="验收：Views/VM/Service contracts 共享" Foreground="DarkGreen"/>
    </StackPanel>
  </ScrollViewer>
</UserControl>