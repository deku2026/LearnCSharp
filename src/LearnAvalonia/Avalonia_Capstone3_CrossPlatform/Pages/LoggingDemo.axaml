<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="LearnAvalonia.Avalonia_Capstone3_CrossPlatform.Pages.LoggingDemo">
  <ScrollViewer Padding="8">
    <StackPanel Spacing="6" Margin="8">
      <TextBlock Text="§8 日志（桌面三平台）" FontWeight="Bold" FontSize="14"/>
      <Border BorderBrush="Gray" BorderThickness="1" Padding="8" CornerRadius="4">
        <Grid ColumnDefinitions="*,2*,3*" RowDefinitions="Auto,Auto,Auto,Auto">
          <TextBlock Grid.Row="0" Grid.Column="0" Text="平台" FontWeight="SemiBold"/>
          <TextBlock Grid.Row="0" Grid.Column="1" Text="默认 sink" FontWeight="SemiBold"/>
          <TextBlock Grid.Row="0" Grid.Column="2" Text="调试提示" FontWeight="SemiBold"/>
          <TextBlock Grid.Row="1" Grid.Column="0" Text="Windows" TextWrapping="Wrap"/>
          <TextBlock Grid.Row="1" Grid.Column="1" Text="Debug + 事件日志" TextWrapping="Wrap"/>
          <TextBlock Grid.Row="1" Grid.Column="2" Text="DebugView / 事件查看器" TextWrapping="Wrap"/>
          <TextBlock Grid.Row="2" Grid.Column="0" Text="macOS" TextWrapping="Wrap"/>
          <TextBlock Grid.Row="2" Grid.Column="1" Text="Console + unified log" TextWrapping="Wrap"/>
          <TextBlock Grid.Row="2" Grid.Column="2" Text="log show --predicate ..." TextWrapping="Wrap"/>
          <TextBlock Grid.Row="3" Grid.Column="0" Text="Linux" TextWrapping="Wrap"/>
          <TextBlock Grid.Row="3" Grid.Column="1" Text="stderr + journald" TextWrapping="Wrap"/>
          <TextBlock Grid.Row="3" Grid.Column="2" Text="journalctl -t MyApp" TextWrapping="Wrap"/>
        </Grid>
      </Border>
      <TextBlock Text="提示脚本（开发期通用）：dotnet run --project src/MyApp.Desktop 2&gt;&amp;1 | tee run.log" TextWrapping="Wrap" FontFamily="Consolas,Monaco,monospace"/>
      <TextBlock Text="验收：三平台日志状态/提示脚本" Foreground="DarkGreen"/>
    </StackPanel>
  </ScrollViewer>
</UserControl>
