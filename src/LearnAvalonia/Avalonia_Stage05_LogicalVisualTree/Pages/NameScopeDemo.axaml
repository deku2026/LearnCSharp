<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="LearnAvalonia.Avalonia_Stage05_LogicalVisualTree.Pages.NameScopeDemo">
  <ScrollViewer Padding="8">
    <StackPanel Spacing="6" Margin="8">
      <TextBlock Text="§4 NameScope：名字的边界" FontWeight="Bold" FontSize="14"/>
      <TextBlock Text="x:Name 注册到当前 NameScope；模板引入独立 NameScope，模板内部 x:Name 与外部同名不冲突，也互相 Find 不到" TextWrapping="Wrap"/>
      <Border Background="#1E1E1E" Padding="8" CornerRadius="4">
        <TextBlock Foreground="#D4D4D4" FontFamily="Consolas,Monaco,monospace" TextWrapping="Wrap"
                   Text="&lt;UserControl x:Name=&quot;Root&quot;&gt;&#10;  &lt;Grid&gt;&#10;    &lt;TextBox x:Name=&quot;Query&quot; /&gt;&#10;  &lt;/Grid&gt;&#10;&lt;/UserControl&gt;&#10;&#10;&lt;!-- 某控件模板内部也可有 x:Name=&quot;Query&quot; —— 不同 Scope --&gt;"/>
      </Border>
      <TextBlock Text="查找：" FontWeight="SemiBold"/>
      <Border Background="#1E1E1E" Padding="8" CornerRadius="4">
        <TextBlock Foreground="#D4D4D4" FontFamily="Consolas,Monaco,monospace" TextWrapping="Wrap"
                   Text="var box = this.FindControl&lt;TextBox&gt;(&quot;Query&quot;);"/>
      </Border>
      <Border BorderBrush="Gray" BorderThickness="1" Padding="8" CornerRadius="4">
        <Grid ColumnDefinitions="1.6*,1*" RowDefinitions="Auto,Auto,Auto">
          <TextBlock Grid.Row="0" Grid.Column="0" Text="查找位置" FontWeight="SemiBold"/>
          <TextBlock Grid.Row="0" Grid.Column="1" Text="能看到模板内部名字？" FontWeight="SemiBold"/>
          <TextBlock Grid.Row="1" Grid.Column="0" Text="页面/UserControl scope" TextWrapping="Wrap"/>
          <TextBlock Grid.Row="1" Grid.Column="1" Text="通常否"/>
          <TextBlock Grid.Row="2" Grid.Column="0" Text="模板 scope" TextWrapping="Wrap"/>
          <TextBlock Grid.Row="2" Grid.Column="1" Text="是"/>
        </Grid>
      </Border>
      <TextBlock Text="自定义控件模板部件：OnApplyTemplate 里 e.NameScope.Find&lt;T&gt;(&quot;PART_Xxx&quot;)" TextWrapping="Wrap"/>
      <TextBlock Text="验收：解释模板内外 x:Name 互不可见" Foreground="DarkGreen"/>
    </StackPanel>
  </ScrollViewer>
</UserControl>
