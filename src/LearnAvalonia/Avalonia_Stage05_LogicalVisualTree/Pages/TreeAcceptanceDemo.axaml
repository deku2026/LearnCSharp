<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="LearnAvalonia.Avalonia_Stage05_LogicalVisualTree.Pages.TreeAcceptanceDemo">
  <ScrollViewer Padding="8">
    <StackPanel Spacing="6" Margin="8">
      <TextBlock Text="§18 验收标准（可勾选清单）" FontWeight="Bold" FontSize="14"/>
      <Border BorderBrush="Gray" BorderThickness="1" Padding="8" CornerRadius="4">
        <StackPanel Spacing="3">
          <CheckBox IsChecked="True" Content="闭卷解释 logical vs visual vs NameScope"/>
          <CheckBox IsChecked="True" Content="说明 TemplatedParent 与 TemplateBinding"/>
          <CheckBox IsChecked="True" Content="用工具或日志对照同一控件两棵树"/>
          <CheckBox IsChecked="True" Content="解释资源查找与 DataContext 继承沿何关系"/>
          <CheckBox IsChecked="True" Content="描述路由事件与 hit test 基本路径"/>
          <CheckBox IsChecked="True" Content="说明 Popup 独立 visual root 的后果"/>
          <CheckBox IsChecked="True" Content="正确调用 TopLevel.GetTopLevel；不把根 Visual 强转 TopLevel"/>
          <CheckBox IsChecked="True" Content="知道 AdornerLayer 获取方式"/>
          <CheckBox IsChecked="True" Content="自定义控件在 OnApplyTemplate 取 PART 而不是页面跨 scope 查找"/>
        </StackPanel>
      </Border>
      <TextBlock Text="验收：勾选 9 条验收清单" Foreground="DarkGreen"/>
    </StackPanel>
  </ScrollViewer>
</UserControl>
