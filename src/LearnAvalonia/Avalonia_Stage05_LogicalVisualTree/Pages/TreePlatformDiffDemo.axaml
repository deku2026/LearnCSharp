<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="LearnAvalonia.Avalonia_Stage05_LogicalVisualTree.Pages.TreePlatformDiffDemo">
  <ScrollViewer Padding="8">
    <StackPanel Spacing="6" Margin="8">
      <TextBlock Text="§13 跨平台差异表" FontWeight="Bold" FontSize="14"/>
      <Border BorderBrush="Gray" BorderThickness="1" Padding="8" CornerRadius="4">
        <Grid ColumnDefinitions="1.2*,2.4*" RowDefinitions="Auto,Auto,Auto,Auto,Auto,Auto,Auto,Auto,Auto">
          <TextBlock Grid.Row="0" Grid.Column="0" Text="平台" FontWeight="SemiBold"/>
          <TextBlock Grid.Row="0" Grid.Column="1" Text="树 / TopLevel 注意" FontWeight="SemiBold"/>
          <TextBlock Grid.Row="1" Grid.Column="0" Text="🪟 桌面"/>
          <TextBlock Grid.Row="1" Grid.Column="1" Text="多 Window=多 TopLevel；Popup 出窗体边界" TextWrapping="Wrap"/>
          <TextBlock Grid.Row="2" Grid.Column="0" Text="🍎 macOS"/>
          <TextBlock Grid.Row="2" Grid.Column="1" Text="同桌面语义；原生菜单不在你的逻辑树" TextWrapping="Wrap"/>
          <TextBlock Grid.Row="3" Grid.Column="0" Text="🐧 Linux"/>
          <TextBlock Grid.Row="3" Grid.Column="1" Text="同；Wayland 窗口表面差异在后端" TextWrapping="Wrap"/>
          <TextBlock Grid.Row="4" Grid.Column="0" Text="📱 Android"/>
          <TextBlock Grid.Row="4" Grid.Column="1" Text="MainView 附着 Activity TopLevel；重建换树" TextWrapping="Wrap"/>
          <TextBlock Grid.Row="5" Grid.Column="0" Text="🍎 iOS"/>
          <TextBlock Grid.Row="5" Grid.Column="1" Text="SingleView；scene 管理 UIWindow" TextWrapping="Wrap"/>
          <TextBlock Grid.Row="6" Grid.Column="0" Text="🌍 Browser"/>
          <TextBlock Grid.Row="6" Grid.Column="1" Text="单视图表面；缩放/resize 改布局" TextWrapping="Wrap"/>
          <TextBlock Grid.Row="7" Grid.Column="0" Text="🔌 Embedded"/>
          <TextBlock Grid.Row="7" Grid.Column="1" Text="单一呈现表面常见" TextWrapping="Wrap"/>
          <TextBlock Grid.Row="8" Grid.Column="0" Text="全平台"/>
          <TextBlock Grid.Row="8" Grid.Column="1" Text="属性/树 API 相同；禁止盲转 TopLevel" TextWrapping="Wrap" Foreground="OrangeRed"/>
        </Grid>
      </Border>
      <TextBlock Text="验收：覆盖 8 类平台树注意" Foreground="DarkGreen"/>
    </StackPanel>
  </ScrollViewer>
</UserControl>
