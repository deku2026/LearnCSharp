<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="LearnAvalonia.Avalonia_Stage09_DataBindingMVVM.Pages.PlatformDeprecatedDemo">
  <ScrollViewer Padding="8">
    <StackPanel Spacing="6" Margin="8">
      <TextBlock Text="§J1-J3 平台差·过时·反模式" FontWeight="Bold" FontSize="14"/>
      <TextBlock Text="平台差：" FontWeight="SemiBold"/>
      <Border BorderBrush="Gray" BorderThickness="1" Padding="8" CornerRadius="4">
        <Grid ColumnDefinitions="Auto,*" RowDefinitions="Auto,Auto,Auto,Auto" RowSpacing="2" ColumnSpacing="8">
          <TextBlock Grid.Row="0" Grid.Column="0" Text="桌面多窗" FontWeight="SemiBold" Padding="4"/>
          <TextBlock Grid.Row="0" Grid.Column="1" Text="每窗 VM 实例；单例服务共享" TextWrapping="Wrap" Padding="4"/>
          <TextBlock Grid.Row="1" Grid.Column="0" Text="移动 Pages" FontWeight="SemiBold" Padding="4"/>
          <TextBlock Grid.Row="1" Grid.Column="1" Text="导航参数与 VM 生命周期绑定" TextWrapping="Wrap" Padding="4"/>
          <TextBlock Grid.Row="2" Grid.Column="0" Text="Browser" FontWeight="SemiBold" Padding="4"/>
          <TextBlock Grid.Row="2" Grid.Column="1" Text="单页；注意刷新丢状态" TextWrapping="Wrap" Padding="4"/>
          <TextBlock Grid.Row="3" Grid.Column="0" Text="线程" FontWeight="SemiBold" Padding="4"/>
          <TextBlock Grid.Row="3" Grid.Column="1" Text="仅 UI 线程碰 ObservableCollection" TextWrapping="Wrap" Padding="4"/>
        </Grid>
      </Border>
      <TextBlock Text="⚠️ 过时：" FontWeight="SemiBold" Foreground="OrangeRed"/>
      <Border BorderBrush="OrangeRed" BorderThickness="1" Padding="8" CornerRadius="4">
        <Grid ColumnDefinitions="*,*" RowDefinitions="Auto,Auto,Auto,Auto,Auto" RowSpacing="2" ColumnSpacing="4">
          <TextBlock Grid.Row="0" Grid.Column="0" Text="过时" FontWeight="SemiBold" Padding="4"/>
          <TextBlock Grid.Row="0" Grid.Column="1" Text="正确" FontWeight="SemiBold" Padding="4"/>
          <TextBlock Grid.Row="1" Grid.Column="0" Text="Avalonia.ReactiveUI 11.x" TextWrapping="Wrap" Padding="4"/>
          <TextBlock Grid.Row="1" Grid.Column="1" Text="ReactiveUI.Avalonia 12.0.x" TextWrapping="Wrap" Padding="4"/>
          <TextBlock Grid.Row="2" Grid.Column="0" Text="默认 ViewLocator 上 AOT" TextWrapping="Wrap" Padding="4"/>
          <TextBlock Grid.Row="2" Grid.Column="1" Text="-rvl + 显式映射" TextWrapping="Wrap" Padding="4"/>
          <TextBlock Grid.Row="3" Grid.Column="0" Text="反射绑定当默认主线" TextWrapping="Wrap" Padding="4"/>
          <TextBlock Grid.Row="3" Grid.Column="1" Text="compiled + x:DataType" TextWrapping="Wrap" Padding="4"/>
          <TextBlock Grid.Row="4" Grid.Column="0" Text="VM 里 Application.Current.MainWindow" TextWrapping="Wrap" Padding="4"/>
          <TextBlock Grid.Row="4" Grid.Column="1" Text="对话框服务" TextWrapping="Wrap" Padding="4"/>
        </Grid>
      </Border>
      <TextBlock Text="反模式：code-behind 写业务规则 · VM 引用 Button/Window · async void 命令 · 后台线程改 OC · Converter 访问数据库 · 混用 Toolkit 与 ReactiveUI 基类无规范 · 忽略 CanExecute · 用 FallbackValue 掩盖绑定错误上生产" TextWrapping="Wrap"/>
      <TextBlock Text="验收：禁止推荐 Avalonia.ReactiveUI 11.x" Foreground="DarkGreen"/>
    </StackPanel>
  </ScrollViewer>
</UserControl>
