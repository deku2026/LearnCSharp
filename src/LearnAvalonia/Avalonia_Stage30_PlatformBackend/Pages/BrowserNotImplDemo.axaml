<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="LearnAvalonia.Avalonia_Stage30_PlatformBackend.Pages.BrowserNotImplDemo">
  <ScrollViewer Padding="8">
    <StackPanel Spacing="6" Margin="8">
      <TextBlock Text="§9 Browser / WASM（非桌面 — 见 roadmap）" FontWeight="Bold" FontSize="14" Foreground="Gray"/>
      <TextBlock Text="状态：本应用为 WinExe 桌面主线，不在此 build/run WASM 入口。" TextWrapping="Wrap"/>
      <TextBlock Text="概念入口（Avalonia.Browser.dll）：" FontWeight="SemiBold"/>
      <TextBlock Text="• JSExport — main 入口"/>
      <TextBlock Text="• CanvasKit — Skia + WebGL"/>
      <TextBlock Text="• DOM 事件桥 — pointer/keyboard"/>
      <TextBlock Text="• SingleView lifetime — 一个 canvas 作为根"/>
      <TextBlock Text="⚠️ 见 roadmap，不在本桌面 Capstone 实现" TextWrapping="Wrap" Foreground="OrangeRed"/>
      <TextBlock Text="验收：见 roadmap，桌面策略不实现" Foreground="DarkGreen"/>
    </StackPanel>
  </ScrollViewer>
</UserControl>