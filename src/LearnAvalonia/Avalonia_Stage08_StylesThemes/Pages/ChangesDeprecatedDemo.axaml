<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="LearnAvalonia.Avalonia_Stage08_StylesThemes.Pages.ChangesDeprecatedDemo">
  <ScrollViewer Padding="8">
    <StackPanel Spacing="6" Margin="8">
      <TextBlock Text="§H1-H3 12 变化·过时·实验" FontWeight="Bold" FontSize="14"/>
      <TextBlock Text="🆕 12/12.1 相关：" FontWeight="SemiBold"/>
      <Border BorderBrush="Gray" BorderThickness="1" Padding="8" CornerRadius="4">
        <Grid ColumnDefinitions="Auto,*" RowDefinitions="Auto,Auto,Auto,Auto" RowSpacing="4" ColumnSpacing="8">
          <TextBlock Grid.Row="0" Grid.Column="0" Text="ControlTheme 主线" FontWeight="SemiBold" Padding="4"/>
          <TextBlock Grid.Row="0" Grid.Column="1" Text="现代 Avalonia 换肤主路径" TextWrapping="Wrap" Padding="4"/>
          <TextBlock Grid.Row="1" Grid.Column="0" Text="ThemeVariant" FontWeight="SemiBold" Padding="4"/>
          <TextBlock Grid.Row="1" Grid.Column="1" Text="系统浅深色集成成熟" TextWrapping="Wrap" Padding="4"/>
          <TextBlock Grid.Row="2" Grid.Column="0" Text="嵌套 Selector" FontWeight="SemiBold" Padding="4"/>
          <TextBlock Grid.Row="2" Grid.Column="1" Text="组件库可维护性" TextWrapping="Wrap" Padding="4"/>
          <TextBlock Grid.Row="3" Grid.Column="0" Text="不可见停动画" FontWeight="SemiBold" Padding="4"/>
          <TextBlock Grid.Row="3" Grid.Column="1" Text="性能与电量" TextWrapping="Wrap" Padding="4"/>
        </Grid>
      </Border>
      <TextBlock Text="⚠️ 过时心智：" FontWeight="SemiBold" Foreground="OrangeRed"/>
      <Border BorderBrush="OrangeRed" BorderThickness="1" Padding="8" CornerRadius="4">
        <Grid ColumnDefinitions="*,*" RowDefinitions="Auto,Auto,Auto,Auto,Auto" RowSpacing="2" ColumnSpacing="4">
          <TextBlock Grid.Row="0" Grid.Column="0" Text="过时" FontWeight="SemiBold" Padding="4"/>
          <TextBlock Grid.Row="0" Grid.Column="1" Text="现代" FontWeight="SemiBold" Padding="4"/>
          <TextBlock Grid.Row="1" Grid.Column="0" Text="纯 WPF Trigger 全盘照搬" TextWrapping="Wrap" Padding="4"/>
          <TextBlock Grid.Row="1" Grid.Column="1" Text="伪类 + Style + ControlTheme" TextWrapping="Wrap" Padding="4"/>
          <TextBlock Grid.Row="2" Grid.Column="0" Text="每页写死 Color=#xxx" TextWrapping="Wrap" Padding="4"/>
          <TextBlock Grid.Row="2" Grid.Column="1" Text="ThemeResource tokens" TextWrapping="Wrap" Padding="4"/>
          <TextBlock Grid.Row="3" Grid.Column="0" Text="继承控件只为改颜色" TextWrapping="Wrap" Padding="4"/>
          <TextBlock Grid.Row="3" Grid.Column="1" Text="Classes / Theme 变体" TextWrapping="Wrap" Padding="4"/>
          <TextBlock Grid.Row="4" Grid.Column="0" Text="深色模式复制整份页面" TextWrapping="Wrap" Padding="4"/>
          <TextBlock Grid.Row="4" Grid.Column="1" Text="ThemeDictionaries" TextWrapping="Wrap" Padding="4"/>
        </Grid>
      </Border>
      <TextBlock Text="验收：列出 12/12.1 关键变化" Foreground="DarkGreen"/>
    </StackPanel>
  </ScrollViewer>
</UserControl>
