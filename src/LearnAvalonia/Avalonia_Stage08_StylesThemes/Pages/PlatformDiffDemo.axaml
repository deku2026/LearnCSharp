<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="LearnAvalonia.Avalonia_Stage08_StylesThemes.Pages.PlatformDiffDemo">
  <ScrollViewer Padding="8">
    <StackPanel Spacing="6" Margin="8">
      <TextBlock Text="§I 平台差" FontWeight="Bold" FontSize="14"/>
      <Border BorderBrush="Gray" BorderThickness="1" Padding="8" CornerRadius="4">
        <Grid ColumnDefinitions="Auto,Auto,Auto,Auto" RowDefinitions="Auto,Auto,Auto,Auto,Auto" RowSpacing="2" ColumnSpacing="4">
          <TextBlock Grid.Row="0" Grid.Column="0" Text="主题" FontWeight="SemiBold" Padding="4"/>
          <TextBlock Grid.Row="0" Grid.Column="1" Text="桌面" FontWeight="SemiBold" Padding="4"/>
          <TextBlock Grid.Row="0" Grid.Column="2" Text="移动" FontWeight="SemiBold" Padding="4"/>
          <TextBlock Grid.Row="0" Grid.Column="3" Text="Browser" FontWeight="SemiBold" Padding="4"/>
          <TextBlock Grid.Row="1" Grid.Column="0" Text="跟随系统深浅色" TextWrapping="Wrap" Padding="4"/>
          <TextBlock Grid.Row="1" Grid.Column="1" Text="✅" Padding="4"/>
          <TextBlock Grid.Row="1" Grid.Column="2" Text="✅" Padding="4"/>
          <TextBlock Grid.Row="1" Grid.Column="3" Text="视宿主/浏览器" TextWrapping="Wrap" Padding="4"/>
          <TextBlock Grid.Row="2" Grid.Column="0" Text="亚像素字体" TextWrapping="Wrap" Padding="4"/>
          <TextBlock Grid.Row="2" Grid.Column="1" Text="OS 差异" TextWrapping="Wrap" Padding="4"/>
          <TextBlock Grid.Row="2" Grid.Column="2" Text="差异" TextWrapping="Wrap" Padding="4"/>
          <TextBlock Grid.Row="2" Grid.Column="3" Text="浏览器字体栈" TextWrapping="Wrap" Padding="4"/>
          <TextBlock Grid.Row="3" Grid.Column="0" Text="系统强调色" TextWrapping="Wrap" Padding="4"/>
          <TextBlock Grid.Row="3" Grid.Column="1" Text="可接" Padding="4"/>
          <TextBlock Grid.Row="3" Grid.Column="2" Text="可接" Padding="4"/>
          <TextBlock Grid.Row="3" Grid.Column="3" Text="有限" Padding="4"/>
          <TextBlock Grid.Row="4" Grid.Column="0" Text="高对比主题" TextWrapping="Wrap" Padding="4"/>
          <TextBlock Grid.Row="4" Grid.Column="1" Text="注意 a11y" TextWrapping="Wrap" Padding="4"/>
          <TextBlock Grid.Row="4" Grid.Column="2" Text="系统设置" TextWrapping="Wrap" Padding="4"/>
          <TextBlock Grid.Row="4" Grid.Column="3" Text="有限" Padding="4"/>
        </Grid>
      </Border>
      <TextBlock Text="Linux 各 DE 的系统主题信号可能不同——Default 变体以 Avalonia 平台实现为准，验收时在目标 DE 点一次" TextWrapping="Wrap"/>
      <TextBlock Text="验收：区分桌面/移动/Browser 主题能力" Foreground="DarkGreen"/>
    </StackPanel>
  </ScrollViewer>
</UserControl>
