<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="LearnAvalonia.Avalonia_Stage10_WindowsDialogs.Pages.Avalonia12ChangesDemo">
  <ScrollViewer Padding="8">
    <StackPanel Spacing="6" Margin="8">
      <TextBlock Text="§4 Avalonia 12 / 12.1 变化" FontWeight="Bold" FontSize="14"/>
      <Border BorderBrush="Gray" BorderThickness="1" Padding="8" CornerRadius="4">
        <Grid ColumnDefinitions="1.4*,2*" RowDefinitions="Auto,Auto,Auto,Auto,Auto,Auto,Auto">
          <TextBlock Grid.Row="0" Grid.Column="0" Text="主题" FontWeight="SemiBold"/>
          <TextBlock Grid.Row="0" Grid.Column="1" Text="变化" FontWeight="SemiBold"/>
          <TextBlock Grid.Row="1" Grid.Column="0" Text="装饰命名" TextWrapping="Wrap"/>
          <TextBlock Grid.Row="1" Grid.Column="1" Text="SystemDecorations → WindowDecorations" TextWrapping="Wrap"/>
          <TextBlock Grid.Row="2" Grid.Column="0" Text="客户端 Chrome" TextWrapping="Wrap"/>
          <TextBlock Grid.Row="2" Grid.Column="1" Text="WindowDrawnDecorations 取代旧 TitleBar/CaptionButtons/ChromeOverlay" TextWrapping="Wrap"/>
          <TextBlock Grid.Row="3" Grid.Column="0" Text="WindowState" TextWrapping="Wrap"/>
          <TextBlock Grid.Row="3" Grid.Column="1" Text="改为 DirectProperty，不能靠 Style Setter" TextWrapping="Wrap"/>
          <TextBlock Grid.Row="4" Grid.Column="0" Text="文件对话框" TextWrapping="Wrap"/>
          <TextBlock Grid.Row="4" Grid.Column="1" Text="统一 StorageProvider；旧 FileDialog API 移除" TextWrapping="Wrap"/>
          <TextBlock Grid.Row="5" Grid.Column="0" Text="主题化装饰" TextWrapping="Wrap"/>
          <TextBlock Grid.Row="5" Grid.Column="1" Text="与 12 主题/移动 Pages 装饰体系对齐" TextWrapping="Wrap"/>
          <TextBlock Grid.Row="6" Grid.Column="0" Text="托盘" TextWrapping="Wrap"/>
          <TextBlock Grid.Row="6" Grid.Column="1" Text="文档继续强调 NativeMenu only" TextWrapping="Wrap"/>
        </Grid>
      </Border>
      <TextBlock Text="12.1 平台细节：Win11 圆角等窗口细节、渲染/平台修复；读 12.1 release notes 核对本机现象。" TextWrapping="Wrap"/>
      <TextBlock Text="验收：WindowDecorations / WindowState Direct" Foreground="DarkGreen"/>
    </StackPanel>
  </ScrollViewer>
</UserControl>
