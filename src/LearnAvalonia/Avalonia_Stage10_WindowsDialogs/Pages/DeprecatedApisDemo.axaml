<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="LearnAvalonia.Avalonia_Stage10_WindowsDialogs.Pages.DeprecatedApisDemo">
  <ScrollViewer Padding="8">
    <StackPanel Spacing="6" Margin="8">
      <TextBlock Text="§5 过时与禁止" FontWeight="Bold" FontSize="14"/>
      <Border BorderBrush="Gray" BorderThickness="1" Padding="8" CornerRadius="4">
        <Grid ColumnDefinitions="1.4*,2*" RowDefinitions="Auto,Auto,Auto,Auto,Auto,Auto,Auto,Auto,Auto,Auto">
          <TextBlock Grid.Row="0" Grid.Column="0" Text="禁止项" FontWeight="SemiBold"/>
          <TextBlock Grid.Row="0" Grid.Column="1" Text="原因 / 替代" FontWeight="SemiBold"/>
          <TextBlock Grid.Row="1" Grid.Column="0" Text="SystemDecorations 新代码" TextWrapping="Wrap"/>
          <TextBlock Grid.Row="1" Grid.Column="1" Text="改 WindowDecorations" TextWrapping="Wrap"/>
          <TextBlock Grid.Row="2" Grid.Column="0" Text="旧 ExtendClientAreaChromeHints 抄 11 博客" TextWrapping="Wrap"/>
          <TextBlock Grid.Row="2" Grid.Column="1" Text="按 12 decorations 文档重写" TextWrapping="Wrap"/>
          <TextBlock Grid.Row="3" Grid.Column="0" Text="OpenFileDialog/SaveFileDialog/OpenFolderDialog" TextWrapping="Wrap"/>
          <TextBlock Grid.Row="3" Grid.Column="1" Text="StorageProvider" TextWrapping="Wrap"/>
          <TextBlock Grid.Row="4" Grid.Column="0" Text="Tray 使用 Menu/MenuItem" TextWrapping="Wrap"/>
          <TextBlock Grid.Row="4" Grid.Column="1" Text="必须 NativeMenu" TextWrapping="Wrap"/>
          <TextBlock Grid.Row="5" Grid.Column="0" Text="Style 设置 WindowState" TextWrapping="Wrap"/>
          <TextBlock Grid.Row="5" Grid.Column="1" Text="DirectProperty → 代码设置" TextWrapping="Wrap"/>
          <TextBlock Grid.Row="6" Grid.Column="0" Text="VM 直接 new Window 强耦合" TextWrapping="Wrap"/>
          <TextBlock Grid.Row="6" Grid.Column="1" Text="IDialogService / IWindowService" TextWrapping="Wrap"/>
          <TextBlock Grid.Row="7" Grid.Column="0" Text="ShowDialog(...).Result" TextWrapping="Wrap"/>
          <TextBlock Grid.Row="7" Grid.Column="1" Text="async/await" TextWrapping="Wrap"/>
          <TextBlock Grid.Row="8" Grid.Column="0" Text="假设 Browser 有完整 Tray/多窗" TextWrapping="Wrap"/>
          <TextBlock Grid.Row="8" Grid.Column="1" Text="平台边界降级" TextWrapping="Wrap"/>
          <TextBlock Grid.Row="9" Grid.Column="0" Text="关闭事件无取消策略强制 Close" TextWrapping="Wrap"/>
          <TextBlock Grid.Row="9" Grid.Column="1" Text="Closing 守卫 + 脏标记" TextWrapping="Wrap"/>
        </Grid>
      </Border>
      <TextBlock Text="验收：禁止 SystemDecorations / 旧 FileDialog / Menu 托盘" Foreground="DarkGreen"/>
    </StackPanel>
  </ScrollViewer>
</UserControl>
