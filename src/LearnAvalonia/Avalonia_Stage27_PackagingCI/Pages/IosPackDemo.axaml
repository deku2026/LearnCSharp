<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="LearnAvalonia.Avalonia_Stage27_PackagingCI.Pages.IosPackDemo">
  <ScrollViewer Padding="8">
    <StackPanel Spacing="6" Margin="8">
      <TextBlock Text="§5 iOS / iPadOS" FontWeight="Bold" FontSize="14"/>
      <TextBlock Text="准备（必须 macOS 主机）" FontWeight="SemiBold"/>
      <Border Background="#1E1E1E" Padding="8" CornerRadius="4">
        <TextBlock Text="dotnet workload install ios&#x0a;dotnet publish -c Release -f net10.0-ios -r iossimulator-x64" Foreground="#D4D4D4" FontFamily="Consolas,Monaco,monospace" TextWrapping="Wrap"/>
      </Border>
      <TextBlock Text="签名" FontWeight="SemiBold"/>
      <Grid ColumnDefinitions="Auto,*" RowDefinitions="Auto,Auto,Auto" RowSpacing="3" ColumnSpacing="8">
        <TextBlock Grid.Row="0" Grid.Column="0" Text="Development" FontWeight="SemiBold" Padding="4"/>
        <TextBlock Grid.Row="0" Grid.Column="1" Text="本地调试" TextWrapping="Wrap" Padding="4"/>
        <TextBlock Grid.Row="1" Grid.Column="0" Text="Distribution" FontWeight="SemiBold" Padding="4"/>
        <TextBlock Grid.Row="1" Grid.Column="1" Text="App Store / Ad Hoc" TextWrapping="Wrap" Padding="4"/>
        <TextBlock Grid.Row="2" Grid.Column="0" Text="Provisioning" FontWeight="SemiBold" Padding="4"/>
        <TextBlock Grid.Row="2" Grid.Column="1" Text="ProvisioningProfile + Entitlements.plist" TextWrapping="Wrap" Padding="4"/>
      </Grid>
      <TextBlock Text="TestFlight" FontWeight="SemiBold"/>
      <Border Background="#1E1E1E" Padding="8" CornerRadius="4">
        <TextBlock Text="xcrun altool --upload-app -f MyApp.ipa &#x0a;  --type ios --apiKey XX --apiIssuer XX&#x0a;# 或 xcodebuild -exportArchive -exportOptionsPlist ExportOptions.plist" Foreground="#D4D4D4" FontFamily="Consolas,Monaco,monospace" TextWrapping="Wrap"/>
      </Border>
      <TextBlock Text="验收：IPA + 签名 + TestFlight" Foreground="DarkGreen"/>
    </StackPanel>
  </ScrollViewer>
</UserControl>
