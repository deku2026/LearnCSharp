<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="LearnAvalonia.Avalonia_Stage27_PackagingCI.Pages.AndroidPackDemo">
  <ScrollViewer Padding="8">
    <StackPanel Spacing="6" Margin="8">
      <TextBlock Text="§4 Android" FontWeight="Bold" FontSize="14"/>
      <TextBlock Text="准备" FontWeight="SemiBold"/>
      <Border Background="#1E1E1E" Padding="8" CornerRadius="4">
        <TextBlock Text="dotnet workload install android&#x0a;dotnet publish -c Release -f net10.0-android" Foreground="#D4D4D4" FontFamily="Consolas,Monaco,monospace" TextWrapping="Wrap"/>
      </Border>
      <TextBlock Text="产物" FontWeight="SemiBold"/>
      <Grid ColumnDefinitions="Auto,*" RowDefinitions="Auto,Auto" RowSpacing="3" ColumnSpacing="8">
        <TextBlock Grid.Row="0" Grid.Column="0" Text="AAB" FontWeight="SemiBold" Padding="4"/>
        <TextBlock Grid.Row="0" Grid.Column="1" Text="Play 商店上传；动态分发按 ABI" TextWrapping="Wrap" Padding="4"/>
        <TextBlock Grid.Row="1" Grid.Column="0" Text="APK" FontWeight="SemiBold" Padding="4"/>
        <TextBlock Grid.Row="1" Grid.Column="1" Text="自分发；含全部 ABI" TextWrapping="Wrap" Padding="4"/>
      </Grid>
      <TextBlock Text="签名" FontWeight="SemiBold"/>
      <Border Background="#1E1E1E" Padding="8" CornerRadius="4">
        <TextBlock Text="keytool -genkey -v -keystore release.keystore -alias mykey -keyalg RSA -keysize 2048 -validity 10000&#x0a;# csproj：&lt;AndroidKeyStore&gt;True&lt;/AndroidKeyStore&gt;&#x0a;# &lt;AndroidSigningKeyStore&gt;release.keystore&lt;/AndroidSigningKeyStore&gt;" Foreground="#D4D4D4" FontFamily="Consolas,Monaco,monospace" TextWrapping="Wrap"/>
      </Border>
      <TextBlock Text="验收：AAB/APK + 签名" Foreground="DarkGreen"/>
    </StackPanel>
  </ScrollViewer>
</UserControl>