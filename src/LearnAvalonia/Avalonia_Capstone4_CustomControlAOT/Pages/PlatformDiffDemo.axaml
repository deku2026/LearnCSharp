<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="LearnAvalonia.Avalonia_Capstone4_CustomControlAOT.Pages.PlatformDiffDemo">
  <ScrollViewer Padding="8">
    <StackPanel Spacing="6" Margin="8">
      <TextBlock Text="§15 平台表 + 12.1 变更" FontWeight="Bold" FontSize="14"/>
      <TextBlock Text="GaugeControl 跨平台检查项：" FontWeight="SemiBold"/>
      <Border BorderBrush="Gray" BorderThickness="1" Padding="8" CornerRadius="4">
        <Grid ColumnDefinitions="120,80,80,200" RowDefinitions="Auto,Auto,Auto,Auto,Auto,Auto">
          <TextBlock Grid.Row="0" Grid.Column="0" Text="平台" FontWeight="SemiBold"/>
          <TextBlock Grid.Row="0" Grid.Column="1" Text="Render" FontWeight="SemiBold"/>
          <TextBlock Grid.Row="0" Grid.Column="2" Text="a11y" FontWeight="SemiBold"/>
          <TextBlock Grid.Row="0" Grid.Column="3" Text="备注" FontWeight="SemiBold"/>
          <TextBlock Grid.Row="1" Grid.Column="0" Text="Windows"/>
          <TextBlock Grid.Row="1" Grid.Column="1" Text="✅"/>
          <TextBlock Grid.Row="1" Grid.Column="2" Text="✅ UIA"/>
          <TextBlock Grid.Row="1" Grid.Column="3" Text="Vulkan/Software"/>
          <TextBlock Grid.Row="2" Grid.Column="0" Text="macOS"/>
          <TextBlock Grid.Row="2" Grid.Column="1" Text="✅"/>
          <TextBlock Grid.Row="2" Grid.Column="2" Text="✅ AX"/>
          <TextBlock Grid.Row="2" Grid.Column="3" Text="Metal"/>
          <TextBlock Grid.Row="3" Grid.Column="0" Text="Linux X11"/>
          <TextBlock Grid.Row="3" Grid.Column="1" Text="✅"/>
          <TextBlock Grid.Row="3" Grid.Column="2" Text="✅ AT-SPI"/>
          <TextBlock Grid.Row="3" Grid.Column="3" Text="GLX/Software"/>
          <TextBlock Grid.Row="4" Grid.Column="0" Text="Headless"/>
          <TextBlock Grid.Row="4" Grid.Column="1" Text="✅"/>
          <TextBlock Grid.Row="4" Grid.Column="2" Text="—"/>
          <TextBlock Grid.Row="4" Grid.Column="3" Text="测试"/>
          <TextBlock Grid.Row="5" Grid.Column="0" Text="Browser"/>
          <TextBlock Grid.Row="5" Grid.Column="1" Text="✅"/>
          <TextBlock Grid.Row="5" Grid.Column="2" Text="✅ ARIA"/>
          <TextBlock Grid.Row="5" Grid.Column="3" Text="CanvasKit（非桌面 Capstone 不 build）"/>
        </Grid>
      </Border>
      <TextBlock Text="Avalonia 12.1 关键变化：" FontWeight="SemiBold"/>
      <TextBlock Text="• CompiledBinding 默认开（需 x:DataType）"/>
      <TextBlock Text="• Direct2D1 移除 — 全 Skia"/>
      <TextBlock Text="• StackPanel.Spacing（非 Gap）"/>
      <TextBlock Text="• Wayland 实验性 🧪"/>
      <TextBlock Text="• Annotations 默认关 — ReactiveUI 用 ReactiveUI.Avalonia 12.0.3"/>
      <TextBlock Text="验收：勾选平台表与 12.1 变更" Foreground="DarkGreen"/>
    </StackPanel>
  </ScrollViewer>
</UserControl>
