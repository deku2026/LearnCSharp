<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="LearnAvalonia.Avalonia_Stage01_AppBuilder.Pages.IosEntryDemo">
  <ScrollViewer Padding="8">
    <StackPanel Spacing="6" Margin="8">
      <TextBlock Text="§8 iOS scene-based 注意点" FontWeight="Bold" FontSize="14"/>
      <TextBlock Text="Avalonia 12 对齐 UIKit scene 生命周期（Apple 将强制方向）：" TextWrapping="Wrap"/>
      <Border BorderBrush="Gray" BorderThickness="1" Padding="8" CornerRadius="4">
        <StackPanel Spacing="3">
          <TextBlock Text="• 多数应用无需改业务代码即可运行" TextWrapping="Wrap"/>
          <TextBlock Text="• AvaloniaAppDelegate.Window 在初始化后可能一直为 null —— 窗口由 scene delegate 内部管理" TextWrapping="Wrap"/>
          <TextBlock Text="• 若必须拿 UIWindow，在视图附着时处理（覆盖 AvaloniaView.MovedToWindow），不要依赖 AppDelegate.Window" TextWrapping="Wrap"/>
        </StackPanel>
      </Border>
      <Border Background="#1E1E1E" Padding="8" CornerRadius="4">
        <TextBlock Foreground="#D4D4D4" FontFamily="Consolas,Monaco,monospace" TextWrapping="Wrap"
                   Text="if (ApplicationLifetime is ISingleViewApplicationLifetime single)&#10;    single.MainView = new MainView();"/>
      </Border>
      <TextBlock Text="验收：说明 AppDelegate.Window 可能 null" Foreground="DarkGreen"/>
    </StackPanel>
  </ScrollViewer>
</UserControl>
