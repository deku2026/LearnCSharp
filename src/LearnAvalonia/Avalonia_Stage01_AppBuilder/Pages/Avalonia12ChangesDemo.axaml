<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="LearnAvalonia.Avalonia_Stage01_AppBuilder.Pages.Avalonia12ChangesDemo">
  <ScrollViewer Padding="8">
    <StackPanel Spacing="6" Margin="8">
      <TextBlock Text="§12 Avalonia 12 / 12.1 最新变化" FontWeight="Bold" FontSize="14"/>
      <Border BorderBrush="Gray" BorderThickness="1" Padding="8" CornerRadius="4">
        <StackPanel Spacing="3">
          <TextBlock Text="• Android AvaloniaAndroidApplication&lt;TApp&gt; —— Application 级初始化；Activity 非泛型" TextWrapping="Wrap"/>
          <TextBlock Text="• 移除 Activity CreateAppBuilder/CustomizeAppBuilder —— 初始化路径单一化" TextWrapping="Wrap"/>
          <TextBlock Text="• IActivityApplicationLifetime —— Android 不再用 SingleView 单实例 MainView" TextWrapping="Wrap"/>
          <TextBlock Text="• iOS scene-based —— AvaloniaAppDelegate.Window 可能 null" TextWrapping="Wrap"/>
          <TextBlock Text="• Direct2D1 删除 —— 全平台 Skia" TextWrapping="Wrap"/>
          <TextBlock Text="• 可配置 text shaper —— 自定义 Skia 必须 UseHarfBuzz" TextWrapping="Wrap"/>
          <TextBlock Text="• 12.1 Wayland 实验后端 —— 显式包 + UseWayland()" TextWrapping="Wrap"/>
          <TextBlock Text="• TopLevel 不再保证视觉树根 —— 用 GetTopLevel（阶段 5）" TextWrapping="Wrap"/>
          <TextBlock Text="• 默认 .NET 10 / 移动仅 net10 —— 与模板对齐" TextWrapping="Wrap"/>
        </StackPanel>
      </Border>
      <TextBlock Text="验收：列出 12/12.1 关键变化" Foreground="DarkGreen"/>
    </StackPanel>
  </ScrollViewer>
</UserControl>
