<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="LearnAvalonia.Avalonia_Stage01_AppBuilder.Pages.ManualLifetimeDemo">
  <ScrollViewer Padding="8">
    <StackPanel Spacing="6" Margin="8">
      <TextBlock Text="§6 手动 lifetime：Start + app.Run" FontWeight="Bold" FontSize="14"/>
      <TextBlock Text="当平台允许且你需要完全控制主循环时：" TextWrapping="Wrap"/>
      <Border Background="#1E1E1E" Padding="8" CornerRadius="4">
        <TextBlock Foreground="#D4D4D4" FontFamily="Consolas,Monaco,monospace" TextWrapping="Wrap"
                   Text="[STAThread]&#10;public static int Main(string[] args)&#10;    => BuildAvaloniaApp().Start(AppMain, args);&#10;&#10;private static void AppMain(Application app, string[] args)&#10;{&#10;    var cts = new CancellationTokenSource();&#10;    var window = new Window { Title = &quot;Manual&quot;, Width = 800, Height = 450 };&#10;    window.Closed += (_, _) => cts.Cancel();&#10;    window.Show();&#10;    app.Run(cts.Token);&#10;}"/>
      </Border>
      <TextBlock Text="要点：" FontWeight="SemiBold"/>
      <TextBlock Text="• Start(AppMain, args)：框架初始化完成后进入 AppMain" TextWrapping="Wrap"/>
      <TextBlock Text="• 你负责 Show 窗口并决定何时 Cancel token" TextWrapping="Wrap"/>
      <TextBlock Text="• app.Run(token) 驱动消息循环直到取消" TextWrapping="Wrap"/>
      <TextBlock Text="• 可移植性差于 StartWithClassicDesktopLifetime —— 桌面特殊场景再用" TextWrapping="Wrap" Foreground="OrangeRed"/>
      <TextBlock Text="验收：写通过 Start+Run 的桌面最小程序" Foreground="DarkGreen"/>
    </StackPanel>
  </ScrollViewer>
</UserControl>
