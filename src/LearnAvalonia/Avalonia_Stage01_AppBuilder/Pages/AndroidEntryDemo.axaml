<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="LearnAvalonia.Avalonia_Stage01_AppBuilder.Pages.AndroidEntryDemo">
  <ScrollViewer Padding="8">
    <StackPanel Spacing="6" Margin="8">
      <TextBlock Text="§7 Android 12 入口模型" FontWeight="Bold" FontSize="14"/>
      <TextBlock Text="正确结构：" FontWeight="SemiBold"/>
      <Border Background="#1E1E1E" Padding="8" CornerRadius="4">
        <TextBlock Foreground="#D4D4D4" FontFamily="Consolas,Monaco,monospace" TextWrapping="Wrap"
                   Text="[Application]&#10;public class AndroidApp : AvaloniaAndroidApplication&lt;App&gt;&#10;{&#10;    public AndroidApp(IntPtr java, JniHandleOwnership o) : base(java, o) { }&#10;}&#10;&#10;[Activity(Label = &quot;Demo&quot;, MainLauncher = true, ...)]&#10;public class MainActivity : AvaloniaMainActivity { }  // 非泛型"/>
      </Border>
      <TextBlock Text="禁止与迁移：" FontWeight="SemiBold"/>
      <Border BorderBrush="Gray" BorderThickness="1" Padding="8" CornerRadius="4">
        <StackPanel Spacing="3">
          <TextBlock Text="❌ AvaloniaMainActivity&lt;App&gt;  →  ✅ 非泛型 AvaloniaMainActivity" TextWrapping="Wrap"/>
          <TextBlock Text="❌ Activity 上 CreateAppBuilder  →  ✅ 已移除，迁到 AvaloniaAndroidApplication&lt;TApp&gt;" TextWrapping="Wrap"/>
          <TextBlock Text="❌ Activity 上 CustomizeAppBuilder  →  ✅ 已移除" TextWrapping="Wrap"/>
          <TextBlock Text="❌ 仅设 ISingleView.MainView  →  ✅ 用 IActivityApplicationLifetime.MainViewFactory" TextWrapping="Wrap"/>
        </StackPanel>
      </Border>
      <TextBlock Text="为何 Factory 不能换成字段：Activity 销毁重建时旧视图的 native 附着、焦点、输入连接都已失效，复用会踩生命周期地雷" TextWrapping="Wrap" Foreground="OrangeRed"/>
      <TextBlock Text="验收：列出 Android 12 正确类型与已删除 API" Foreground="DarkGreen"/>
    </StackPanel>
  </ScrollViewer>
</UserControl>
