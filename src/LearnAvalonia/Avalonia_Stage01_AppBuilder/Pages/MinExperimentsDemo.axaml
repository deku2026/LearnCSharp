<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="LearnAvalonia.Avalonia_Stage01_AppBuilder.Pages.MinExperimentsDemo">
  <ScrollViewer Padding="8">
    <StackPanel Spacing="6" Margin="8">
      <TextBlock Text="§14 最小实验 A-E" FontWeight="Bold" FontSize="14"/>
      <Border BorderBrush="Gray" BorderThickness="1" Padding="8" CornerRadius="4">
        <StackPanel Spacing="6">
          <TextBlock Text="实验 A · 手写桌面最小启动" FontWeight="SemiBold"/>
          <TextBlock Text="删掉模板注释，只保留 BuildAvaloniaApp + StartWithClassicDesktopLifetime；打印 ApplicationLifetime?.GetType().Name；验收：运行看到窗口、设计时预览不崩溃" TextWrapping="Wrap"/>
          <TextBlock Text="实验 B · ShutdownMode" FontWeight="SemiBold"/>
          <TextBlock Text="打开第二窗口，分别设 OnLastWindowClose/OnMainWindowClose/OnExplicitShutdown；观察关主/子窗进程是否退出（见 §5 demo）" TextWrapping="Wrap"/>
          <TextBlock Text="实验 C · 手动 lifetime" FontWeight="SemiBold"/>
          <TextBlock Text="改用 Start(AppMain,args) + app.Run(cts.Token)；窗口 Closed 时 Cancel；验收：行为与经典 lifetime 等价可关" TextWrapping="Wrap"/>
          <TextBlock Text="实验 D · 模拟 lifetime 分支" FontWeight="SemiBold"/>
          <TextBlock Text="共享 App 中保留三分支顺序；若有 Android 头项目验证 Factory 被调用；验收：桌面走 Desktop，Android 日志显示每次 Activity 新 View" TextWrapping="Wrap"/>
          <TextBlock Text="实验 E · 故意漏 HarfBuzz" FontWeight="SemiBold"/>
          <TextBlock Text="临时 .UseSkia() 且去掉 HarfBuzz；记录异常；补上 .UseHarfBuzz() 与包引用；验收：理解自定义渲染配置检查清单" TextWrapping="Wrap"/>
        </StackPanel>
      </Border>
      <TextBlock Text="验收：完成 5 个最小实验" Foreground="DarkGreen"/>
    </StackPanel>
  </ScrollViewer>
</UserControl>
