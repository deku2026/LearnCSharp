<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="LearnAvalonia.Avalonia_Stage13_GraphicsAnimation.Pages.BitmapDemo">
  <ScrollViewer Padding="8">
    <StackPanel Spacing="6" Margin="8">
      <TextBlock Text="§2.4 位图" FontWeight="Bold" FontSize="14"/>
      <Border Background="#1E1E1E" Padding="8" CornerRadius="4">
        <TextBlock Text="// 从 avares 加载&#10;await using var s = AssetLoader.Open(&#10;    new Uri(&quot;avares://MyApp/Assets/photo.png&quot;));&#10;var bitmap = new Bitmap(s);&#10;&#10;var image = new Image { Source = bitmap, Stretch = Stretch.Uniform };&#10;&#10;// RenderTargetBitmap 将 Visual 栅格化&#10;var rtb = new RenderTargetBitmap(&#10;    new PixelSize(200, 100), new Vector(96, 96));&#10;rtb.Render(visual);" Foreground="#D4D4D4" FontFamily="Consolas,Monaco,monospace" TextWrapping="Wrap"/>
      </Border>
      <Border BorderBrush="Gray" BorderThickness="1" Padding="8" CornerRadius="4">
        <Grid ColumnDefinitions="1.2*,2*" RowDefinitions="Auto,Auto,Auto,Auto">
          <TextBlock Grid.Row="0" Grid.Column="0" Text="主题" FontWeight="SemiBold"/>
          <TextBlock Grid.Row="0" Grid.Column="1" Text="说明" FontWeight="SemiBold"/>
          <TextBlock Grid.Row="1" Grid.Column="0" Text="DPI" TextWrapping="Wrap"/>
          <TextBlock Grid.Row="1" Grid.Column="1" Text="Bitmap 与目标缩放；避免模糊/过锐" TextWrapping="Wrap"/>
          <TextBlock Grid.Row="2" Grid.Column="0" Text="释放" TextWrapping="Wrap"/>
          <TextBlock Grid.Row="2" Grid.Column="1" Text="大图及时 Dispose；缓存策略" TextWrapping="Wrap"/>
          <TextBlock Grid.Row="3" Grid.Column="0" Text="解码" TextWrapping="Wrap"/>
          <TextBlock Grid.Row="3" Grid.Column="1" Text="后台解码再 UI 线程赋值 Source" TextWrapping="Wrap"/>
        </Grid>
      </Border>
      <TextBlock Text="验收：Bitmap/RenderTargetBitmap/Image" Foreground="DarkGreen"/>
    </StackPanel>
  </ScrollViewer>
</UserControl>
