<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="LearnAvalonia.Avalonia_Stage13_GraphicsAnimation.Pages.DeprecatedApisDemo">
  <ScrollViewer Padding="8">
    <StackPanel Spacing="6" Margin="8">
      <TextBlock Text="§5 过时与禁止" FontWeight="Bold" FontSize="14"/>
      <Border BorderBrush="Gray" BorderThickness="1" Padding="8" CornerRadius="4">
        <Grid ColumnDefinitions="1.8*,1.4*" RowDefinitions="Auto,Auto,Auto,Auto,Auto,Auto,Auto">
          <TextBlock Grid.Row="0" Grid.Column="0" Text="禁止" FontWeight="SemiBold"/>
          <TextBlock Grid.Row="0" Grid.Column="1" Text="替代" FontWeight="SemiBold"/>
          <TextBlock Grid.Row="1" Grid.Column="0" Text="未核验就把 Avalonia.Svg.Skia 11 包硬上 12" TextWrapping="Wrap"/>
          <TextBlock Grid.Row="1" Grid.Column="1" Text="查 12 兼容包" TextWrapping="Wrap"/>
          <TextBlock Grid.Row="2" Grid.Column="0" Text="Render 内每帧 new Pen/new SolidColorBrush" TextWrapping="Wrap"/>
          <TextBlock Grid.Row="2" Grid.Column="1" Text="缓存字段" TextWrapping="Wrap"/>
          <TextBlock Grid.Row="3" Grid.Column="0" Text="不可见仍 Infinite 动画不治理" TextWrapping="Wrap"/>
          <TextBlock Grid.Row="3" Grid.Column="1" Text="PlaybackBehavior + 取消 Classes" TextWrapping="Wrap"/>
          <TextBlock Grid.Row="4" Grid.Column="0" Text="用布局动画做 60fps 旋转" TextWrapping="Wrap"/>
          <TextBlock Grid.Row="4" Grid.Column="1" Text="RenderTransform" TextWrapping="Wrap"/>
          <TextBlock Grid.Row="5" Grid.Column="0" Text="列表每项 DropShadow" TextWrapping="Wrap"/>
          <TextBlock Grid.Row="5" Grid.Column="1" Text="分层/合并/减少" TextWrapping="Wrap"/>
          <TextBlock Grid.Row="6" Grid.Column="0" Text="DirectProperty 上指望 Style 动画" TextWrapping="Wrap"/>
          <TextBlock Grid.Row="6" Grid.Column="1" Text="换 Styled 或代码动画" TextWrapping="Wrap"/>
        </Grid>
      </Border>
      <TextBlock Text="自写文本 BiDi 而不测 HarfBuzz → 用框架文本栈。" TextWrapping="Wrap" Foreground="OrangeRed"/>
      <TextBlock Text="验收：禁 Render 每帧 new/Infinite 不治理" Foreground="DarkGreen"/>
    </StackPanel>
  </ScrollViewer>
</UserControl>
