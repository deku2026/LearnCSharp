<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="LearnAvalonia.Avalonia_Stage13_GraphicsAnimation.Pages.TransitionsDemo">
  <UserControl.Styles>
    <Style Selector="Border.hov">
      <Setter Property="Background" Value="DodgerBlue"/>
      <Style.Animations>
        <Animation Duration="0:0:0.2">
          <KeyFrame Cue="0%">
            <Setter Property="Width" Value="100"/>
          </KeyFrame>
          <KeyFrame Cue="100%">
            <Setter Property="Width" Value="160"/>
          </KeyFrame>
        </Animation>
      </Style.Animations>
    </Style>
  </UserControl.Styles>
  <ScrollViewer Padding="8">
    <StackPanel Spacing="6" Margin="8">
      <TextBlock Text="§2.10 Transitions" FontWeight="Bold" FontSize="14"/>
      <Border Background="#1E1E1E" Padding="8" CornerRadius="4">
        <TextBlock Text="&lt;Button&gt;&#10;  &lt;Button.Transitions&gt;&#10;    &lt;Transitions&gt;&#10;      &lt;TransformOperationsTransition Property=&quot;RenderTransform&quot; Duration=&quot;0:0:0.2&quot;/&gt;&#10;      &lt;BrushTransition Property=&quot;Background&quot; Duration=&quot;0:0:0.15&quot;/&gt;&#10;      &lt;DoubleTransition Property=&quot;Opacity&quot; Duration=&quot;0:0:0.15&quot;/&gt;&#10;    &lt;/Transitions&gt;&#10;  &lt;/Button.Transitions&gt;&#10;&lt;/Button&gt;" Foreground="#D4D4D4" FontFamily="Consolas,Monaco,monospace" TextWrapping="Wrap"/>
      </Border>
      <TextBlock Text="Transitions 响应属性变化（样式伪类、绑定变更）自动插值，适合 hover/focus 反馈。" TextWrapping="Wrap"/>
      <TextBlock Text="类型：TransformOperationsTransition / BrushTransition / DoubleTransition 等。" TextWrapping="Wrap"/>
      <TextBlock Text="验收：TransformOperations/Brush/Double" Foreground="DarkGreen"/>
    </StackPanel>
  </ScrollViewer>
</UserControl>
