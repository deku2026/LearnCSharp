<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="LearnAvalonia.Avalonia_Stage13_GraphicsAnimation.Pages.BrushDemo">
  <ScrollViewer Padding="8">
    <StackPanel Spacing="6" Margin="8">
      <TextBlock Text="§2.1 Brush 族" FontWeight="Bold" FontSize="14"/>
      <Border BorderBrush="Gray" BorderThickness="1" Padding="8" CornerRadius="4">
        <Grid ColumnDefinitions="1.4*,2*" RowDefinitions="Auto,Auto,Auto,Auto,Auto,Auto,Auto">
          <TextBlock Grid.Row="0" Grid.Column="0" Text="类型" FontWeight="SemiBold"/>
          <TextBlock Grid.Row="0" Grid.Column="1" Text="用途" FontWeight="SemiBold"/>
          <TextBlock Grid.Row="1" Grid.Column="0" Text="SolidColorBrush" TextWrapping="Wrap"/>
          <TextBlock Grid.Row="1" Grid.Column="1" Text="纯色" TextWrapping="Wrap"/>
          <TextBlock Grid.Row="2" Grid.Column="0" Text="LinearGradientBrush" TextWrapping="Wrap"/>
          <TextBlock Grid.Row="2" Grid.Column="1" Text="线性渐变" TextWrapping="Wrap"/>
          <TextBlock Grid.Row="3" Grid.Column="0" Text="RadialGradientBrush" TextWrapping="Wrap"/>
          <TextBlock Grid.Row="3" Grid.Column="1" Text="径向渐变" TextWrapping="Wrap"/>
          <TextBlock Grid.Row="4" Grid.Column="0" Text="ConicGradientBrush" TextWrapping="Wrap"/>
          <TextBlock Grid.Row="4" Grid.Column="1" Text="锥形（若版本提供）" TextWrapping="Wrap"/>
          <TextBlock Grid.Row="5" Grid.Column="0" Text="ImageBrush" TextWrapping="Wrap"/>
          <TextBlock Grid.Row="5" Grid.Column="1" Text="图像填充" TextWrapping="Wrap"/>
          <TextBlock Grid.Row="6" Grid.Column="0" Text="VisualBrush" TextWrapping="Wrap"/>
          <TextBlock Grid.Row="6" Grid.Column="1" Text="以 Visual 为源（慎用性能）" TextWrapping="Wrap"/>
        </Grid>
      </Border>
      <TextBlock Text="线性渐变示例：" FontWeight="SemiBold"/>
      <Border Width="240" Height="80" CornerRadius="6">
        <Border.Background>
          <LinearGradientBrush StartPoint="0%,0%" EndPoint="100%,100%">
            <GradientStop Offset="0" Color="#FF2563EB"/>
            <GradientStop Offset="1" Color="#FF7C3AED"/>
          </LinearGradientBrush>
        </Border.Background>
      </Border>
      <TextBlock Text="冻结/共享：静态资源中的画刷可多控件共享；运行时修改共享画刷影响所有使用者——主题切换优先换资源引用。" TextWrapping="Wrap"/>
      <TextBlock Text="验收：Solid/Linear/Radial/Image/Visual" Foreground="DarkGreen"/>
    </StackPanel>
  </ScrollViewer>
</UserControl>
