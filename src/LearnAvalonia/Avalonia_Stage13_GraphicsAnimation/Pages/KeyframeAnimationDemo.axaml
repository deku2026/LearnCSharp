<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="LearnAvalonia.Avalonia_Stage13_GraphicsAnimation.Pages.KeyframeAnimationDemo">
  <UserControl.Styles>
    <Style Selector="Border.pulse">
      <Style.Animations>
        <Animation Duration="0:0:1" IterationCount="Infinite" PlaybackDirection="Alternate">
          <KeyFrame Cue="0%">
            <Setter Property="Opacity" Value="0.4"/>
          </KeyFrame>
          <KeyFrame Cue="100%">
            <Setter Property="Opacity" Value="1.0"/>
          </KeyFrame>
        </Animation>
      </Style.Animations>
    </Style>
  </UserControl.Styles>
  <ScrollViewer Padding="8">
    <StackPanel Spacing="6" Margin="8">
      <TextBlock Text="§2.9 动画：Keyframe" FontWeight="Bold" FontSize="14"/>
      <TextBlock Text="样式动画示例（下方方块脉冲）：" FontWeight="SemiBold"/>
      <Border Classes="pulse" Width="50" Height="50" Background="DodgerBlue" CornerRadius="8" HorizontalAlignment="Left"/>
      <Border Background="#1E1E1E" Padding="8" CornerRadius="4">
        <TextBlock Text="&lt;Style Selector=&quot;Border.pulse&quot;&gt;&#10;  &lt;Style.Animations&gt;&#10;    &lt;Animation Duration=&quot;0:0:1&quot; IterationCount=&quot;Infinite&quot;&#10;               PlaybackDirection=&quot;Alternate&quot;&gt;&#10;      &lt;KeyFrame Cue=&quot;0%&quot;&gt;&#10;        &lt;Setter Property=&quot;Opacity&quot; Value=&quot;0.4&quot;/&gt;&#10;      &lt;/KeyFrame&gt;&#10;      &lt;KeyFrame Cue=&quot;100%&quot;&gt;&#10;        &lt;Setter Property=&quot;Opacity&quot; Value=&quot;1.0&quot;/&gt;&#10;      &lt;/KeyFrame&gt;&#10;    &lt;/Animation&gt;&#10;  &lt;/Style.Animations&gt;&#10;&lt;/Style&gt;" Foreground="#D4D4D4" FontFamily="Consolas,Monaco,monospace" TextWrapping="Wrap"/>
      </Border>
      <TextBlock Text="可动画属性：多为 StyledProperty；DirectProperty（如 WindowState）不适合样式动画。" TextWrapping="Wrap"/>
      <TextBlock Text="验收：Style.Animations + KeyFrame Cue" Foreground="DarkGreen"/>
    </StackPanel>
  </ScrollViewer>
</UserControl>
