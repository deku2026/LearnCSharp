<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="LearnAvalonia.Avalonia_Stage13_GraphicsAnimation.Pages.HarfBuzzShapingDemo">
  <ScrollViewer Padding="8">
    <StackPanel Spacing="6" Margin="8">
      <TextBlock Text="§2.14 HarfBuzz 文本 shaping" FontWeight="Bold" FontSize="14"/>
      <TextBlock Text="复杂文种（阿拉伯、印地、部分表情序列等）需要正确 shaping。" TextWrapping="Wrap"/>
      <Border Background="#1E1E1E" Padding="8" CornerRadius="4">
        <TextBlock Text="// 应用构建时（自定义渲染配置场景）&#10;AppBuilder.Configure&lt;App&gt;()&#10;    .UsePlatformDetect()&#10;    .UseSkia()&#10;    // .UseHarfBuzz() 或文本 shaping 相关选项&#10;    .LogToTrace();" Foreground="#D4D4D4" FontFamily="Consolas,Monaco,monospace" TextWrapping="Wrap"/>
      </Border>
      <Border BorderBrush="Gray" BorderThickness="1" Padding="8" CornerRadius="4">
        <Grid ColumnDefinitions="1.2*,2*" RowDefinitions="Auto,Auto,Auto,Auto">
          <TextBlock Grid.Row="0" Grid.Column="0" Text="点" FontWeight="SemiBold"/>
          <TextBlock Grid.Row="0" Grid.Column="1" Text="说明" FontWeight="SemiBold"/>
          <TextBlock Grid.Row="1" Grid.Column="0" Text="默认路径" TextWrapping="Wrap"/>
          <TextBlock Grid.Row="1" Grid.Column="1" Text="模板通常已能覆盖常见需求" TextWrapping="Wrap"/>
          <TextBlock Grid.Row="2" Grid.Column="0" Text="自绘文本" TextWrapping="Wrap"/>
          <TextBlock Grid.Row="2" Grid.Column="1" Text="FormattedText/字形 API 注意基线与 BiDi" TextWrapping="Wrap"/>
          <TextBlock Grid.Row="3" Grid.Column="0" Text="性能" TextWrapping="Wrap"/>
          <TextBlock Grid.Row="3" Grid.Column="1" Text="shaping 有成本；静态标签可缓存" TextWrapping="Wrap"/>
        </Grid>
      </Border>
      <TextBlock Text="验收：目标语言样例字符串在 TextBlock/TextBox 中不断字、不乱序、选择高亮合理。" TextWrapping="Wrap"/>
      <TextBlock Text="验收：复杂文种 shaping 验证" Foreground="DarkGreen"/>
    </StackPanel>
  </ScrollViewer>
</UserControl>
