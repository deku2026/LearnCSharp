<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="LearnAvalonia.Avalonia_Stage13_GraphicsAnimation.Pages.Avalonia12ChangesDemo">
  <ScrollViewer Padding="8">
    <StackPanel Spacing="6" Margin="8">
      <TextBlock Text="§4 Avalonia 12 / 12.1 变化" FontWeight="Bold" FontSize="14"/>
      <Border BorderBrush="Gray" BorderThickness="1" Padding="8" CornerRadius="4">
        <Grid ColumnDefinitions="1.6*,2*" RowDefinitions="Auto,Auto,Auto,Auto,Auto">
          <TextBlock Grid.Row="0" Grid.Column="0" Text="变化" FontWeight="SemiBold"/>
          <TextBlock Grid.Row="0" Grid.Column="1" Text="说明" FontWeight="SemiBold"/>
          <TextBlock Grid.Row="1" Grid.Column="0" Text="PlaybackBehavior/不可见停动画" TextWrapping="Wrap"/>
          <TextBlock Grid.Row="1" Grid.Column="1" Text="样式动画节能与正确性" TextWrapping="Wrap"/>
          <TextBlock Grid.Row="2" Grid.Column="0" Text="文本 shaping 可配置" TextWrapping="Wrap"/>
          <TextBlock Grid.Row="2" Grid.Column="1" Text="HarfBuzz 相关" TextWrapping="Wrap"/>
          <TextBlock Grid.Row="3" Grid.Column="0" Text="渲染栈优化" TextWrapping="Wrap"/>
          <TextBlock Grid.Row="3" Grid.Column="1" Text="12.1 继续性能与平台修复" TextWrapping="Wrap"/>
          <TextBlock Grid.Row="4" Grid.Column="0" Text="Impeller 等 GPU 实验" TextWrapping="Wrap"/>
          <TextBlock Grid.Row="4" Grid.Column="1" Text="🔴 跟踪，不进生产验收" TextWrapping="Wrap"/>
        </Grid>
      </Border>
      <TextBlock Text="主题与装饰：与图形资源、亚克力等联动。" TextWrapping="Wrap"/>
      <TextBlock Text="验收：PlaybackBehavior/shaping 可配置" Foreground="DarkGreen"/>
    </StackPanel>
  </ScrollViewer>
</UserControl>
