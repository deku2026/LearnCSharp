<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="LearnAvalonia.Avalonia_Stage11_PagesNavigation.Pages.PageTypesDemo">
  <ScrollViewer Padding="8">
    <StackPanel Spacing="6" Margin="8">
      <TextBlock Text="§2.1 页面类型一览" FontWeight="Bold" FontSize="14"/>
      <Border BorderBrush="Gray" BorderThickness="1" Padding="8" CornerRadius="4">
        <Grid ColumnDefinitions="1.2*,1.6*,1.4*" RowDefinitions="Auto,Auto,Auto,Auto,Auto,Auto,Auto,Auto">
          <TextBlock Grid.Row="0" Grid.Column="0" Text="类型" FontWeight="SemiBold"/>
          <TextBlock Grid.Row="0" Grid.Column="1" Text="职责" FontWeight="SemiBold"/>
          <TextBlock Grid.Row="0" Grid.Column="2" Text="典型用法" FontWeight="SemiBold"/>
          <TextBlock Grid.Row="1" Grid.Column="0" Text="Page" TextWrapping="Wrap"/>
          <TextBlock Grid.Row="1" Grid.Column="1" Text="页面抽象基类" TextWrapping="Wrap"/>
          <TextBlock Grid.Row="1" Grid.Column="2" Text="自定义页根" TextWrapping="Wrap"/>
          <TextBlock Grid.Row="2" Grid.Column="0" Text="ContentPage" TextWrapping="Wrap"/>
          <TextBlock Grid.Row="2" Grid.Column="1" Text="单页内容 + Header 等" TextWrapping="Wrap"/>
          <TextBlock Grid.Row="2" Grid.Column="2" Text="绝大多数业务页" TextWrapping="Wrap"/>
          <TextBlock Grid.Row="3" Grid.Column="0" Text="NavigationPage" TextWrapping="Wrap"/>
          <TextBlock Grid.Row="3" Grid.Column="1" Text="栈导航容器，实现 INavigation" TextWrapping="Wrap"/>
          <TextBlock Grid.Row="3" Grid.Column="2" Text="根或 Tab 内栈" TextWrapping="Wrap"/>
          <TextBlock Grid.Row="4" Grid.Column="0" Text="TabbedPage" TextWrapping="Wrap"/>
          <TextBlock Grid.Row="4" Grid.Column="1" Text="多 Tab 子页" TextWrapping="Wrap"/>
          <TextBlock Grid.Row="4" Grid.Column="2" Text="底栏/顶栏分区" TextWrapping="Wrap"/>
          <TextBlock Grid.Row="5" Grid.Column="0" Text="DrawerPage" TextWrapping="Wrap"/>
          <TextBlock Grid.Row="5" Grid.Column="1" Text="抽屉 + 主内容（SplitView 增强）" TextWrapping="Wrap"/>
          <TextBlock Grid.Row="5" Grid.Column="2" Text="汉堡菜单" TextWrapping="Wrap"/>
          <TextBlock Grid.Row="6" Grid.Column="0" Text="CarouselPage" TextWrapping="Wrap"/>
          <TextBlock Grid.Row="6" Grid.Column="1" Text="水平滑动多页" TextWrapping="Wrap"/>
          <TextBlock Grid.Row="6" Grid.Column="2" Text="引导/向导；配 PipsPager" TextWrapping="Wrap"/>
          <TextBlock Grid.Row="7" Grid.Column="0" Text="MultiPage" TextWrapping="Wrap"/>
          <TextBlock Grid.Row="7" Grid.Column="1" Text="多子页抽象" TextWrapping="Wrap"/>
          <TextBlock Grid.Row="7" Grid.Column="2" Text="Tabbed/Carousel 基础" TextWrapping="Wrap"/>
        </Grid>
      </Border>
      <TextBlock Text="验收：默写 Pages 类型职责表" Foreground="DarkGreen"/>
    </StackPanel>
  </ScrollViewer>
</UserControl>
