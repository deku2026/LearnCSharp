<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="LearnAvalonia.Avalonia_Stage11_PagesNavigation.Pages.Avalonia12ChangesDemo">
  <ScrollViewer Padding="8">
    <StackPanel Spacing="6" Margin="8">
      <TextBlock Text="§4 Avalonia 12 / 12.1 变化" FontWeight="Bold" FontSize="14"/>
      <Border BorderBrush="Gray" BorderThickness="1" Padding="8" CornerRadius="4">
        <Grid ColumnDefinitions="1.4*,2*" RowDefinitions="Auto,Auto,Auto,Auto,Auto,Auto">
          <TextBlock Grid.Row="0" Grid.Column="0" Text="变化" FontWeight="SemiBold"/>
          <TextBlock Grid.Row="0" Grid.Column="1" Text="说明" FontWeight="SemiBold"/>
          <TextBlock Grid.Row="1" Grid.Column="0" Text="Pages 全家入盒" TextWrapping="Wrap"/>
          <TextBlock Grid.Row="1" Grid.Column="1" Text="Content/Navigation/Tabbed/Drawer/Carousel/MultiPage" TextWrapping="Wrap"/>
          <TextBlock Grid.Row="2" Grid.Column="0" Text="INavigation 异步 API" TextWrapping="Wrap"/>
          <TextBlock Grid.Row="2" Grid.Column="1" Text="Push/Pop/Modal 等" TextWrapping="Wrap"/>
          <TextBlock Grid.Row="3" Grid.Column="0" Text="CommandBar / PipsPager" TextWrapping="Wrap"/>
          <TextBlock Grid.Row="3" Grid.Column="1" Text="页级命令与指示器" TextWrapping="Wrap"/>
          <TextBlock Grid.Row="4" Grid.Column="0" Text="过渡与手势" TextWrapping="Wrap"/>
          <TextBlock Grid.Row="4" Grid.Column="1" Text="触控优先；与主题装饰集成" TextWrapping="Wrap"/>
          <TextBlock Grid.Row="5" Grid.Column="0" Text="焦点跨页" TextWrapping="Wrap"/>
          <TextBlock Grid.Row="5" Grid.Column="1" Text="12 强调过渡中焦点处理" TextWrapping="Wrap"/>
        </Grid>
      </Border>
      <TextBlock Text="12.1：跟随控件/布局修复；API 以 12.1.0 为准再核验过载。" TextWrapping="Wrap"/>
      <TextBlock Text="验收：Pages 全家入盒与异步 INavigation" Foreground="DarkGreen"/>
    </StackPanel>
  </ScrollViewer>
</UserControl>
