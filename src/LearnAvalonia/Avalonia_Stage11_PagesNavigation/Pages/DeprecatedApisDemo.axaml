<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="LearnAvalonia.Avalonia_Stage11_PagesNavigation.Pages.DeprecatedApisDemo">
  <ScrollViewer Padding="8">
    <StackPanel Spacing="6" Margin="8">
      <TextBlock Text="§5 过时与禁止" FontWeight="Bold" FontSize="14"/>
      <Border BorderBrush="Gray" BorderThickness="1" Padding="8" CornerRadius="4">
        <Grid ColumnDefinitions="1.4*,2*" RowDefinitions="Auto,Auto,Auto,Auto,Auto,Auto,Auto,Auto">
          <TextBlock Grid.Row="0" Grid.Column="0" Text="禁止" FontWeight="SemiBold"/>
          <TextBlock Grid.Row="0" Grid.Column="1" Text="替代" FontWeight="SemiBold"/>
          <TextBlock Grid.Row="1" Grid.Column="0" Text="自建简陋 Frame 无生命周期" TextWrapping="Wrap"/>
          <TextBlock Grid.Row="1" Grid.Column="1" Text="官方 NavigationPage 或明确自研边界" TextWrapping="Wrap"/>
          <TextBlock Grid.Row="2" Grid.Column="0" Text="默认反射 ViewLocator 当生产路由" TextWrapping="Wrap"/>
          <TextBlock Grid.Row="2" Grid.Column="1" Text="显式 IViewFactory / 源生成" TextWrapping="Wrap"/>
          <TextBlock Grid.Row="3" Grid.Column="0" Text="业务 VM new DetailPage()" TextWrapping="Wrap"/>
          <TextBlock Grid.Row="3" Grid.Column="1" Text="只 new VM，由工厂创建 View" TextWrapping="Wrap"/>
          <TextBlock Grid.Row="4" Grid.Column="0" Text="同步阻塞导航" TextWrapping="Wrap"/>
          <TextBlock Grid.Row="4" Grid.Column="1" Text="await PushAsync" TextWrapping="Wrap"/>
          <TextBlock Grid.Row="5" Grid.Column="0" Text="把 BottomSheet 当核心控件名" TextWrapping="Wrap"/>
          <TextBlock Grid.Row="5" Grid.Column="1" Text="查官方清单；用 Dialog/Modal/自定义" TextWrapping="Wrap"/>
          <TextBlock Grid.Row="6" Grid.Column="0" Text="Prism.Avalonia 未评估 pre 进默认模板" TextWrapping="Wrap"/>
          <TextBlock Grid.Row="6" Grid.Column="1" Text="团队选型后再用" TextWrapping="Wrap"/>
          <TextBlock Grid.Row="7" Grid.Column="0" Text="全平台强制同一视觉壳" TextWrapping="Wrap"/>
          <TextBlock Grid.Row="7" Grid.Column="1" Text="共享接口 + per-platform shell" TextWrapping="Wrap"/>
        </Grid>
      </Border>
      <TextBlock Text="Modal 泄漏（只 Push 不 Pop）→ 生命周期与返回键统一。" TextWrapping="Wrap" Foreground="OrangeRed"/>
      <TextBlock Text="验收：禁默认反射 ViewLocator 与同步阻塞" Foreground="DarkGreen"/>
    </StackPanel>
  </ScrollViewer>
</UserControl>
