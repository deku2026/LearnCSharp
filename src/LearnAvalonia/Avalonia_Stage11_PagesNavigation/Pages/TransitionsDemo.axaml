<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="LearnAvalonia.Avalonia_Stage11_PagesNavigation.Pages.TransitionsDemo">
  <ScrollViewer Padding="8">
    <StackPanel Spacing="6" Margin="8">
      <TextBlock Text="§2.9 Transitions" FontWeight="Bold" FontSize="14"/>
      <Border Background="#1E1E1E" Padding="8" CornerRadius="4">
        <TextBlock Text="// 全局或实例级&#10;nav.PageTransition = new PageSlide(/* orientation, duration */);&#10;// 或 CrossFade 等内置过渡&#10;&#10;// per-call 覆盖（若 API 提供带 transition 参数的过载）&#10;await nav.PushAsync(page /*, customTransition */);" Foreground="#D4D4D4" FontFamily="Consolas,Monaco,monospace" TextWrapping="Wrap"/>
      </Border>
      <TextBlock Text="验收：过渡中焦点不丢失到不可见页；系统返回手势与动画可取消策略符合平台习惯。" TextWrapping="Wrap"/>
      <TextBlock Text="验收：PageSlide/CrossFade 与焦点保持" Foreground="DarkGreen"/>
    </StackPanel>
  </ScrollViewer>
</UserControl>
