<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="LearnAvalonia.Avalonia_Stage14_CustomControls.Pages.Avalonia12ChangesDemo">
  <ScrollViewer Padding="8">
    <StackPanel Spacing="6" Margin="8">
      <TextBlock Text="§5 Avalonia 12 / 12.1 变化" FontWeight="Bold" FontSize="14"/>
      <Border BorderBrush="Gray" BorderThickness="1" Padding="8" CornerRadius="4">
        <Grid ColumnDefinitions="1.6*,2*" RowDefinitions="Auto,Auto,Auto,Auto,Auto">
          <TextBlock Grid.Row="0" Grid.Column="0" Text="变化" FontWeight="SemiBold"/>
          <TextBlock Grid.Row="0" Grid.Column="1" Text="对自定义控件的影响" FontWeight="SemiBold"/>
          <TextBlock Grid.Row="1" Grid.Column="0" Text="ControlTheme 主线" TextWrapping="Wrap"/>
          <TextBlock Grid.Row="1" Grid.Column="1" Text="默认主题用 ControlTheme 而非旧 Style 伪装" TextWrapping="Wrap"/>
          <TextBlock Grid.Row="2" Grid.Column="0" Text="伪类与焦点" TextWrapping="Wrap"/>
          <TextBlock Grid.Row="2" Grid.Column="1" Text=":focus-visible 等与键盘导航" TextWrapping="Wrap"/>
          <TextBlock Grid.Row="3" Grid.Column="0" Text="属性系统" TextWrapping="Wrap"/>
          <TextBlock Grid.Row="3" Grid.Column="1" Text="继续区分 Styled/Direct；动画只走 Styled" TextWrapping="Wrap"/>
          <TextBlock Grid.Row="4" Grid.Column="0" Text="无障碍加强" TextWrapping="Wrap"/>
          <TextBlock Grid.Row="4" Grid.Column="1" Text="认真实现 Peer" TextWrapping="Wrap"/>
        </Grid>
      </Border>
      <TextBlock Text="模板与 NameScope：与阶段 5 一致，Popup 等边界小心。" TextWrapping="Wrap"/>
      <TextBlock Text="验收：ControlTheme/伪类/AOT 改进" Foreground="DarkGreen"/>
    </StackPanel>
  </ScrollViewer>
</UserControl>