<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="LearnAvalonia.Avalonia_Stage14_CustomControls.Pages.AotFriendlyDemo">
  <ScrollViewer Padding="8">
    <StackPanel Spacing="6" Margin="8">
      <TextBlock Text="§2.14 AOT 友好" FontWeight="Bold" FontSize="14"/>
      <Border BorderBrush="Gray" BorderThickness="1" Padding="8" CornerRadius="4">
        <Grid ColumnDefinitions="1.8*,2*" RowDefinitions="Auto,Auto,Auto,Auto,Auto">
          <TextBlock Grid.Row="0" Grid.Column="0" Text="做法" FontWeight="SemiBold"/>
          <TextBlock Grid.Row="0" Grid.Column="1" Text="原因" FontWeight="SemiBold"/>
          <TextBlock Grid.Row="1" Grid.Column="0" Text="避免运行时反射找模板/属性" TextWrapping="Wrap"/>
          <TextBlock Grid.Row="1" Grid.Column="1" Text="trim 掉" TextWrapping="Wrap"/>
          <TextBlock Grid.Row="2" Grid.Column="0" Text="显式 axaml 编译资源" TextWrapping="Wrap"/>
          <TextBlock Grid.Row="2" Grid.Column="1" Text="静态可见" TextWrapping="Wrap"/>
          <TextBlock Grid.Row="3" Grid.Column="0" Text="不用默认反射 ViewLocator 当控件发现" TextWrapping="Wrap"/>
          <TextBlock Grid.Row="3" Grid.Column="1" Text="同阶段 11" TextWrapping="Wrap"/>
          <TextBlock Grid.Row="4" Grid.Column="0" Text="序列化/转换器源生成" TextWrapping="Wrap"/>
          <TextBlock Grid.Row="4" Grid.Column="1" Text="减少动态" TextWrapping="Wrap"/>
        </Grid>
      </Border>
      <TextBlock Text="测试 PublishAot 样例应用 — 实证。" TextWrapping="Wrap"/>
      <TextBlock Text="控件库随应用 trim 测试；确保模板资源在 AOT 下可加载。" TextWrapping="Wrap"/>
      <TextBlock Text="验收：避免反射；显式 axaml 编译" Foreground="DarkGreen"/>
    </StackPanel>
  </ScrollViewer>
</UserControl>
