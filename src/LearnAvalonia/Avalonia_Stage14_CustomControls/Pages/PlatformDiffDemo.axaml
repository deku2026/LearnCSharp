<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="LearnAvalonia.Avalonia_Stage14_CustomControls.Pages.PlatformDiffDemo">
  <ScrollViewer Padding="8">
    <StackPanel Spacing="6" Margin="8">
      <TextBlock Text="§4 跨平台差异" FontWeight="Bold" FontSize="14"/>
      <Border BorderBrush="Gray" BorderThickness="1" Padding="8" CornerRadius="4">
        <Grid ColumnDefinitions="1.4*,2*" RowDefinitions="Auto,Auto,Auto,Auto,Auto">
          <TextBlock Grid.Row="0" Grid.Column="0" Text="主题" FontWeight="SemiBold"/>
          <TextBlock Grid.Row="0" Grid.Column="1" Text="说明" FontWeight="SemiBold"/>
          <TextBlock Grid.Row="1" Grid.Column="0" Text="触控命中" TextWrapping="Wrap"/>
          <TextBlock Grid.Row="1" Grid.Column="1" Text="星星热区加大；最小 44dp 思维" TextWrapping="Wrap"/>
          <TextBlock Grid.Row="2" Grid.Column="0" Text="键盘" TextWrapping="Wrap"/>
          <TextBlock Grid.Row="2" Grid.Column="1" Text="桌面必须；移动可辅以大按钮" TextWrapping="Wrap"/>
          <TextBlock Grid.Row="3" Grid.Column="0" Text="主题" TextWrapping="Wrap"/>
          <TextBlock Grid.Row="3" Grid.Column="1" Text="Fluent/Simple/自定义；移动 safe area 不由控件包办" TextWrapping="Wrap"/>
          <TextBlock Grid.Row="4" Grid.Column="0" Text="AOT 移动" TextWrapping="Wrap"/>
          <TextBlock Grid.Row="4" Grid.Column="1" Text="控件库随应用 trim 测试" TextWrapping="Wrap"/>
        </Grid>
      </Border>
      <TextBlock Text="字体/DPI：自绘控件用逻辑像素。" TextWrapping="Wrap"/>
      <TextBlock Text="验收：模板/无障碍/AOT 各平台抽检" Foreground="DarkGreen"/>
    </StackPanel>
  </ScrollViewer>
</UserControl>
