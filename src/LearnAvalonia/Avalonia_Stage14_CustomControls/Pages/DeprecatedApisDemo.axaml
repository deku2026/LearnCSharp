<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="LearnAvalonia.Avalonia_Stage14_CustomControls.Pages.DeprecatedApisDemo">
  <ScrollViewer Padding="8">
    <StackPanel Spacing="6" Margin="8">
      <TextBlock Text="§6 过时与禁止" FontWeight="Bold" FontSize="14"/>
      <Border BorderBrush="Gray" BorderThickness="1" Padding="8" CornerRadius="4">
        <Grid ColumnDefinitions="1.8*,1.4*" RowDefinitions="Auto,Auto,Auto,Auto,Auto,Auto,Auto">
          <TextBlock Grid.Row="0" Grid.Column="0" Text="禁止" FontWeight="SemiBold"/>
          <TextBlock Grid.Row="0" Grid.Column="1" Text="替代" FontWeight="SemiBold"/>
          <TextBlock Grid.Row="1" Grid.Column="0" Text="WPF 式 OverrideMetadata 照搬" TextWrapping="Wrap"/>
          <TextBlock Grid.Row="1" Grid.Column="1" Text="Avalonia 注册与 metadata API" TextWrapping="Wrap"/>
          <TextBlock Grid.Row="2" Grid.Column="0" Text="模板内 {Binding} 误当控件属性" TextWrapping="Wrap"/>
          <TextBlock Grid.Row="2" Grid.Column="1" Text="TemplateBinding" TextWrapping="Wrap"/>
          <TextBlock Grid.Row="3" Grid.Column="0" Text="OnApplyTemplate 不卸事件" TextWrapping="Wrap"/>
          <TextBlock Grid.Row="3" Grid.Column="1" Text="先解绑再绑" TextWrapping="Wrap"/>
          <TextBlock Grid.Row="4" Grid.Column="0" Text="业务 UserControl 硬编码颜色" TextWrapping="Wrap"/>
          <TextBlock Grid.Row="4" Grid.Column="1" Text="主题资源" TextWrapping="Wrap"/>
          <TextBlock Grid.Row="5" Grid.Column="0" Text="反射扫描程序集注册控件" TextWrapping="Wrap"/>
          <TextBlock Grid.Row="5" Grid.Column="1" Text="显式 StyleInclude / 源生成" TextWrapping="Wrap"/>
          <TextBlock Grid.Row="6" Grid.Column="0" Text="无视 AutomationPeer" TextWrapping="Wrap"/>
          <TextBlock Grid.Row="6" Grid.Column="1" Text="最低名称+键盘" TextWrapping="Wrap"/>
        </Grid>
      </Border>
      <TextBlock Text="在 Measure 里改依赖属性引发死循环 → 规范失效路径。" TextWrapping="Wrap" Foreground="OrangeRed"/>
      <TextBlock Text="验收：禁默认反射 ViewLocator/旧 Trigger" Foreground="DarkGreen"/>
    </StackPanel>
  </ScrollViewer>
</UserControl>
