<?xml version="1.0" encoding="utf-8" ?>
<ContentView xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:local="clr-namespace:LearnMaui.Maui_Stage04_XamlMarkup"
             x:Class="LearnMaui.Maui_Stage04_XamlMarkup.XamlDemoView"
             x:DataType="local:ProfileViewModel">
    <ContentView.Resources>
        <Color x:Key="AccentColor">#0369A1</Color>
        <Style x:Key="CaptionStyle" TargetType="Label">
            <Setter Property="FontSize" Value="12" />
            <Setter Property="TextColor"
                    Value="{AppThemeBinding Light=#475569, Dark=#CBD5E1}" />
        </Style>
    </ContentView.Resources>

    <Grid Padding="{OnPlatform Android='16,12', Default='12'}"
          RowDefinitions="Auto,Auto,*"
          RowSpacing="8">
        <Label Text="{Binding DisplayName}"
               FontSize="{OnIdiom Phone=22, Tablet=28, Desktop=30}"
               TextColor="{DynamicResource AccentColor}" />
        <Label Grid.Row="1"
               Text="{local:Upper Text='compiled xaml'}"
               Style="{StaticResource CaptionStyle}" />
        <CollectionView Grid.Row="2"
                        ItemsSource="{Binding Skills}"
                        SelectionMode="None">
            <CollectionView.ItemTemplate>
                <DataTemplate x:DataType="local:ProfileItem">
                    <Grid Padding="4" ColumnDefinitions="*,Auto">
                        <Label Text="{Binding Name}" />
                        <Label Grid.Column="1" Text="{Binding Status}" />
                    </Grid>
                </DataTemplate>
            </CollectionView.ItemTemplate>
        </CollectionView>
    </Grid>
</ContentView>
