<?xml version="1.0" encoding="utf-8" ?>
<ContentView xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="LearnMaui.Maui_Stage17_TestingSystem.TestingDemoView">
    <VerticalStackLayout Padding="16" Spacing="10">
        <Entry AutomationId="Stage17Query"
               Placeholder="Query"
               SemanticProperties.Description="Test query" />
        <Button AutomationId="Stage17Load"
                Text="Load"
                SemanticProperties.Description="Loads the test result" />
        <Label AutomationId="Stage17Result"
               Text="Result"
               SemanticProperties.HeadingLevel="Level2" />
    </VerticalStackLayout>
</ContentView>
